systemui_set() {
  # $1 = on|off. Redirects the compositor's Quick Settings entry between our
  # staged tree and the stock one. configd picks the change up live, but the
  # panel is a preloaded surface: it is killed so the next open builds from
  # the new path.
  if [ "$1" = on ]; then
    systemui_stage || return 1
    python3 "$SYSTEMUI_TOOL" on "$QS_APP" "$QS_MAIN" < /dev/null 2>>"$LOGFILE" || return 1
  else
    python3 "$SYSTEMUI_TOOL" off "$QS_APP" < /dev/null 2>>"$LOGFILE" || return 1
  fi
  # The panel belongs to the compositor's systemUIManager, not to SAM, so
  # applicationManager cannot close it. Closing drops the running panel,
  # resident or not, so the next open loads from the new path. The compositor
  # keeps compiled QML for its lifetime, so new content at the same path (a
  # restage) needs a compositor restart.
  luna-send -n 1 luna://com.webos.service.systemUIManager/closeByAppId \
    "{\"appId\":\"$QS_APP\"}" >/dev/null 2>&1
  return 0
}

verb_systemui() {
  case "${1:-status}" in
    on|off)
      take_mutation_lock || { emit_error "another mutation is in progress"; return 1; }
      if systemui_set "$1"; then
        [ "$1" = on ] && : > "$SYSTEMUI_ON" || rm -f "$SYSTEMUI_ON"
        log_line "systemui $1"
        printf '{"ok":true,"systemui":"%s","main":%s}\n' "$1" "$(python3 "$SYSTEMUI_TOOL" status < /dev/null 2>/dev/null || echo null)"
      else
        emit_error "could not switch Quick Settings to $1"
        return 1
      fi
      ;;
    status)
      printf '{"ok":true,"staged":%s,"main":%s}\n' \
        "$( [ -f "$QS_MAIN" ] && echo true || echo false )" \
        "$(python3 "$SYSTEMUI_TOOL" status < /dev/null 2>/dev/null || echo null)"
      ;;
    *) emit_error "usage: systemui on|off|status"; return 1 ;;
  esac
  return 0
}

staged_hash() {
  # Identity of the whole staged set: everything a bind or the shadow module
  # exposes to the compositor and to Home.
  { cat "$COMPOSITOR_STAGE" "$WALLPAPER_STAGE" "$ASSETS/home.xml" "$ASSETS/i18n/en.json" 2>/dev/null; tree_fp "$LUMA_STAGE"; } | md5sum | cut -c1-32
}

stock_module_fp() {
  # Identity of the stock module as installed: the recursive listing, which
  # carries every file's name, size and mtime. A firmware update rewrites the
  # tree and that shows up here, so there is no need to hash 2.8MB of content
  # on every boot.
  #
  # Not `find -printf`: this is busybox 1.35 find, which does not have it, and
  # the failure was silent - the pipeline hashed empty input, so every
  # fingerprint compared equal to every other and the staleness check could
  # never fire. Verified: `ls -lnR` is stable across calls (412 lines here)
  # and differs as soon as any file's size changes.
  ls -lnR "$STOCK_QML_MODULE" 2>/dev/null | md5sum | cut -c1-32
}

shadow_self_fp() {
  # Identity of the shadow tree. The listing carries every file's size, so a
  # truncated copy fails this even though the file is present.
  ls -lnR "$SHADOW_ROOT" 2>/dev/null | md5sum | cut -c1-32
}

shadow_patch_fp() {
  # Identity of what the shadow's patches were made from (SHADOW_PATCH_FILES, in that order) and of the switches that decide whether a
  # patch is made. A file that is not there counts as different from one that is.
  {
    for sp_f in $SHADOW_PATCH_FILES; do
      printf '%s\n' "$sp_f"
      cat "$sp_f" 2>/dev/null
    done
    if [ -f "${KEYBOARD_ON:-}" ]; then printf 'keyboard on\n'; else printf 'keyboard off\n'; fi
  } | md5sum | cut -c1-32
}

shadow_patch_current() {
  [ "$(cat "$SHADOW_PATCH_FP" 2>/dev/null)" = "$(shadow_patch_fp)" ]
}

build_shadow() {
  # Rebuild the shadow module from the stock one, swap our staged QML into it,
  # and record both what it was built from and what it now contains. Built
  # beside the live copy and renamed in, so a compositor starting mid-build
  # never sees a half-copied module.
  [ -d "$STOCK_QML_MODULE" ] || return 1
  [ -f "$COMPOSITOR_STAGE" ] || return 1
  [ -d "$LUMA_STAGE/$QML_MODULE" ] || return 1
  rm -rf "$SHADOW_ROOT.next" 2>/dev/null
  mkdir -p "$SHADOW_ROOT.next" 2>/dev/null || return 1
  cp -a "$STOCK_QML_MODULE" "$SHADOW_ROOT.next/" 2>/dev/null || { rm -rf "$SHADOW_ROOT.next"; return 1; }
  cp -f "$COMPOSITOR_STAGE" "$SHADOW_ROOT.next/WebOSCompositor/$MODULE_RELPATH" 2>/dev/null || { rm -rf "$SHADOW_ROOT.next"; return 1; }
  cp -R "$LUMA_STAGE/$QML_MODULE" "$SHADOW_ROOT.next/WebOSCompositor/$QML_MODULE" 2>/dev/null || { rm -rf "$SHADOW_ROOT.next"; return 1; }

  # The on-screen keyboard's window comes and goes in the theme's layer motion (tools/keyboard_patch.py). The tool writes nothing
  # when an anchor of LG's view is missing (a firmware update changed it): the shadow then keeps LG's file.
  kb="$SHADOW_ROOT.next/WebOSCompositor/views/StarfishKeyboardView.qml"
  if [ -f "${KEYBOARD_ON:-}" ] && [ -f "$kb" ] && [ -f "$KEYBOARD_TOOL" ]; then
    python3 "$KEYBOARD_TOOL" "$kb" "$THEME_SRC/theme.json" < /dev/null 2>>"$LOGFILE" || log_line "build_shadow: the keyboard patch was refused, LG's keyboard view stays"
  fi

  # LG's volume and mute popup never opens (tools/volume_patch.py). The tool writes nothing when an anchor of LG's view is missing (a
  # firmware update changed it): the shadow then keeps LG's file and the popup shows beside LumaTV's display until the patch is brought up to date.
  vv="$SHADOW_ROOT.next/WebOSCompositor/views/StarfishVolumeView.qml"
  if [ -f "$vv" ] && [ -f "$VOLUME_TOOL" ]; then
    python3 "$VOLUME_TOOL" "$vv" < /dev/null 2>>"$LOGFILE" || log_line "build_shadow: the volume patch was refused, LG's volume popup stays"
  fi

  # Get the contents on disk BEFORE the rename publishes them. /var is ext4
  # data=ordered, so without this a power cut can commit the directory entries
  # and lose the data, leaving a complete-looking module full of truncated
  # files that the compositor will happily start on and render nothing from.
  sync

  rm -rf "$SHADOW_ROOT.old" 2>/dev/null
  [ -d "$SHADOW_ROOT" ] && mv "$SHADOW_ROOT" "$SHADOW_ROOT.old"
  mv "$SHADOW_ROOT.next" "$SHADOW_ROOT" || { [ -d "$SHADOW_ROOT.old" ] && mv "$SHADOW_ROOT.old" "$SHADOW_ROOT"; return 1; }
  rm -rf "$SHADOW_ROOT.old" 2>/dev/null
  stock_module_fp > "$SHADOW_STOCK_FP"
  shadow_self_fp > "$SHADOW_SELF_FP"
  shadow_patch_fp > "$SHADOW_PATCH_FP"
  sync
  return 0
}

shadow_current() {
  # Usable means all three: it still holds exactly the staged QML, it is
  # byte-for-byte the tree we published, and it was built from the stock
  # module installed right now.
  [ -f "$SHADOW_QML" ] || return 1
  [ "$(md5sum < "$SHADOW_QML" 2>/dev/null)" = "$(md5sum < "$COMPOSITOR_STAGE" 2>/dev/null)" ] || return 1
  [ "$(tree_fp "$SHADOW_ROOT/WebOSCompositor/$QML_MODULE")" = "$(tree_fp "$LUMA_STAGE/$QML_MODULE")" ] || return 1
  [ "$(cat "$SHADOW_SELF_FP" 2>/dev/null)" = "$(shadow_self_fp)" ] || return 1
  shadow_patch_current || return 1
  [ "$(cat "$SHADOW_STOCK_FP" 2>/dev/null)" = "$(stock_module_fp)" ] || return 1
  return 0
}

env_extra_lines() {
  # Allowlisted KEY=VALUE lines of $ENV_EXTRA in file order; values limited to
  # characters systemd's EnvironmentFile takes literally. QML_FORCE_DISK_CACHE
  # is accepted but dropped: env_line always sets it, and Qt treats any value,
  # 0 included, as set.
  [ -f "$ENV_EXTRA" ] || return 0
  grep -E "^($ENV_EXTRA_KEYS)=[A-Za-z0-9_.:/,+-]+\$" "$ENV_EXTRA" 2>/dev/null \
    | grep -v '^QML_FORCE_DISK_CACHE='
  return 0
}

env_line() {
  printf 'QML2_IMPORT_PATH=%s:/usr/lib/qt5/qml\n' "$SHADOW_ROOT"
  printf 'QML_FORCE_DISK_CACHE=1\n'
  printf 'QT_QPA_UPDATE_IDLE_TIME=0\n'
  env_extra_lines
}

env_live() { [ "$(cat "$ENV_FILE" 2>/dev/null)" = "$(env_line)" ]; }

write_env() {
  mkdir -p "$ENV_DIR" 2>/dev/null || return 1
  env_live && return 0
  env_line > "$ENV_FILE.tmp.$$" && mv -f "$ENV_FILE.tmp.$$" "$ENV_FILE"
}

remove_env() { rm -f "$ENV_FILE" "$ENV_FILE.tmp."* 2>/dev/null; return 0; }

clear_qml_cache() { rm -rf "$QML_CACHE_DIR" 2>/dev/null; return 0; }

compositor_has_shadow() {
  # Whether the running compositor was started with our import path. Only its
  # own environment says so; the env file on disk says what the NEXT one gets.
  # LumaTV's compositor draws no QML: the process that carries LG's name is its supervisor, whose
  # environment says nothing, so a live LumaTV compositor counts as having what it needs.
  comp_live && return 0
  p=$(pgrep -x surface-manager 2>/dev/null | head -n1)
  [ -n "$p" ] || return 1
  tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -qF "QML2_IMPORT_PATH=$SHADOW_ROOT:"
}

all_binds_live() {
  is_mounted "$STOCK_ASSETS"
}

REPORTS_DIR=/tmp/var/log/reports/librdx

snapshot_reports() {
  # Paths of crash reports present now, one per line, so the ones a compositor
  # restart of ours creates can be told apart from anything already there.
  # Pathname expansion, never `ls`: see disarm_restart_crashes.
  for f in "$REPORTS_DIR"/*; do
    [ -e "$f" ] && printf '%s\n' "$f"
  done
}

disarm_restart_crashes() {
  # $1 = snapshot_reports output taken before the restart.
  #
  # A compositor restart makes LG's inputcommon segfault on teardown
  # (QFontDatabase::removeAllApplicationFonts; reproducible on stock firmware,
  # see the constants block). faultmanager scans this directory at power-off,
  # and any report there makes it answer the suspend request with
  # rebootToSuspend: the set then reboots instead of settling into active
  # standby, and the next power-on is a full boot rather than an instant one.
  # The reports are tmpfs and gone at the next boot anyway; removing only the
  # ones this restart produced gives the power path back without hiding
  # anything that was already there.
  #
  # The names cannot go through `ls`, and not only because they contain
  # spaces: rdxd writes the crashing binary's path into the name with 0x02 in
  # place of each '/', and busybox ls prints those bytes as '?'. A name read
  # back from ls therefore never matches the file, -e is false, rm is a no-op,
  # and the report stays. Pathname expansion hands back the raw bytes.
  before="$1"
  n=0
  for f in "$REPORTS_DIR"/*; do
    [ -e "$f" ] || continue
    printf '%s\n' "$before" | grep -qxF -- "$f" && continue
    rm -f "$f" 2>/dev/null && n=$((n+1))
  done
  [ "$n" -gt 0 ] && log_line "disarmed $n crash report(s) produced by our compositor restart"
  return 0
}

# ----------------------------------------------------------------- Home stub
#
# LG's Home is a Flutter app that stays resident under LumaHome (36-72 MB) and is
# what memchute closes when a big app launches, so each return to Home pays for
# LG's Home starting again and the compositor paging itself back in. The stub is
# a web app with the same id and category that draws nothing, bound over LG's
# app directory, so LumaHome is the only Home.
#
# SAM reads an appinfo.json only when it scans. blockSystemApp then
# releaseBlockSystemApp makes it drop and read that one app again within 0.5 s,
# with no SAM restart (which on webOS 10 has cost the picture, ARC sound and CEC
# until a power cut); the release must follow, since an app left blocked cannot
# launch. The block list file ends byte-identical. SAM keeps the old instance
# when the type changes under it and can then neither close nor replace it, so
# the directory and SAM change first and the old instance is stopped after: the
# Flutter process killed, or the stub's page killed through WebAppMgr
# (closeByAppId only sends it to the background).
#
# The Home assets bind stays where it is, under the stub, so LG's Home finds its
# decluttered assets when the stub goes.
#
# Every way out ends on LG's Home, never a black screen. revert and off remove
# the stub. The guard (homestub-watch) gives LG's Home back when LumaHome's
# heartbeat stops or an unconfirmed trial runs out, and when Home is held for
# 650 ms anywhere; LumaHome and the Home key write a request file for it, since
# the compositor is not allowed to run commands.

sam_home_type() {
  luna-send -n 1 luna://com.webos.applicationManager/getAppInfo "{\"id\":\"$HOME_APP_ID\"}" 2>/dev/null \
    | tr -d '\n' | sed -n 's/.*"type"[ ]*:[ ]*"\([^"]*\)".*/\1/p'
}

hs_mounted_any() {
  # Something is mounted on the app directory itself, not on the assets below it.
  grep -qF " $HOME_APP_DIR " /proc/self/mountinfo 2>/dev/null
}

hs_mounted_ours() {
  # Same device and inode as the staged copy.
  [ -d "$STUB_STAGE" ] || return 1
  hs_id=$(stat -c %d:%i "$HOME_APP_DIR" 2>/dev/null)
  [ -n "$hs_id" ] && [ "$hs_id" = "$(stat -c %d:%i "$STUB_STAGE" 2>/dev/null)" ]
}

hs_stub_in_front() { hs_mounted_ours && home_in_front; }

hs_open_home() { luna-send -n 1 "$HOME_LAUNCH_URI" "$HOME_LAUNCH_PARAMS" >/dev/null 2>&1; }

hs_stage() {
  # Copied in place, so a mounted stub follows an update. HS_STAGED says the
  # manifest changed, which SAM only learns of by reading the app again.
  HS_STAGED=0
  for hs_f in appinfo.json index.html icon.png; do
    [ -f "$STUB_SRC/$hs_f" ] || return 1
  done
  mkdir -p "$STUB_STAGE" 2>/dev/null || return 1
  for hs_f in appinfo.json index.html icon.png; do
    if ! cmp -s "$STUB_SRC/$hs_f" "$STUB_STAGE/$hs_f" 2>/dev/null; then
      cp -f "$STUB_SRC/$hs_f" "$STUB_STAGE/$hs_f" 2>/dev/null || return 1
      [ "$hs_f" = appinfo.json ] && HS_STAGED=1
    fi
  done
  return 0
}

hs_mode_set() {
  # $1 = stub | lg | legacy; $2 = optional trial=<seconds>. LumaHome reads it: lg
  # steps the layer aside so LG's Home shows, legacy is the layer over LG's Home as
  # before the stub. The second field is different on every write, so a new
  # decision is never taken for an old one.
  HS_MODE_N=$(( ${HS_MODE_N:-0} + 1 ))
  printf '%s %s.%s.%s%s\n' "$1" "$(uptime_s)" "$$" "$HS_MODE_N" "${2:+ $2}" > "$HS_MODE.tmp.$$" 2>/dev/null \
    && mv -f "$HS_MODE.tmp.$$" "$HS_MODE" 2>/dev/null
  return 0
}

hs_sam_reread() {
  luna-send -n 1 luna://com.webos.applicationManager/blockSystemApp "{\"id\":\"$HOME_APP_ID\"}" >/dev/null 2>&1
  hs_ri=0
  while [ "$hs_ri" -lt 5 ]; do
    hs_rr=$(luna-send -n 1 luna://com.webos.applicationManager/releaseBlockSystemApp "{\"id\":\"$HOME_APP_ID\"}" 2>/dev/null | tr -d '\n ')
    case "$hs_rr" in *'"returnValue":true'*) return 0 ;; esac
    hs_ri=$((hs_ri+1)); sleep 1
  done
  log_line "homestub: SAM would not release $HOME_APP_ID"
  return 1
}

hs_wait_type() {
  # $1 = the type SAM should report for Home (web | flutter); up to 5 s.
  hs_wi=0
  while [ "$hs_wi" -lt 10 ]; do
    [ "$(sam_home_type)" = "$1" ] && return 0
    sleep 0.5; hs_wi=$((hs_wi+1))
  done
  return 1
}

hs_unmount() {
  hs_ui=0
  while hs_mounted_ours && [ "$hs_ui" -lt 3 ]; do
    umount "$HOME_APP_DIR" >/dev/null 2>&1
    hs_ui=$((hs_ui+1))
    hs_mounted_ours && sleep 1
  done
  hs_mounted_ours && umount -l "$HOME_APP_DIR" >/dev/null 2>&1
  hs_mounted_ours && return 1
  return 0
}

hs_beat_seen() {
  # $1 = seconds to wait for LumaHome's beat to change.
  hs_b0=""; { read -r hs_b0 < "$HS_BEAT"; } 2>/dev/null
  hs_bi=0
  while [ "$hs_bi" -lt "$1" ]; do
    sleep 1
    hs_b1=""; { read -r hs_b1 < "$HS_BEAT"; } 2>/dev/null
    [ -n "$hs_b1" ] && [ "$hs_b1" != "$hs_b0" ] && return 0
    hs_bi=$((hs_bi+1))
  done
  return 1
}

hs_strikes() {
  hs_sn=$(cat "$HS_STRIKES" 2>/dev/null)
  case "$hs_sn" in ''|*[!0-9]*) hs_sn=0 ;; esac
  printf '%s' "$hs_sn"
}

hs_strike() {
  # One more fault in a row; at the limit the switch turns itself off.
  hs_sk=$(( $(hs_strikes) + 1 ))
  printf '%s\n' "$hs_sk" > "$HS_STRIKES" 2>/dev/null
  log_line "homestub: fault $hs_sk of $HS_MAX_STRIKES ($1)"
  if [ "$hs_sk" -ge "$HS_MAX_STRIKES" ]; then
    set_cfg_bool homestub false
    log_line "homestub: switched off after $hs_sk faults in a row"
  fi
}

hs_wanted() {
  # An unconfirmed trial counts: it brings the stub up for its 120 s.
  [ -f "$HS_SKIP" ] && return 1
  [ "$(hs_strikes)" -lt "$HS_MAX_STRIKES" ] || return 1
  [ -f "$HS_TRIAL" ] && return 0
  [ "$(cfg_get_bool homestub)" = true ]
}

hs_wd_alive() {
  [ -f "$HS_WD_PID" ] || return 1
  hs_wp=$(cat "$HS_WD_PID" 2>/dev/null)
  case "$hs_wp" in ''|*[!0-9]*) return 1 ;; esac
  [ -d "/proc/$hs_wp" ] && tr '\0' ' ' < "/proc/$hs_wp/cmdline" 2>/dev/null | grep -q 'homestub-watch'
}

hs_wd_stop() {
  if hs_wd_alive; then kill "$(cat "$HS_WD_PID")" 2>/dev/null; fi
  rm -f "$HS_WD_PID"
}

hs_wd_start() {
  hs_wd_alive && return 0
  # Closes the lock descriptors: a child holding them would keep every later
  # mutation waiting for as long as it lives.
  setsid "$APPDIR/tools/$SHORT_ID" homestub-watch 8>&- 9>&- </dev/null >/dev/null 2>&1 &
  return 0
}

hs_wd_restart() { hs_wd_stop; hs_wd_start; }

hs_guard_exit() {
  # A guard that was stopped for a restart must not take its successor's pidfile
  # with it.
  [ "$(cat "$HS_WD_PID" 2>/dev/null)" = "$$" ] && rm -f "$HS_WD_PID"
  exit 0
}

homestub_up() {
  # LG's Home directory shows the stub, SAM knows it, and LG's own instance, if
  # one started first, is stopped. 0 = in place; anything else left LG's Home.
  if hs_mounted_any && ! hs_mounted_ours; then
    log_line "homestub: something else is mounted on $HOME_APP_DIR, not stacking on it"
    return 2
  fi
  hs_was=0; hs_mounted_ours && hs_was=1
  hs_stage || { log_line "homestub: the stub's files are missing"; return 1; }
  if ! hs_mounted_ours; then
    # The assets bind goes first so that it sits under the stub, where LG's Home
    # looks once the stub is gone.
    if ! is_mounted "$STOCK_ASSETS" && [ -d "$ASSETS/i18n" ]; then
      mount --bind "$ASSETS" "$STOCK_ASSETS" >/dev/null 2>&1
    fi
    if ! mount --bind "$STUB_STAGE" "$HOME_APP_DIR" >/dev/null 2>&1 || ! hs_mounted_ours; then
      log_line "homestub: the bind on $HOME_APP_DIR failed"
      return 1
    fi
  fi
  hs_sam=$(sam_home_type)
  if [ "$hs_sam" != web ] || { [ "$hs_was" = 1 ] && [ "$HS_STAGED" = 1 ]; }; then
    if ! hs_sam_reread || ! hs_wait_type web; then
      log_line "homestub: SAM did not take the stub as Home"
      homestub_drop legacy
      return 1
    fi
    # The page that was already running has the old manifest; the next launch
    # reads the new one.
    if [ "$hs_sam" = web ]; then
      luna-send -n 1 luna://com.palm.webappmanager/killApp "{\"appId\":\"$HOME_APP_ID\"}" >/dev/null 2>&1
    fi
  fi
  kill_home_app
  hs_mode_set stub
  log_line "homestub: stub in place at uptime $(uptime_s) s"
  return 0
}

homestub_drop() {
  # LG's Home owns its directory again and SAM knows it. $1 = what LumaHome does
  # next: legacy (covers LG's Home, as before the stub) or lg (steps aside).
  # HS_DROPPED says whether a stub was mounted.
  hs_next="${1:-legacy}"
  [ "${HS_IN_GUARD:-0}" = 1 ] || hs_wd_stop
  rm -f "$HS_TRIAL" "$HS_ESCAPE" "$HS_CONFIRM"
  HS_DROPPED=0
  if hs_mounted_ours; then
    HS_DROPPED=1
    hs_unmount || log_line "homestub: the stub is only lazily unmounted"
  fi
  if [ "$(sam_home_type)" = web ]; then
    hs_sam_reread
    hs_wait_type flutter || log_line "homestub: SAM still reports a web Home"
  fi
  if ! is_mounted "$STOCK_ASSETS" && [ -d "$ASSETS/i18n" ]; then
    mount --bind "$ASSETS" "$STOCK_ASSETS" >/dev/null 2>&1
  fi
  # The stub's page goes last. Where it was in front, SAM opens Home again about
  # a second later, and now the app it opens is LG's.
  if [ "$HS_DROPPED" = 1 ]; then
    luna-send -n 1 luna://com.palm.webappmanager/killApp "{\"appId\":\"$HOME_APP_ID\"}" >/dev/null 2>&1
    log_line "homestub: LG's Home is back in its directory"
  fi
  hs_mode_set "$hs_next"
  return 0
}

homestub_escape() {
  # Home held: LG's own Home on screen, LumaHome out of its way, until the next
  # apply or reboot.
  take_mutation_lock || { log_line "homestub: escape could not take the lock"; return 1; }
  log_line "homestub: Home held, giving LG's Home back"
  : > "$HS_SKIP"
  homestub_drop lg
  hs_open_home
  return 0
}

homestub_fault() {
  # $1 = what went wrong. Home is opened again only where the stub was in front;
  # an app in front is left alone.
  take_mutation_lock || return 1
  log_line "homestub: $1, giving LG's Home back"
  hs_front=0; hs_stub_in_front && hs_front=1
  : > "$HS_SKIP"
  homestub_drop lg
  [ "$hs_front" = 1 ] && hs_open_home
  hs_strike "$1"
  ntfy_notify "$DISPLAY_NAME gave LG's Home back: $1"
  return 0
}

homestub_expire() {
  take_mutation_lock || return 1
  log_line "homestub: trial not confirmed, giving LG's Home back"
  hs_front=0; hs_stub_in_front && hs_front=1
  homestub_drop legacy
  [ "$hs_front" = 1 ] && hs_open_home
  ntfy_notify "$DISPLAY_NAME Home stub trial ended unconfirmed"
  return 0
}

homestub_confirm() {
  # Needs the stub in place and LumaHome beating: a stub nobody can see must not
  # become the setting.
  [ -f "$HS_TRIAL" ] || return 1
  hs_mounted_ours && [ "$(sam_home_type)" = web ] || return 2
  hs_beat_seen 3 || return 3
  set_cfg_bool homestub true
  rm -f "$HS_TRIAL" "$HS_STRIKES" "$HS_CONFIRM"
  hs_mode_set stub
  log_line "homestub: confirmed"
  return 0
}

homestub_sync() {
  # apply's step: the stub is brought in line with what is wanted, before the
  # compositor restarts so that the Home it relaunches is the stub. A hand-run
  # apply is the "next apply" of an escape; the boot worker's own is not.
  [ "${LUMA_BOOT:-0}" = 1 ] || rm -f "$HS_SKIP"
  if hs_wanted; then
    if homestub_up; then
      hs_wd_restart
    else
      log_line "homestub: not in place, LG's Home stays"
    fi
  else
    if hs_mounted_ours || [ "$(sam_home_type)" = web ]; then homestub_drop legacy; else hs_mode_set legacy; fi
  fi
  return 0
}

homestub_json() {
  hs_cfg=$(cfg_get_bool homestub); [ "$hs_cfg" = true ] || hs_cfg=false
  hs_mo=false; hs_mounted_ours && hs_mo=true
  hs_st=$(sam_home_type)
  hs_fl=false; pgrep -f "$HOME_PKILL_PATTERN" >/dev/null 2>&1 && hs_fl=true
  hs_left=0
  if [ -f "$HS_TRIAL" ]; then
    hs_dl=""; { read -r hs_tb hs_dl < "$HS_TRIAL"; } 2>/dev/null
    case "$hs_dl" in ''|*[!0-9]*) hs_left=$HS_TRIAL_SECS ;; *) hs_left=$((hs_dl - $(uptime_s))); [ "$hs_left" -gt 0 ] || hs_left=0 ;; esac
  fi
  if [ "$hs_mo" = true ] && [ "$hs_st" = web ]; then
    if [ -f "$HS_TRIAL" ]; then hs_state=trial; else hs_state=stub; fi
  elif [ "$hs_cfg" = true ] || [ -f "$HS_TRIAL" ]; then
    hs_state=lg
  else
    hs_state=off
  fi
  hs_gd=false; hs_wd_alive && hs_gd=true
  hs_bt=false
  if [ -f "$HS_BEAT" ]; then
    hs_age=$(( $(date +%s) - $(mtime_epoch "$HS_BEAT") ))
    [ "$hs_age" -le 3 ] && hs_bt=true
  fi
  printf '{"config":%s,"state":"%s","mounted":%s,"sam":"%s","flutter":%s,"trialLeft":%s,"guard":%s,"beat":%s,"faults":%s}' \
    "$hs_cfg" "$hs_state" "$hs_mo" "$hs_st" "$hs_fl" "$hs_left" "$hs_gd" "$hs_bt" "$(hs_strikes)"
}

verb_homestub() {
  case "${1:-status}" in
    on)
      [ -f "$STUB_SRC/appinfo.json" ] || { emit_error "the stub's files are missing from this install"; return 1; }
      if hs_mounted_any && ! hs_mounted_ours; then
        emit_error "something else is mounted on LG's Home directory (Glasshouse Home?)"; return 1
      fi
      rm -f "$HS_SKIP" "$HS_STRIKES" "$HS_ESCAPE" "$HS_CONFIRM"
      # A switch that was already confirmed needs no trial: it only comes back up.
      # Otherwise a trial with no deadline yet: apply brings the stub up for it, the
      # clock starts when it has.
      hs_kept=false; [ "$(cfg_get_bool homestub)" = true ] && hs_kept=true
      [ "$hs_kept" = true ] || printf 'pending\n' > "$HS_TRIAL"
      hs_out=$(verb_apply)
      case "$hs_out" in
        *'"ok":true'*) : ;;
        *) rm -f "$HS_TRIAL"; printf '%s\n' "$hs_out"; return 1 ;;
      esac
      if ! hs_mounted_ours || [ "$(sam_home_type)" != web ]; then
        rm -f "$HS_TRIAL"
        emit_error "the stub did not come up; LG's Home stays (see the log)"; return 1
      fi
      if ! hs_beat_seen 50; then
        take_mutation_lock >/dev/null 2>&1
        hs_front=0; hs_stub_in_front && hs_front=1
        homestub_drop legacy
        [ "$hs_front" = 1 ] && hs_open_home
        log_line "homestub: LumaHome never started its heartbeat, stub removed"
        emit_error "LumaHome did not start drawing; LG's Home is back"; return 1
      fi
      if [ "$hs_kept" = true ]; then
        log_line "homestub: on"
        printf '{"ok":true,"homestub":%s}\n' "$(homestub_json)"
        return 0
      fi
      printf 'trial %s\n' "$(( $(uptime_s) + HS_TRIAL_SECS ))" > "$HS_TRIAL"
      hs_mode_set stub "trial=$HS_TRIAL_SECS"
      log_line "homestub: on trial for $HS_TRIAL_SECS s"
      printf '{"ok":true,"homestub":%s}\n' "$(homestub_json)"
      ;;
    off)
      take_mutation_lock || { emit_error "another mutation is in progress"; return 1; }
      set_cfg_bool homestub false
      rm -f "$HS_SKIP" "$HS_STRIKES"
      hs_front=0; hs_stub_in_front && hs_front=1
      homestub_drop legacy
      [ "$hs_front" = 1 ] && hs_open_home
      log_line "homestub: off"
      printf '{"ok":true,"homestub":%s}\n' "$(homestub_json)"
      ;;
    confirm)
      if [ ! -f "$HS_TRIAL" ]; then
        if [ "$(cfg_get_bool homestub)" = true ] && hs_mounted_ours; then
          printf '{"ok":true,"homestub":%s}\n' "$(homestub_json)"; return 0
        fi
        emit_error "no trial is running"; return 1
      fi
      homestub_confirm
      case $? in
        0) printf '{"ok":true,"homestub":%s}\n' "$(homestub_json)" ;;
        2) emit_error "the stub is not in place"; return 1 ;;
        *) emit_error "LumaHome is not drawing (no heartbeat); not confirming"; return 1 ;;
      esac
      ;;
    status) printf '{"ok":true,"homestub":%s}\n' "$(homestub_json)" ;;
    *) emit_error "usage: homestub on|off|confirm|status"; return 1 ;;
  esac
  return 0
}

verb_homestub_boot() {
  # The boot worker's first act (tools/autostart.sh), before anything touches
  # Home: the stub goes over LG's Home as early as the early hook runs, because
  # bootd opens Home about 14 s into a power-on and the hook starts at 12-14 s.
  # The compositor is still stock then; the apply that follows restarts it.
  if [ "$(cfg_get_bool homestub)" != true ]; then
    printf '{"ok":true,"stub":false,"reason":"off"}\n'; return 0
  fi
  take_mutation_lock || { emit_error "another mutation is in progress"; return 1; }
  rm -f "$HS_SKIP"
  if [ -f "$BOOT_PENDING" ]; then
    # The previous boot never reached boot-ok. Whatever stopped it may have been
    # the stub, so this boot has LG's Home.
    hs_strike "the previous boot never completed"
    : > "$HS_SKIP"
    printf '{"ok":true,"stub":false,"reason":"failsafe"}\n'; return 0
  fi
  if [ "$(hs_strikes)" -ge "$HS_MAX_STRIKES" ]; then
    set_cfg_bool homestub false
    printf '{"ok":true,"stub":false,"reason":"faults"}\n'; return 0
  fi
  if [ ! -d "$ASSETS/i18n" ] || [ ! -f "$STUB_SRC/appinfo.json" ]; then
    printf '{"ok":true,"stub":false,"reason":"no-stage"}\n'; return 0
  fi
  if homestub_up; then
    hs_wd_start
    printf '{"ok":true,"stub":true}\n'
  else
    printf '{"ok":true,"stub":false,"reason":"failed"}\n'
  fi
  return 0
}

verb_homestub_watch() {
  # The guard: one detached shell. While all is well it forks one grep every 10 s:
  # the reads are builtins and the one-second wait is a read on a fifo.
  if hs_wd_alive && [ "$(cat "$HS_WD_PID" 2>/dev/null)" != "$$" ]; then exit 0; fi
  printf '%s\n' "$$" > "$HS_WD_PID"
  HS_IN_GUARD=1
  trap 'hs_guard_exit' TERM INT HUP
  [ -p "$HS_TICK" ] || { rm -f "$HS_TICK"; mkfifo "$HS_TICK" 2>/dev/null; }
  # Requests and a beat left from before this guard started are stale.
  rm -f "$HS_ESCAPE" "$HS_CONFIRM" "$HS_BEAT"
  read -r hs_up hs_idle < /proc/uptime; hs_now=${hs_up%%.*}
  hs_last=""; hs_ok_at=$hs_now; hs_grace=$((hs_now + HS_GRACE)); hs_cpid=""; hs_gap=0; hs_good=0; hs_mchk=$hs_now; hs_dark=0
  log_line "homestub: guard started"
  while :; do
    if [ -p "$HS_TICK" ]; then read -t 1 hs_x <> "$HS_TICK" 2>/dev/null; else sleep 1; fi
    read -r hs_up hs_idle < /proc/uptime; hs_now=${hs_up%%.*}

    if [ -e "$HS_ESCAPE" ]; then
      rm -f "$HS_ESCAPE"; homestub_escape; hs_guard_exit
    fi
    if [ -e "$HS_CONFIRM" ]; then
      rm -f "$HS_CONFIRM"; homestub_confirm >/dev/null 2>&1
    fi
    if [ -f "$HS_TRIAL" ]; then
      hs_dl=""; { read -r hs_tb hs_dl < "$HS_TRIAL"; } 2>/dev/null
      case "$hs_dl" in
        ''|*[!0-9]*) : ;;
        *) if [ "$hs_now" -ge "$hs_dl" ]; then homestub_expire; hs_guard_exit; fi ;;
      esac
    fi

    # The compositor: a new process, or none yet, means it is restarting and LumaHome
    # needs the grace again. One that started after this guard did has to carry the
    # module: the first start of a boot is stock, but a restart is ours, and one
    # without the module (failsafe, revert, a changed env file) leaves the stub
    # showing nothing.
    if [ -z "$hs_cpid" ] || [ ! -d "/proc/$hs_cpid" ]; then
      hs_np=$(pgrep -x surface-manager 2>/dev/null | head -n1)
      if [ -z "$hs_np" ]; then
        hs_cpid=""; hs_gap=1; hs_ok_at=$hs_now; hs_grace=$((hs_now + HS_GRACE))
      elif [ "$hs_np" != "$hs_cpid" ]; then
        if [ -n "$hs_cpid" ] || [ "$hs_gap" = 1 ]; then
          log_line "homestub: compositor restarted"
          # A process read between its fork and exec shows systemd's environment,
          # not ours, so the module has to be missing for 3 s before LG's Home is
          # given back.
          hs_ci=0
          while [ "$hs_ci" -lt 3 ] && ! compositor_has_shadow; do sleep 1; hs_ci=$((hs_ci+1)); done
          if ! compositor_has_shadow; then
            homestub_fault "the compositor restarted without LumaTV's module"
            hs_guard_exit
          fi
        fi
        hs_gap=0; hs_cpid=$hs_np; hs_ok_at=$hs_now; hs_grace=$((hs_now + HS_GRACE))
      fi
    fi

    # LumaTV's own compositor draws no LumaHome: there is no beat to read, and its supervisor
    # falls back by itself (and runs the Home recovery), so the stub stays and the checks below
    # that read the beat are skipped while it is live.
    if comp_live; then
      hs_ok_at=$hs_now; hs_grace=$((hs_now + HS_GRACE))
    else
    hs_b=""; { read -r hs_b < "$HS_BEAT"; } 2>/dev/null
    # The compositor's container writes "error" in place of a beat when LumaHome
    # failed to load.
    if [ "$hs_b" = error ]; then
      homestub_fault "LumaHome could not be loaded"
      hs_guard_exit
    fi
    if [ -n "$hs_b" ] && [ "$hs_b" != "$hs_last" ]; then
      hs_last=$hs_b; hs_ok_at=$hs_now; hs_good=$((hs_good + 1)); hs_dark=0
      # A minute of beats ends the run of faults.
      if [ "$hs_good" -eq 60 ]; then rm -f "$HS_STRIKES"; fi
    fi
    if [ "$hs_now" -ge "$hs_grace" ] && [ $((hs_now - hs_ok_at)) -ge "$HS_STALE" ]; then
      # No beat, and the panel is off (standby): not a fault. After a restart of the
      # compositor with the panel off (a boot into standby) LumaHome never beat in 14
      # minutes of standby, and the guard gave LG's Home back at 30 s. The beat is checked
      # again from the first screen-on, with a fresh grace. A set that is on gets no such
      # allowance.
      if ! panel_is_active; then
        if [ "$hs_dark" = 0 ]; then hs_dark=1; log_line "homestub: no beat and the panel is off, waiting for the screen"; fi
        hs_ok_at=$hs_now
      elif [ "$hs_dark" = 1 ]; then
        hs_dark=0; hs_ok_at=$hs_now; hs_grace=$((hs_now + HS_GRACE))
        log_line "homestub: screen on, waiting for the beat"
      else
        # Unchanged for HS_STALE s. The file's own age is checked before LG's Home is
        # given back: a fault was once logged on the guard's reading alone while
        # LumaHome's counter showed no stall.
        hs_age=$(( $(date +%s) - $(mtime_epoch "$HS_BEAT") ))
        if [ "$hs_age" -le 2 ]; then
          log_line "homestub: beat read as unchanged at '$hs_last' for $((hs_now - hs_ok_at)) s but the file is $hs_age s old, kept"
          hs_ok_at=$hs_now
        else
          homestub_fault "LumaHome's heartbeat stopped ($((hs_now - hs_ok_at)) s, file $hs_age s old)"
          hs_guard_exit
        fi
      fi
    fi
    fi

    # Every 10 s: is the stub still mounted? A guard for a stub that is gone has
    # nothing to guard. One grep: a read loop over mountinfo costs a syscall per
    # byte in busybox's ash, 4 % of a core at one scan in 5 s.
    if [ $((hs_now - hs_mchk)) -ge 10 ]; then
      hs_mchk=$hs_now
      if ! hs_mounted_any; then
        log_line "homestub: the stub is no longer mounted, guard stops"
        hs_guard_exit
      fi
    fi
  done
}

# ------------------------------------------------------------------- revert

# ---------------------------------------------------------------- tile icons
# An earlier version edited each app's icon and iconColor so that Home's dock tiles filled edge to
# edge (tools/tileicons.js). The compositor paints the dock itself now, so `revert` and every
# apply only put the original files back. sam and homelaunchpoints read those files when they
# start, so the restored ones show from the next boot. Neither is restarted here: SAM is never
# restarted, a set rule (eARC, CEC and the picture mode are at risk when it is), and a stale
# icon colour costs nothing.
TILEICONS="$APPDIR/tools/tileicons.js"
NODE=/usr/bin/node

# ------------------------------------------------------------------- helper

# The picture decoder (jpeg/service.c): a 32-bit program over LG's hardware JPEG block that the helper starts when a picture is
# wanted and that ends by itself when it is not. Staged beside the helper, which looks for it there. Not fatal: without it the
# helper serves pictures as the files they are and the shell decodes them.
jpeg_stage() {
  [ -x "$JPEG_SRC" ] || return 0   # a package built before it existed
  cmp -s "$JPEG_SRC" "$JPEG_BIN" 2>/dev/null && return 0
  mkdir -p "$STATE/bin" 2>/dev/null \
    && cp -f "$JPEG_SRC" "$JPEG_BIN.new" 2>/dev/null && chmod 755 "$JPEG_BIN.new" \
    && mv -f "$JPEG_BIN.new" "$JPEG_BIN" 2>/dev/null \
    || { rm -f "$JPEG_BIN.new"; log_line "jpeg: could not stage the decoder"; return 1; }
}

helper_start() {
  # Idempotent. Needs $STATE writable (the boot worker and apply run after /var is). A failure is
  # logged and never fatal: Home draws the last saved weather and news without it.
  [ -x "$HELPER_SRC" ] || { log_line "helper: no helper in the package"; return 1; }
  if ! cmp -s "$HELPER_SRC" "$HELPER_BIN" 2>/dev/null; then
    [ -x "$HELPER_BIN" ] && "$HELPER_BIN" stop --brand "$APPDIR/brand.json" >/dev/null 2>&1
    mkdir -p "$STATE/bin" 2>/dev/null \
      && cp -f "$HELPER_SRC" "$HELPER_BIN.new" 2>/dev/null && chmod 755 "$HELPER_BIN.new" \
      && mv -f "$HELPER_BIN.new" "$HELPER_BIN" 2>/dev/null \
      || { rm -f "$HELPER_BIN.new"; log_line "helper: could not stage the binary"; return 1; }
  fi
  jpeg_stage || true
  out=$("$HELPER_BIN" start --brand "$APPDIR/brand.json" 2>&1)
  case "$out" in
    *'"ok":true'*) return 0 ;;
  esac
  log_line "helper: start failed: $(printf '%s' "$out" | tr -d '\n' | cut -c1-200)"
  return 1
}

helper_stop() {
  [ -x "$HELPER_BIN" ] || return 0
  "$HELPER_BIN" stop --brand "$APPDIR/brand.json" >/dev/null 2>&1
  return 0
}

helper_json() {
  out=""
  [ -x "$HELPER_BIN" ] && out=$("$HELPER_BIN" status --brand "$APPDIR/brand.json" 2>/dev/null | tr -d '\n')
  case "$out" in
    '{'*'}') printf '%s' "$out" ;;
    *) printf '{"running":false}' ;;
  esac
}

verb_helper() {
  case "$1" in
    start) if helper_start; then printf '{"ok":true,"helper":%s}\n' "$(helper_json)"; else emit_error "helper did not start; see $LOGFILE"; return 1; fi ;;
    stop) helper_stop; printf '{"ok":true,"helper":%s}\n' "$(helper_json)" ;;
    status) printf '{"ok":true,"helper":%s}\n' "$(helper_json)" ;;
    *) emit_error "helper: start, stop or status"; return 1 ;;
  esac
  return 0
}

# The colour reader. Not fatal: without it the ambient light has no picture and says so; everything else is as it was.
capture_start() {
  [ -f "$CAPTURE_SRC" ] || return 0   # a package built before it existed
  out=$(sh "$CAPTURE_SH" install "$CAPTURE_SRC" "$CAPTURE_ROLE" "$STATE" 2>&1) \
    && out=$(sh "$CAPTURE_SH" start "$STATE" "$CAPTURE_SOCKET" 2>&1) && return 0
  log_line "capture: $(printf '%s' "$out" | tr -d '\n' | cut -c1-200)"
  return 1
}

capture_stop() { [ -f "$CAPTURE_SH" ] && sh "$CAPTURE_SH" stop "$STATE" >/dev/null 2>&1; return 0; }

# Revert takes the role and the staged binary away with it: nothing of the reader stays on the set once LumaTV is off.
capture_remove() { [ -f "$CAPTURE_SH" ] && sh "$CAPTURE_SH" remove "$STATE" >/dev/null 2>&1; return 0; }

capture_json() {
  [ -f "$CAPTURE_SH" ] && sh "$CAPTURE_SH" status "$STATE" 2>/dev/null | tr -d '\n' || printf '{"installed":false,"role":false,"running":false,"pid":0}'
}

verb_capture() {
  case "$1" in
    start) if capture_start; then printf '{"ok":true,"capture":%s}\n' "$(capture_json)"; else emit_error "capture did not start; see $LOGFILE"; return 1; fi ;;
    stop) capture_stop; printf '{"ok":true,"capture":%s}\n' "$(capture_json)" ;;
    remove) capture_remove; printf '{"ok":true,"capture":%s}\n' "$(capture_json)" ;;
    status) printf '{"ok":true,"capture":%s}\n' "$(capture_json)" ;;
    *) emit_error "capture: start, stop, remove or status"; return 1 ;;
  esac
  return 0
}

# The art saver's video-plane player. Installed means its program is staged and its role is written (vplane.sh status says so), and only
# `lumatv vplane install` gets it there. A player that is not installed is not a fault anywhere: the saver draws its own picture.
vplane_json() {
  [ -f "$VPLANE_SH" ] && sh "$VPLANE_SH" status "$STATE" 2>/dev/null < /dev/null | tr -d '\n' || printf '{"installed":false,"role":false,"clips":0,"running":false,"pid":0}'
}

vplane_installed() {
  vp_st=$(vplane_json)
  case "$vp_st" in *'"installed":true'*) ;; *) return 1 ;; esac
  case "$vp_st" in *'"role":true'*) return 0 ;; esac
  return 1
}

vplane_install() {
  { [ -f "$VPLANE_SH" ] && [ -f "$VPLANE_SRC" ]; } || { vp_out="this package has no video-plane player"; return 1; }
  vp_out=$(sh "$VPLANE_SH" install "$VPLANE_SRC" "$VPLANE_ROLE" "$VPLANE_CLIPS" "$STATE" 2>&1 < /dev/null) && return 0
  log_line "vplane install: $(printf '%s' "$vp_out" | tr -d '\n' | cut -c1-200)"
  return 1
}

vplane_start() {
  [ -f "$VPLANE_SH" ] || { vp_out="this package has no video-plane player"; return 1; }
  vp_out=$(sh "$VPLANE_SH" start "$STATE" "$VPLANE_MAILBOX" "$VPLANE_APPID" 2>&1 < /dev/null) && return 0
  log_line "vplane: $(printf '%s' "$vp_out" | tr -d '\n' | cut -c1-200)"
  return 1
}

vplane_stop() { [ -f "$VPLANE_SH" ] && sh "$VPLANE_SH" stop "$STATE" >/dev/null 2>&1; return 0; }

# Revert takes the player, its role, its clips and the manifest away: nothing of it stays on the set once LumaTV is off.
vplane_remove() { [ -f "$VPLANE_SH" ] && sh "$VPLANE_SH" remove "$STATE" >/dev/null 2>&1; return 0; }

verb_vplane() {
  case "${1:-status}" in
    install)
      take_mutation_lock || { emit_error "another apply or revert is still running"; return 1; }
      if vplane_install; then printf '{"ok":true,"vplane":%s}\n' "$(vplane_json)"; else emit_error "vplane did not install: $vp_out"; return 1; fi ;;
    start) if vplane_start; then printf '{"ok":true,"vplane":%s}\n' "$(vplane_json)"; else emit_error "vplane did not start: $vp_out"; return 1; fi ;;
    stop) vplane_stop; printf '{"ok":true,"vplane":%s}\n' "$(vplane_json)" ;;
    remove)
      take_mutation_lock || { emit_error "another apply or revert is still running"; return 1; }
      vplane_remove; printf '{"ok":true,"vplane":%s}\n' "$(vplane_json)" ;;
    status) printf '{"ok":true,"vplane":%s}\n' "$(vplane_json)" ;;
    *) emit_error "vplane: install, start, stop, remove or status"; return 1 ;;
  esac
  return 0
}

verb_preload() {
  case "$1" in
    on|off|status)
      out=$(python3 "$PRELOAD_TOOL" "$1" "$PRELOAD_SRC" "$PRELOAD_ORIG" "$PRELOAD_STATE" < /dev/null 2>>"$LOGFILE"); rc=$?
      [ -n "$out" ] || out='{"ok":false,"error":"preload tool failed"}'
      printf '%s\n' "$out"
      [ "$1" = status ] || log_line "preload $1: $(printf '%s' "$out" | cut -c1-200)"
      return $rc ;;
    *) emit_error "preload: on, off or status"; return 1 ;;
  esac
}

recover_home() {
  # LG's Home after the compositor was away and came back: the bundle's own script when it is there
  # (it holds the recovery lock), else the tool's relaunch.
  if [ -f "$COMP/bin/recover-home.sh" ]; then sh "$COMP/bin/recover-home.sh" "$COMP/sm.log" >/dev/null 2>&1
  else home_back_after_restart; fi
}

verb_compositor() {
  case "${1:-status}" in
    on|off)
      take_mutation_lock || { emit_error "another apply or revert is still running"; return 1; }
      msg=$(comp_switch "$1"); rc=$?
      if [ "$rc" -ne 0 ]; then emit_error "$msg"; return 1; fi
      log_line "compositor $1"
      printf '{"ok":true,"compositor":%s}\n' "$(comp_json)" ;;
    status) printf '{"ok":true,"compositor":%s}\n' "$(comp_json)" ;;
    check) printf '{"ok":true,"check":%s}\n' "$(comp_check_json)" ;;
    *) emit_error "compositor: on, off, status or check"; return 1 ;;
  esac
  return 0
}

verb_compositor_boot() {
  # The early hook's step before apply restarts the compositor: place the mount when everything allows it
  # (the flag, a firmware build the gate passed on, an intact bundle, a supervisor that answers, Home not held).
  # comp_boot_mount logs the reason of a refusal itself; the word is logged here.
  r=$(comp_boot_mount)
  log_line "compositor-boot: $r"
  printf '{"ok":true,"compositor":"%s"}\n' "$r"
  return 0
}

revert_tile_icons() {
  [ -x "$NODE" ] && [ -f "$TILEICONS" ] || return 0
  out=$("$NODE" "$TILEICONS" revert "$STATE" 2>>"$LOGFILE") || return 0
  n=$(printf '%s' "$out" | sed -n 's/.*"restored":\([0-9]*\).*/\1/p'); [ -n "$n" ] || n=0
  [ "$n" -gt 0 ] && log_line "tile icons: restored $n file(s); the launcher reads them at its next start"
  return 0
}

do_revert_internal() {
  # Mechanics only; never prints. Sets REVERT_CHANGED=1 if anything was
  # actually mounted or restored, so callers can decide whether a disruptive
  # compositor restart / Home relaunch is warranted.
  REVERT_CHANGED=0

  helper_stop
  capture_remove
  vplane_remove
  rm -f "$JPEG_BIN" "$JPEG_BIN.new"   # the picture decoder: the helper that started it is stopped, so it has ended
  comp_release
  [ -f "$PRELOAD_STATE" ] && python3 "$PRELOAD_TOOL" off "$PRELOAD_SRC" "$PRELOAD_ORIG" "$PRELOAD_STATE" < /dev/null >/dev/null 2>&1

  # LG's Home first, so what the restart below brings up is LG's, not the stub.
  homestub_drop legacy
  if [ "${HS_DROPPED:-0}" = 1 ]; then REVERT_CHANGED=1; fi
  rm -f "$HS_MODE" "$HS_BEAT" "$HS_SKIP" "$HS_STRIKES"

  # The env file is what makes a starting compositor load our module, so it
  # goes first: from that point on any compositor start is stock, whether or
  # not the restart below succeeds.
  if [ -f "$ENV_FILE" ]; then REVERT_CHANGED=1; fi
  remove_env
  rm -f "$ENV_EXTRA"
  clear_qml_cache
  keyfilter_set remove
  [ -f "$LOGO_ON" ] && logo_set off
  [ -f "$NOTI_ON" ] && { noti_set off; rm -f "$NOTI_ON"; }
  rm -f "$KEYBOARD_ON"
  [ -f "$INPUTCOMMON_ON" ] && { inputcommon_set off; rm -f "$INPUTCOMMON_ON"; }
  [ -f "$VOICE_ON" ] && { voice_set off; rm -f "$VOICE_ON"; }
  # Nothing of ours should run on the boot path after a revert, including the
  # PATH shim kdump.service would otherwise resolve.
  remove_early_hook
  if [ -d "$SHADOW_ROOT" ]; then REVERT_CHANGED=1; fi
  rm -rf "$SHADOW_ROOT" "$SHADOW_ROOT.next" "$SHADOW_ROOT.old" 2>/dev/null
  rm -f "$SHADOW_STOCK_FP" "$SHADOW_SELF_FP" "$SHADOW_PATCH_FP" 2>/dev/null

  if is_mounted "$STOCK_ASSETS"; then REVERT_CHANGED=1; fi
  drain_umount "$STOCK_ASSETS"

  revert_tile_icons

  # Nothing of ours is live any more, so the next apply must not inherit the
  # old bind time and skip a restart the compositor genuinely needs.
  rm -f "$BOUND_AT" "$BOOT_PENDING"

  if [ "$REVERT_CHANGED" -eq 1 ]; then
    restart_surface >/dev/null 2>&1
    home_back_after_restart
  fi
  return 0
}

verb_revert() {
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  do_revert_internal
  mounts=$(count_mounts)
  log_line "revert: changed=$REVERT_CHANGED mounts=$mounts"
  ntfy_notify "$DISPLAY_NAME reverted to stock"
  printf '{"ok":true,"applied":false,"mounts":%s}\n' "$mounts"
  return 0
}

# -------------------------------------------------------------------- apply

verb_apply() {
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  t0=$(date +%s)
  mkdir -p "$STATE" "$BACKUP" 2>/dev/null

  version=$(get_version); [ -n "$version" ] || version="0.0.0"

  # 1. Build/refresh $ASSETS from real stock, never from a merged view.
  need_build=0
  if [ ! -d "$ASSETS" ] || [ ! -d "$ASSETS/i18n" ]; then
    need_build=1
  else
    stamp_epoch=$(mtime_epoch "$STAMP")
    for src in "$HOME_XML_SRC" "$EN_SED_SRC" "$BG_HD_SRC" "$BG_2K_SRC" "$BG_4K_SRC"; do
      s_epoch=$(mtime_epoch "$src")
      if [ "$s_epoch" -gt "$stamp_epoch" ] 2>/dev/null; then need_build=1; fi
    done
  fi

  if [ "$need_build" -eq 1 ]; then
    # The copy below reads LG's own directory; homestub_sync puts the stub back.
    if hs_mounted_ours; then homestub_drop legacy; fi
    # Unmount first: if a bind is already active, reading the target now
    # would copy a merged view, never real stock.
    drain_umount "$STOCK_ASSETS"
    rm -rf "$ASSETS.building" 2>/dev/null
    mkdir -p "$ASSETS.building"
    cperr=$( (cd "$STOCK_ASSETS" && cp -R . "$ASSETS.building") 2>&1 >/dev/null )
    cprc=$?
    if [ "$cprc" -ne 0 ]; then
      log_line "apply: failed to copy stock assets: $cperr"
      ntfy_notify "$DISPLAY_NAME apply failed: could not copy stock assets"
      emit_error "stock asset copy failed: $cperr"
      return 1
    fi
    # i18n is a symlink in real stock; dereference it into a real directory
    # so string overlays land inside the copy, not on the original target.
    if [ -L "$ASSETS.building/i18n" ]; then
      i18n_target=$(readlink "$ASSETS.building/i18n" 2>/dev/null)
      case "$i18n_target" in
        /*) : ;;
        *) i18n_target="$STOCK_ASSETS/$i18n_target" ;;
      esac
      if [ -n "$i18n_target" ] && [ -d "$i18n_target" ]; then
        rm -f "$ASSETS.building/i18n"
        mkdir -p "$ASSETS.building/i18n"
        ( cd "$i18n_target" && cp -R . "$ASSETS.building/i18n" ) 2>/dev/null
      fi
    fi
    # Keep a pristine copy of the stock strings. Every apply regenerates
    # en.json from this, so the greeting cannot freeze at a stale value the
    # way an in-place rewrite would (the sed rules match stock text only).
    if [ -f "$ASSETS.building/i18n/en.json" ]; then
      cp -f "$ASSETS.building/i18n/en.json" "$ASSETS.building/i18n/en.json.stock" 2>/dev/null
    fi
    rm -rf "$ASSETS" 2>/dev/null
    mv "$ASSETS.building" "$ASSETS"
    touch "$STAMP" 2>/dev/null
  fi

  # 2. Overlay payload onto $ASSETS.
  cp -f "$HOME_XML_SRC" "$ASSETS/home.xml" 2>/dev/null

  mkdir -p "$ASSETS/images/hd" "$ASSETS/images/2k" "$ASSETS/images/4k" 2>/dev/null
  cp -f "$BG_HD_SRC" "$ASSETS/images/hd/bg_banner_img.png" 2>/dev/null
  cp -f "$BG_2K_SRC" "$ASSETS/images/2k/bg_banner_img.png" 2>/dev/null
  cp -f "$BG_4K_SRC" "$ASSETS/images/4k/bg_banner_img.png" 2>/dev/null

  # Keep a pristine stock copy and always regenerate from it: rewriting
  # en.json in place would stop matching the stock keys on the second apply.
  # The greeting is owned by the compositor QML, not by these strings.
  if [ ! -f "$ASSETS/i18n/en.json.stock" ] && [ -f "$ASSETS/i18n/en.json" ]; then
    cp -f "$ASSETS/i18n/en.json" "$ASSETS/i18n/en.json.stock" 2>/dev/null
  fi
  if [ -f "$ASSETS/i18n/en.json.stock" ]; then
    sed -f "$EN_SED_SRC" "$ASSETS/i18n/en.json.stock" 2>/dev/null > "$ASSETS/i18n/en.json.tmp.$$" \
      && mv "$ASSETS/i18n/en.json.tmp.$$" "$ASSETS/i18n/en.json"
  fi

  # 3. Stage the compositor QML this apply would use, then decide what changed.
  #
  # The compositor picks our QML up through the import path (a shadow copy of
  # its module), not a bind, so there is nothing to unmount for it. Home still
  # reads its layout from a bound assets directory. A byte-identical set that
  # is already live and already served by a shadow-aware compositor is left
  # untouched, so a no-op apply neither remounts nor restarts anything.
  fps_now=$(cfg_get_bool fps); [ -n "$fps_now" ] || fps_now=false
  stage_compositor "$fps_now" "$COMPOSITOR_STAGE.next"
  if ! stage_luma "$fps_now" "$LUMA_STAGE.next"; then
    log_line "apply: Home QML payload missing"
    ntfy_notify "$DISPLAY_NAME apply failed: Home QML payload missing"
    emit_error "Home QML payload missing"
    return 1
  fi
  stage_theme
  install_frame_app
  # The key-filter script is read once when the compositor builds its handler
  # chain, so a changed script needs the restart below; compare before the copy.
  kf_changed=1
  [ "$(md5sum < "$KEYFILTER_SRC" 2>/dev/null)" = "$(md5sum < "$KEYFILTER_DIR/$SHORT_ID.js" 2>/dev/null)" ] && kf_changed=0
  keyfilter_set add || log_line "apply: could not register the key filter with configd"

  # The settings menus are re-asserted here, not just when the verb is run: the
  # configd redirect survives a reboot but the staged tree has to be rebuilt
  # after a firmware update, and the overlay mounts are gone after every boot.
  # Both are no-ops when they are already in place.
  [ -f "$SYSTEMUI_ON" ] && { systemui_set on || log_line "apply: could not point Quick Settings at the staged tree"; }
  [ -f "$WEBGLASS_ON" ] && { webglass_set on || log_line "apply: could not mount the settings-app stylesheet"; }
  [ -f "$LOGO_ON" ] && { logo_set on || log_line "apply: could not point the logos at the staged windows"; }
  [ -f "$NOTI_ON" ] && { noti_set on || { rm -f "$NOTI_ON"; log_line "apply: the notification view fell back to LG's"; }; }
  [ -f "$INPUTCOMMON_ON" ] && { inputcommon_mounted || inputcommon_set on || log_line "apply: could not mount the patched input banners over LG's"; }
  [ -f "$VOICE_ON" ] && { voice_mounted || voice_set on || log_line "apply: could not mount the patched Search app over LG's"; }

  # What the compositor reads (QML, wallpaper) is tracked apart from the rest
  # of the set: a running compositor that already has the shadow only needs a
  # restart when one of those two actually changed, and nothing else in the
  # set can be reached with a restart alone.
  compositor_changed=1
  if [ "$kf_changed" -eq 0 ] \
     && [ "$(md5sum < "$COMPOSITOR_STAGE.next" 2>/dev/null)" = "$(md5sum < "$COMPOSITOR_STAGE" 2>/dev/null)" ] \
     && [ "$(md5sum < "$WALL_SRC" 2>/dev/null)" = "$(md5sum < "$WALLPAPER_STAGE" 2>/dev/null)" ] \
     && [ "$(tree_fp "$LUMA_STAGE.next")" = "$(tree_fp "$LUMA_STAGE")" ] \
     && shadow_patch_current; then
    compositor_changed=0
  fi
  # The env file is read only when the compositor starts, so a change to it
  # (env.extra edited, or a tool update that changes env_line) needs the
  # restart too. Taken before write_env below makes the file current.
  env_changed=0
  env_live || env_changed=1
  changed=1
  if [ "$compositor_changed" -eq 0 ] && all_binds_live && shadow_current && env_live; then
    changed=0
    rm -f "$COMPOSITOR_STAGE.next"; rm -rf "$LUMA_STAGE.next"
    log_line "apply: staged set unchanged, shadow current, assets bound, not remounting"
  fi

  if [ "$changed" -eq 1 ]; then
    cp -f "$WALL_SRC" "$WALLPAPER_STAGE" 2>/dev/null
    mv -f "$COMPOSITOR_STAGE.next" "$COMPOSITOR_STAGE"
    rm -rf "$LUMA_STAGE" 2>/dev/null; mv -f "$LUMA_STAGE.next" "$LUMA_STAGE"

    # 4. Build the shadow compositor module and point the compositor's env
    # file at it. This is what a freshly starting compositor reads; nothing
    # is mounted for it.
    if ! build_shadow; then
      log_line "apply: could not build shadow compositor module"
      do_revert_internal
      ntfy_notify "$DISPLAY_NAME apply failed: could not build compositor module"
      emit_error "shadow module build failed"
      return 1
    fi
    if ! write_env; then
      log_line "apply: could not write compositor env file"
      do_revert_internal
      ntfy_notify "$DISPLAY_NAME apply failed: could not write compositor env"
      emit_error "compositor env write failed"
      return 1
    fi

    # 5. Bind Home's assets (its layout, strings and banner images). Under the stub
    # they stay bound where they are: the path below is not LG's directory then.
    if hs_mounted_ours && ! is_mounted "$STOCK_ASSETS"; then homestub_drop legacy; fi
    if hs_mounted_ours; then
      log_line "apply: Home's assets stay bound under the stub"
    else
      drain_umount "$STOCK_ASSETS"
      binderr=$(mount --bind "$ASSETS" "$STOCK_ASSETS" 2>&1 >/dev/null)
      if [ $? -ne 0 ]; then
        log_line "apply: bind failed on assets: $binderr"
        do_revert_internal
        ntfy_notify "$DISPLAY_NAME apply failed: assets bind failed"
        emit_error "assets bind failed: $binderr"
        return 1
      fi
      if ! is_mounted "$STOCK_ASSETS"; then
        log_line "apply: assets bind verification failed"
        do_revert_internal
        ntfy_notify "$DISPLAY_NAME apply failed: bind verification failed"
        emit_error "assets bind verification failed"
        return 1
      fi
    fi
    record_bound_now
  fi

  # 5b. The compositor paints the dock itself now, so the per-app icon and
  # iconColor edits Home once needed are restored and never made again.
  revert_tile_icons

  # 5c. The Home stub, before anything restarts, so the Home the compositor's
  # restart relaunches is the stub.
  homestub_sync

  # 5d. The helper before the compositor restarts, so Home's first request finds it. Not fatal.
  helper_start
  # 5e. The colour reader and its bus role. Not fatal: it idles until the helper wants a picture.
  capture_start || true
  # 5f. The art saver's video-plane player, where the owner installed it. Not fatal: without it the saver draws its own picture. Never
  # installed from here: its role is a permission, so `lumatv vplane install` is the owner's.
  if vplane_installed; then vplane_start || true; fi
  # The preload list is configd's and survives a restart; re-asserted only where `preload on` was
  # run, and written only when it differs.
  [ -f "$PRELOAD_STATE" ] && python3 "$PRELOAD_TOOL" on "$PRELOAD_SRC" "$PRELOAD_ORIG" "$PRELOAD_STATE" < /dev/null >/dev/null 2>>"$LOGFILE"

  # 6. Bring the change on screen.
  #
  # The compositor only reads QML at startup, so the shadow reaches the screen
  # when it next starts, and its first start at boot+2.6s cannot see the env
  # file (see the constants block: /var is not the writable filesystem that
  # early). So the restart is the mechanism, not a fallback: if the compositor
  # that is running does not have the shadow, restart it.
  #
  # Deliberately NOT gated on panel_is_active. That gate was here to avoid
  # racing a power transition, and it silently abandoned the restart instead:
  # on a boot where the panel had not finished waking, apply skipped it, and
  # nothing ever retried, so the set ran the whole session on stock QML under
  # a modded Home layout. A restart while the panel is dark is invisible;
  # never restarting is not. restart_surface cleans up the crash reports the
  # restart provokes, which is what keeps power-off immediate.
  # A compositor that started with the shadow but before this apply rebuilt
  # it is still running the previous QML; the shadow on disk says nothing
  # about what the running process loaded.
  restart_needed=0
  if surface_start_uptime >/dev/null 2>&1; then
    if ! compositor_has_shadow || [ "$compositor_changed" -eq 1 ] || [ "$env_changed" -eq 1 ]; then restart_needed=1; fi
  fi
  # A changed compositor set starts from an empty QML cache; a restart for an
  # env change or a stock compositor at boot keeps it.
  [ "$compositor_changed" -eq 1 ] && clear_qml_cache
  # LumaTV's own compositor reads none of the QML this apply staged; restarting its unit would only
  # blank the panel.
  if comp_live; then restart_needed=0; fi

  if [ "$restart_needed" -eq 1 ]; then
    marker=$(wc -l < "$MSGLOG" 2>/dev/null | tr -d ' '); [ -n "$marker" ] || marker=0
    if ! restart_surface; then
      log_line "apply: surface-manager-daemon did not come back active"
      do_revert_internal
      ntfy_notify "$DISPLAY_NAME apply failed: compositor did not restart"
      emit_error "compositor did not become active after restart"
      return 1
    fi
    log_line "apply: compositor restarted to read shadow module"
    home_back_after_restart
    if sed -n "$((marker+1)),\$p" "$MSGLOG" 2>/dev/null | grep -qa 'shader compilation failed'; then
      log_line "apply: shader compilation failure detected post-restart, auto-reverting"
      rm -f "$VERIFIED"
      do_revert_internal
      ntfy_notify "$DISPLAY_NAME apply failed: shader compilation error, auto-reverted to stock"
      emit_error "shader compilation failed; auto-reverted to stock"
      return 1
    fi
  elif [ "$changed" -eq 1 ]; then
    # Compositor already serves the shadow (or is not yet up); only Home needs
    # to re-read the freshly bound assets.
    kill_home_app
    relaunch_home
  fi
  staged_hash > "$VERIFIED"

  mounts=$(count_mounts)
  took=$(( $(date +%s) - t0 ))
  log_line "apply: success version=$version mounts=$mounts took=${took}s"
  ntfy_notify "$DISPLAY_NAME applied (v$version)"
  printf '{"ok":true,"applied":true,"mounts":%s,"took":%s}\n' "$mounts" "$took"
  return 0
}

# ---------------------------------------------------------------- boot-bind

verb_boot_bind() {
  # The boot hook's opening move. The compositor's first start is always
  # stock - at 2.63s /var is not yet the writable filesystem, so its optional
  # EnvironmentFile read finds nothing (see the constants block) - and the
  # apply that follows this restarts it. Binding first matters: the bind is
  # what Home re-reads, and the restart kills Home anyway.
  #
  # What this does is bind Home's assets - a bind mount does not survive a
  # reboot - and check the two things that can make a persistent env file
  # dangerous.
  #
  # 1. A firmware update replaces the stock compositor module. Our shadow was
  #    built from the old one, so it would feed stale QML to new libraries.
  #    Rebuild it; if that fails, drop the env file so the set is stock.
  # 2. Our QML could stop the compositor from starting at all. Unlike a bind,
  #    a persistent env file would repeat that on every boot. If the hook runs
  #    and no compositor is up, drop the env file and restart, which puts the
  #    TV back on stock rather than leaving a black screen.
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  if [ -f "$BOOT_PENDING" ]; then
    rm -f "$BOOT_PENDING"
    log_line "boot-bind: previous boot never completed, skipping fast path once"
    printf '{"ok":true,"bound":false,"reason":"failsafe"}\n'
    return 0
  fi
  if [ ! -f "$COMPOSITOR_STAGE" ] || [ ! -f "$WALLPAPER_STAGE" ] || [ ! -d "$LUMA_STAGE/$QML_MODULE" ] || [ ! -f "$ASSETS/home.xml" ] || [ ! -d "$ASSETS/i18n" ]; then
    log_line "boot-bind: no staged set, leaving it to apply"
    printf '{"ok":true,"bound":false,"reason":"no-stage"}\n'
    return 0
  fi
  if [ "$(staged_hash)" != "$(cat "$VERIFIED" 2>/dev/null)" ]; then
    log_line "boot-bind: staged set is not the verified one, leaving it to apply"
    printf '{"ok":true,"bound":false,"reason":"unverified"}\n'
    return 0
  fi

  touch "$BOOT_PENDING"

  # Fail safe first: a compositor that never came up outranks everything else.
  if [ -f "$ENV_FILE" ] && ! surface_start_uptime >/dev/null 2>&1; then
    log_line "boot-bind: no compositor running with our env file present, reverting to stock"
    homestub_drop legacy
    remove_env
    rm -f "$ENV_EXTRA"
    systemctl restart "$SURFACE_SVC" >/dev/null 2>&1
    ntfy_notify "$DISPLAY_NAME disabled itself: compositor did not start"
    printf '{"ok":true,"bound":false,"reason":"compositor-absent"}\n'
    return 0
  fi

  if ! shadow_current; then
    # Either the firmware replaced the stock module, or the shadow itself is
    # damaged - a power cut mid-build leaves every file present and most of
    # them truncated. Both mean the module on disk cannot be trusted.
    log_line "boot-bind: shadow module not current (stale or damaged), rebuilding"
    if build_shadow; then
      log_line "boot-bind: shadow module rebuilt"
      # The compositor started before this hook did. If it loaded the module we
      # have just replaced, it is running on the bad one - and a compositor
      # that started on a truncated module comes up healthy and presents
      # nothing, so no liveness check catches it. Restart it once. LumaTV's own
      # compositor draws none of this module, so a rebuild (a changed patch
      # rebuilds it, SHADOW_PATCH_FILES) gives it nothing to reload and the
      # restart would only cost a boot's frames.
      if ! comp_live && compositor_has_shadow && panel_is_active; then
        log_line "boot-bind: compositor had loaded the damaged module, restarting it"
        restart_surface >/dev/null 2>&1
        home_back_after_restart
      fi
    else
      log_line "boot-bind: shadow rebuild failed, dropping env file"
      homestub_drop legacy
      remove_env
      if compositor_has_shadow && panel_is_active; then
        restart_surface >/dev/null 2>&1
        home_back_after_restart
      fi
      ntfy_notify "$DISPLAY_NAME disabled itself: compositor module unusable"
      printf '{"ok":true,"bound":false,"reason":"stale-module"}\n'
      return 0
    fi
  fi
  write_env
  keyfilter_set add || log_line "boot-bind: could not register the key filter with configd"

  n=0
  if ! is_mounted "$STOCK_ASSETS"; then
    mount --bind "$ASSETS" "$STOCK_ASSETS" >/dev/null 2>&1 && n=$((n+1))
  fi
  if all_binds_live; then
    record_bound_now
    log_line "boot-bind: $n bind(s) made, assets live, compositor already on shadow=$(compositor_has_shadow && echo yes || echo no)"
    printf '{"ok":true,"bound":true,"mounts":%s}\n' "$(count_mounts)"
  else
    log_line "boot-bind: assets bind incomplete, leaving it to apply"
    printf '{"ok":true,"bound":false,"reason":"incomplete"}\n'
  fi
  return 0
}

verb_boot_ok() {
  # Called by the boot hook once the boot's apply reported ok.
  rm -f "$BOOT_PENDING"
  printf '{"ok":true}\n'
  return 0
}

# ------------------------------------------------------------- boot-restart

get_general_setting() {
  # $1 = key in the "general" category. Prints the value, or nothing.
  luna-send -n 1 "$SETTINGS_GET_URI" "{\"category\":\"general\",\"keys\":[\"$1\"]}" 2>/dev/null \
    | tr -d '\n' | sed -n "s/.*\"$1\"[ ]*:[ ]*\"\\([^\"]*\\)\".*/\\1/p"
}

foreground_app_id() {
  luna-send -n 1 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null \
    | tr -d '\n' | sed -n 's/.*"appId"[ ]*:[ ]*"\([^"]*\)".*/\1/p'
}

boot_landing_app() {
  # What the boot's compositor restart puts back in front. Home, unless the owner set the TV to start on
  # its last input (general.homeAutoLaunch off): then the app in front now, which is the input bootd
  # opened at ~14 s. Prints the app id, or nothing for Home.
  [ "$(get_general_setting homeAutoLaunch)" = off ] || return 0
  la_app=$(foreground_app_id)
  case "$la_app" in ''|"$HOME_APP_ID") return 0 ;; esac
  printf '%s\n' "$la_app"
}

land_on_app() {
  # $1 = app id. One launch, then a bounded wait for it to be in front; the panel's pixels say nothing
  # here (an input with a signal is video). If it does not arrive, Home is what the set gets.
  luna-send -n 1 "$HOME_LAUNCH_URI" "{\"id\":\"$1\"}" >/dev/null 2>&1
  la_i=0
  while [ "$la_i" -lt 10 ] && [ "$(foreground_app_id)" != "$1" ]; do sleep 1; la_i=$((la_i+1)); done
  if [ "$(foreground_app_id)" = "$1" ]; then
    log_line "boot-restart: $1 back in front after $la_i s"
    # The teardown crash report of the restart lands ~3 s after it (see home_back_after_restart).
    sleep 3
    disarm_restart_crashes "$reports_before"
    return 0
  fi
  log_line "boot-restart: $1 did not come back, Home instead"
  home_back_after_restart
}

verb_boot_restart() {
  # The boot hook's step after boot-bind. The compositor's first start of a boot is stock and is restarted
  # once to read the shadow module. That restart used to follow the whole of apply's preparation (staging,
  # mounts, helper, preload: 30 s of it, at uptime 55 s on 2026-10-25 17:51), and the panel showed the last
  # input until then. boot-bind has just verified the set and written the env file, so the restart comes
  # first, and apply finds a compositor that has the module and does the rest without one.
  # Only a set that is on, only a boot-bind that went the whole way (it leaves BOOT_PENDING, the env file
  # and the assets bind); anything else is apply's, as before. Never fatal: a restart that fails is left
  # for apply to repeat.
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  if [ "${LUMA_BOOT:-0}" != 1 ]; then
    emit_error "boot-restart is the boot hook's step; use restart"
    return 1
  fi
  br_why=""
  if [ ! -f "$BOOT_PENDING" ]; then br_why="boot-bind did not verify the set"
  elif ! surface_start_uptime >/dev/null 2>&1; then br_why="no compositor running"
  elif compositor_has_shadow; then br_why="the compositor has the module already"
  elif ! all_binds_live || ! env_live || [ ! -d "$SHADOW_ROOT" ]; then br_why="the module, env file or assets bind is not in place"
  else
    # The power state can still be a step behind the panel at ~20 s into a boot; a set that stays in
    # standby past STANDBY_WAIT is a boot into standby, which apply handles.
    br_w=0
    while ! panel_is_active && [ "$br_w" -lt "$STANDBY_WAIT" ]; do sleep 1; br_w=$((br_w+1)); done
    panel_is_active || br_why="the set is not on"
  fi
  if [ -n "$br_why" ]; then
    log_line "boot-restart: left to apply ($br_why)"
    printf '{"ok":true,"restarted":false,"reason":"%s"}\n' "$br_why"
    return 0
  fi
  br_land=$(boot_landing_app)
  br_up=$(uptime_s)
  # Home's first request for weather and news finds the helper, as it does in apply's order.
  helper_start || true
  marker=$(wc -l < "$MSGLOG" 2>/dev/null | tr -d ' '); [ -n "$marker" ] || marker=0
  if ! restart_surface; then
    log_line "boot-restart: the compositor did not come back active, left to apply"
    printf '{"ok":true,"restarted":false,"reason":"restart failed"}\n'
    return 0
  fi
  log_line "boot-restart: compositor restarted at uptime $br_up s to read the shadow module"
  if [ -n "$br_land" ]; then land_on_app "$br_land"; else home_back_after_restart; fi
  if sed -n "$((marker+1)),\$p" "$MSGLOG" 2>/dev/null | grep -qa 'shader compilation failed'; then
    log_line "boot-restart: shader compilation failure detected post-restart, auto-reverting"
    rm -f "$VERIFIED"
    do_revert_internal
    ntfy_notify "$DISPLAY_NAME boot restart failed: shader compilation error, auto-reverted to stock"
    emit_error "shader compilation failed; auto-reverted to stock"
    return 1
  fi
  printf '{"ok":true,"restarted":true,"at":%s,"landed":"%s"}\n' "$br_up" "${br_land:-home}"
  return 0
}

# ------------------------------------------------------------------- status

surfaces_json() {
  # The registry of what LumaTV has taken over and what each one falls back to. One entry per
  # switch; `on` is read from the same flag or state the verb itself uses, never from a copy.
  b() { if "$@"; then printf true; else printf false; fi; }
  hs=$(homestub_json); hs_state=$(printf '%s' "$hs" | sed -n 's/.*"state":"\([a-z]*\)".*/\1/p')
  hp=$(helper_json); hp_on=false; case "$hp" in *'"running":true'*) hp_on=true ;; esac
  printf '['
  printf '{"id":"home","on":%s,"state":"%s","fallback":"LG'"'"'s Home: hold Home 650 ms, the guard, or `homestub off`"},' "$( [ "$hs_state" = stub ] || [ "$hs_state" = trial ] && echo true || echo false )" "$hs_state"
  printf '{"id":"quicksettings","on":%s,"fallback":"`systemui off` puts the stock entry back in configd"},' "$(b test -f "$SYSTEMUI_ON")"
  printf '{"id":"settings-theme","on":%s,"fallback":"`webglass off` unmounts the overlays"},' "$(b test -f "$WEBGLASS_ON")"
  printf '{"id":"inputcommon","on":%s,"fallback":"`inputcommon off` unmounts the overlay; a reboot or revert clears it and LG'"'"'s input banners return"},' "$(b test -f "$INPUTCOMMON_ON")"
  printf '{"id":"voice","on":%s,"fallback":"`voice off` unmounts the overlay; a reboot or revert clears it and LG'"'"'s Search app returns"},' "$(b test -f "$VOICE_ON")"
  printf '{"id":"keyboard","on":%s,"fallback":"`keyboard off` rebuilds the shadow module with LG'"'"'s own keyboard view; revert drops the module"},' "$(b test -f "$KEYBOARD_ON")"
  printf '{"id":"notifications","on":%s,"fallback":"`notifications off`, a failed stage, or revert point the view back at LG'"'"'s file"},' "$(b test -f "$NOTI_ON")"
  printf '{"id":"logos","on":%s,"fallback":"`logo off`; a logo that will not load answers tvpowerd at once"},' "$(b test -f "$LOGO_ON")"
  printf '{"id":"helper","on":%s,"fallback":"Home draws the last saved weather and news; `helper stop`"},' "$hp_on"
  printf '{"id":"preload","on":%s,"fallback":"`preload off` restores LG'"'"'s list from preload.orig"},' "$(b test -f "$PRELOAD_STATE")"
  printf '{"id":"compositor","on":%s,"fallback":"the supervisor falls back by itself; `compositor off`, revert, or hold Home"}' "$(b comp_live)"
  printf ']'
}

verb_surfaces() {
  printf '{"ok":true,"surfaces":%s}\n' "$(surfaces_json)"
  return 0
}

verb_status() {
  ensure_config
  version=$(get_version); [ -n "$version" ] || version="0.0.0"
  mounts=$(count_mounts)
  # Applied means both halves are in place: Home's assets bound, and a
  # starting compositor pointed at our module. Mount count alone stopped
  # being the answer when the compositor moved off a bind onto the import
  # path. "live" is whether the compositor running right now has it.
  if [ "$mounts" -gt 0 ] && env_live && [ -d "$SHADOW_ROOT" ]; then applied=true; else applied=false; fi
  if compositor_has_shadow; then live=true; else live=false; fi
  if [ -L "$AUTOSTART_LINK" ]; then persist=true; else persist=false; fi
  if early_hook_live; then early=true; else early=false; fi
  fps=$(cfg_get_bool fps); [ "$fps" = "true" ] && fps=true || fps=false
  ntfy_en=$(cfg_get_bool enabled); [ "$ntfy_en" = "true" ] && ntfy_en=true || ntfy_en=false
  ntfy_url_esc=$(json_escape "$(cfg_get_str url)")
  firmware_esc=$(json_escape "$(get_firmware)")
  model_esc=$(json_escape "$(get_model)")
  standby=$(standby_mode)
  homestub=$(homestub_json)
  helper=$(helper_json)
  compositor=$(comp_json)
  printf '{"ok":true,"version":"%s","applied":%s,"live":%s,"mounts":%s,"persist":%s,"early":%s,"standby":"%s","fps":%s,"ntfy":{"enabled":%s,"url":"%s"},"firmware":"%s","model":"%s","homestub":%s,"helper":%s,"compositor":%s}\n' \
    "$version" "$applied" "$live" "$mounts" "$persist" "$early" "$standby" "$fps" "$ntfy_en" "$ntfy_url_esc" "$firmware_esc" "$model_esc" "$homestub" "$helper" "$compositor"
  return 0
}

# --------------------------------------------------------- early boot hook

install_early_hook() {
  # PATH for kdump.service, plus the shim it will resolve `grep` to.
  mkdir -p "$EARLY_BIN" "$(dirname "$EARLY_ENV_FILE")" 2>/dev/null || return 1
  {
    printf '%s\n' '#!/bin/sh'
    printf '%s\n' '# Early boot trigger, installed as a PATH shim in front of grep'
    printf '%s\n' '# for kdump.service only. It starts the apply ~19s earlier than Homebrew'
    printf '%s\n' "# Channel's init.d run-parts can, then behaves exactly like grep."
    printf '%s\n' '#'
    printf '%s\n' '# Absolute paths throughout: this shim is first on PATH, so a bare grep'
    printf '%s\n' '# here would re-enter it. Every path still ends in exec, so nothing here'
    printf '%s\n' '# can stop the unit that called it.'
    printf 'APPDIR=%s\n' "$APPDIR"
    printf 'STATE=%s\n' "$STATE"
    printf 'ONCE=%s\n' "$EARLY_ONCE"
    cat <<'SHIM'
if [ ! -e "$ONCE" ]; then
  : > "$ONCE" 2>/dev/null
  if /bin/grep -q '"persist"[[:space:]]*:[[:space:]]*true' "$STATE/config.json" 2>/dev/null; then
    if [ -x "$APPDIR/tools/autostart.sh" ]; then
      PATH=/usr/sbin:/usr/bin:/sbin:/bin \
        /usr/bin/setsid "$APPDIR/tools/autostart.sh" --worker </dev/null >/dev/null 2>&1 &
    fi
  fi
fi
exec /bin/grep "$@"
SHIM
  } > "$EARLY_SHIM.tmp.$$" || return 1
  chmod 0755 "$EARLY_SHIM.tmp.$$" 2>/dev/null
  mv -f "$EARLY_SHIM.tmp.$$" "$EARLY_SHIM" 2>/dev/null || return 1
  printf 'PATH=%s:/usr/sbin:/usr/bin:/sbin:/bin\n' "$EARLY_BIN" > "$EARLY_ENV_FILE.tmp.$$" || return 1
  mv -f "$EARLY_ENV_FILE.tmp.$$" "$EARLY_ENV_FILE" 2>/dev/null || return 1
  sync
  return 0
}

remove_early_hook() {
  rm -f "$EARLY_ENV_FILE" "$EARLY_ENV_FILE.tmp."* 2>/dev/null
  rm -rf "$EARLY_BIN" 2>/dev/null
  return 0
}

early_hook_live() {
  [ -f "$EARLY_ENV_FILE" ] && [ -x "$EARLY_SHIM" ] \
    && grep -qF "$EARLY_BIN" "$EARLY_ENV_FILE" 2>/dev/null
}

# ------------------------------------------------------------------ persist

persist_enable() {
  mkdir -p "$(dirname "$AUTOSTART_LINK")" 2>/dev/null
  rm -f "$AUTOSTART_LINK" 2>/dev/null
  ln -s "$AUTOSTART_SRC" "$AUTOSTART_LINK" 2>/dev/null || return 1
  set_cfg_bool persist true
  # The init.d symlink is the safety net; the early hook is what makes a
  # boot fast. Its absence is not fatal - the late hook still applies.
  if ! install_early_hook; then
    log_line "persist: early hook could not be installed, late hook only"
  fi
  return 0
}

verb_persist() {
  action="${1:-}"
  case "$action" in
    on)
      if ! persist_enable; then
        emit_error "failed to create persist symlink"
        return 1
      fi
      ;;
    off)
      rm -f "$AUTOSTART_LINK" 2>/dev/null
      remove_early_hook
      rm -f "$COMP/enabled" 2>/dev/null
      set_cfg_bool persist false
      ;;
    *)
      emit_error "persist requires on or off"
      return 1
      ;;
  esac
  if [ -L "$AUTOSTART_LINK" ]; then real=true; else real=false; fi
  log_line "persist: set to $action (symlink=$real)"
  printf '{"ok":true,"persist":%s}\n' "$real"
  return 0
}

# ------------------------------------------------------- previous-brand move
#
# The mod used to ship as LumaGlass: app org.nphil.lumaglass, data in
# /var/lib/lumaglass, boot hook 50-lumaglass. These are the only places that
# still name it. On the first verb of the new tool, migrate_legacy moves what
# the old one left on the set and takes the old apps off, so a set that only
# has the old layout can be applied, reverted or switched off by this tool.
LEGACY_STATE=/var/lib/lumaglass
LEGACY_APP=org.nphil.lumaglass
LEGACY_FRAME_APP=org.nphil.lumaglass.frame
LEGACY_AUTOSTART_LINK=/var/lib/webosbrew/init.d/50-lumaglass
LEGACY_KEYFILTER=lumaglass.js
LEGACY_CSS=lumaglass.css
# Present in the new data dir from the move until every step below has run, so
# a power cut or a failed step is picked up again by the next verb.
MIGRATING="$STATE/.migrating"

rewrite_legacy_paths() {
  # $1 = file. Points every mention of the old data dir at the new one; the
  # file is replaced in one rename so a reader never sees a half-written line.
  [ -f "$1" ] || return 0
  grep -qF "$LEGACY_STATE" "$1" 2>/dev/null || return 0
  sed "s#$LEGACY_STATE#$STATE#g" "$1" > "$1.tmp.$$" && mv -f "$1.tmp.$$" "$1"
}

remove_legacy_app() {
  # $1 = app id. Removed through appInstallService, the way it was installed,
  # never by deleting its directory; done means the directory is gone.
  dir="$(dirname "$APPDIR")/$1"
  [ "$dir" != "$APPDIR" ] && [ -d "$dir" ] || return 0
  luna-send -n 3 -f luna://com.webos.appInstallService/dev/remove "{\"id\":\"$1\",\"subscribe\":true}" >/dev/null 2>&1 &
  lpid=$!
  w=0
  while [ -d "$dir" ] && [ "$w" -lt 30 ]; do sleep 1; w=$((w+1)); done
  kill "$lpid" 2>/dev/null
  if [ -d "$dir" ]; then
    log_line "migrate: $1 is still installed after 30s"
  else
    log_line "migrate: removed app $1"
  fi
  return 0
}

migrate_legacy() {
  # Returns 1 only when the data could not be moved; every later step is
  # logged and skipped on failure, because the data is already in place and
  # apply puts the rest right.
  if [ -f "$MIGRATING" ]; then
    from="$STATE"
  elif [ "$LEGACY_STATE" != "$STATE" ] && [ -d "$LEGACY_STATE" ] && [ ! -L "$LEGACY_STATE" ] && [ ! -e "$STATE" ]; then
    from="$LEGACY_STATE"
  else
    return 0
  fi

  # The overlay mounts over the settings apps name the old data dir as their
  # upper layer. Unmounted before the move and mounted again after it.
  [ -f "$from/.webglass-on" ] && webglass_set off

  if [ "$from" = "$LEGACY_STATE" ]; then
    # Wait out an apply or revert of the old tool, and keep new ones out, for
    # as long as the move takes. Nothing is logged yet: log_line would create
    # the new data dir and the move would then never happen.
    exec 8>"$LEGACY_STATE/mutate.lock" 2>/dev/null
    if ! flock -x -w "$LOCK_WAIT" 8 2>/dev/null; then
      exec 8>&-
      printf '%s migrate: old tool still running, not moved\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" >> "$LEGACY_STATE/log" 2>/dev/null
      return 1
    fi
    : > "$LEGACY_STATE/.migrating"
    if ! mv "$LEGACY_STATE" "$STATE" 2>/dev/null; then
      rm -f "$LEGACY_STATE/.migrating"
      exec 8>&-
      printf '%s migrate: could not move to %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" "$STATE" >> "$LEGACY_STATE/log" 2>/dev/null
      return 1
    fi
    exec 8>&-
  fi
  log_line "migrate: data now in $STATE"

  # Everything derived from the old names is rebuilt by apply: the staged QML
  # directory, the key-filter copy, the settings-app stylesheet copy and the
  # patched Quick Settings tree (its marker comment changed with the name).
  rm -rf "$LUMA_STAGE" "$LUMA_STAGE.next" "$SYSTEMUI_STAGE" 2>/dev/null
  rm -f "$KEYFILTER_DIR/$LEGACY_KEYFILTER" "$VERIFIED" 2>/dev/null
  for f in "$WEBGLASS_STAGE"/*/upper/webOSUserScripts/"$LEGACY_CSS"; do
    [ -e "$f" ] && rm -f "$f"
  done

  # The compositor's env file and the early-boot env file hold the old data
  # dir; the early-boot shim holds it and the old app dir in its body, so it
  # is written again rather than patched.
  rewrite_legacy_paths "$ENV_FILE"
  rewrite_legacy_paths "$EARLY_ENV_FILE"
  if [ -x "$EARLY_SHIM" ]; then
    install_early_hook || log_line "migrate: early boot hook could not be rewritten"
  fi

  # The init.d link points into the old app, which goes below.
  rm -f "$LEGACY_AUTOSTART_LINK" 2>/dev/null
  if [ "$(cfg_get_bool persist)" = true ]; then
    persist_enable || log_line "migrate: boot hook could not be re-created"
  fi

  # configd still holds the old data dir in the key filter's path and in the
  # Quick Settings entry.
  if [ -f "$ENV_FILE" ]; then
    keyfilter_set add || log_line "migrate: could not register the key filter with configd"
  fi
  [ -f "$SYSTEMUI_ON" ] && { systemui_set on || log_line "migrate: could not point Quick Settings at the staged tree"; }
  [ -f "$WEBGLASS_ON" ] && { webglass_set on || log_line "migrate: could not mount the settings-app stylesheet"; }

  remove_legacy_app "$LEGACY_FRAME_APP"
  remove_legacy_app "$LEGACY_APP"
  rm -f "$MIGRATING"
  log_line "migrate: done"
  return 0
}

# ---------------------------------------------------------------------- fps

verb_fps() {
  action="${1:-}"
  case "$action" in
    on) val=true ;;
    off) val=false ;;
    *) emit_error "fps requires on or off"; return 1 ;;
  esac
  set_cfg_bool fps "$val"
  # The overlay is a property in the staged QML, so flipping it is a re-apply:
  # apply sees the staged set change, rebinds once per distinct target, takes
  # the mutation lock, and runs the shader verification. The old inline
  # version bound both QML paths - the same inode - and stacked two mounts.
  if [ "$(count_mounts)" -gt 0 ]; then
    if ! verb_apply >/dev/null; then
      emit_error "fps set, but re-apply failed; see log"
      return 1
    fi
  fi
  log_line "fps: set to $val"
  printf '{"ok":true,"fps":%s}\n' "$val"
  return 0
}

# ------------------------------------------------------------------ restart

verb_restart() {
  # The restart apply performs when the compositor must reread its QML, without a stage change:
  # the QML cache is kept, so this is the start every boot after the first sees. Used to time
  # startup (docs/research/perf/startup.py).
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  if ! restart_surface; then
    emit_error "compositor did not become active after restart"
    return 1
  fi
  home_back_after_restart
  log_line "restart: compositor restarted"
  printf '{"ok":true}\n'
  return 0
}

# ------------------------------------------------------------------ standby

SETTINGS_GET_URI="luna://com.webos.settingsservice/getSystemSettings"
SETTINGS_SET_URI="luna://com.webos.settingsservice/setSystemSettings"

get_option_setting() {
  # $1 = key in the "option" category. Prints the value, or nothing.
  luna-send -n 1 "$SETTINGS_GET_URI" "{\"category\":\"option\",\"keys\":[\"$1\"]}" 2>/dev/null \
    | tr -d '\n' | sed -n "s/.*\"$1\"[ ]*:[ ]*\"\\([^\"]*\\)\".*/\\1/p"
}

set_option_setting() {
  # $1 = key, $2 = value. The set's own settings service, so the change is
  # what the TV's menus would have done and it persists the same way.
  luna-send -n 1 "$SETTINGS_SET_URI" \
    "{\"category\":\"option\",\"settings\":{\"$1\":\"$2\"}}" 2>/dev/null \
    | tr -d '\n' | grep -q '"returnValue"[ ]*:[ ]*true'
}

standby_mode() {
  # What the set will do at the next power-off, read from the live settings
  # rather than from anything stored here. "warm": stays in active standby
  # with RAM alive and powers on instantly with the mod still up. "cold":
  # powers fully down and every power-on is a boot. "system": Quick Start+
  # is on but SDDP is still enabled - the stock state, which on a set with a
  # VPN tun interface means webos-sddp crashes on the next network change and
  # the power-off after that reboots.
  qs=$(get_option_setting quickStartMode)
  sddp=$(get_option_setting enableSDDP)
  if [ "$qs" != "on" ]; then
    printf 'cold\n'
  elif [ "$sddp" = "off" ]; then
    printf 'warm\n'
  else
    printf 'system\n'
  fi
}

verb_standby() {
  # Two things decide whether a power-off leaves the set warm: Quick Start+
  # (LG's own "keep it in RAM" mode) and the absence of a crash report when
  # faultmanager looks. The report this mod's own restart produces is always
  # swept. The other one seen is webos-sddp (Control4 discovery), which
  # segfaults in SDDPSetDevice whenever it reads the interface list and finds
  # a point-to-point interface with the multicast flag - a Tailscale tun on
  # the reference set; proven by stopping tailscaled, after which it runs. A
  # stock set has no such interface. It is handled by not starting it, through
  # the set's own enableSDDP setting; the previous value is kept so "cold"
  # restores it.
  action="${1:-}"
  cfg_read_all
  case "$action" in
    warm)
      if [ -z "$CFG_SDDP_PREV" ]; then
        prev=$(get_option_setting enableSDDP); [ -n "$prev" ] || prev=on
        set_cfg_sddp_prev "$prev"
      fi
      set_option_setting enableSDDP off || { emit_error "could not turn off enableSDDP"; return 1; }
      set_option_setting quickStartMode on || { emit_error "could not turn on quickStartMode"; return 1; }
      ;;
    cold)
      set_option_setting quickStartMode off || { emit_error "could not turn off quickStartMode"; return 1; }
      if [ -n "$CFG_SDDP_PREV" ]; then
        set_option_setting enableSDDP "$CFG_SDDP_PREV" || { emit_error "could not restore enableSDDP"; return 1; }
        set_cfg_sddp_prev ""
      fi
      ;;
    *)
      emit_error "standby requires warm or cold"
      return 1
      ;;
  esac
  mode=$(standby_mode)
  log_line "standby: set to $action (now $mode)"
  printf '{"ok":true,"standby":"%s"}\n' "$mode"
  return 0
}

# --------------------------------------------------------------------- ntfy

verb_ntfy() {
  action="${1:-}"
  case "$action" in
    set)
      url="${2:-}"
      case "$url" in
        http://*/*|https://*/*) : ;;
        *) emit_error "ntfy url must be http(s) with a topic path"; return 1 ;;
      esac
      set_cfg_ntfy_url "$url"
      set_cfg_bool enabled true
      log_line "ntfy: configured"
      ;;
    off)
      set_cfg_bool enabled false
      log_line "ntfy: disabled"
      ;;
    test)
      cfg_read_all
      if [ "$CFG_NTFY_ENABLED" != "true" ] || [ -z "$CFG_NTFY_URL" ]; then
        emit_error "ntfy is not configured"
        return 1
      fi
      if ! curl -fsS -m 10 -H "Title: $DISPLAY_NAME" -H 'Tags: tv' -d "$DISPLAY_NAME test notification" "$CFG_NTFY_URL" >/dev/null 2>&1; then
        log_line "ntfy: test delivery failed"
        emit_error "ntfy test failed to deliver"
        return 1
      fi
      log_line "ntfy: test delivered"
      ;;
    *)
      emit_error "ntfy requires set <url>, off, or test"
      return 1
      ;;
  esac
  cfg_read_all
  url_esc=$(json_escape "$CFG_NTFY_URL")
  printf '{"ok":true,"ntfy":{"enabled":%s,"url":"%s"}}\n' "$CFG_NTFY_ENABLED" "$url_esc"
  return 0
}

# ---------------------------------------------------------------------- log

verb_log() {
  n="${1:-}"
  case "$n" in ''|*[!0-9]*) n=20 ;; esac
  mkdir -p "$STATE" 2>/dev/null
  touch "$LOGFILE" 2>/dev/null
  out=""
  while IFS= read -r line || [ -n "$line" ]; do
    esc=$(json_escape "$line")
    if [ -z "$out" ]; then out="\"$esc\""; else out="$out,\"$esc\""; fi
  done <<LGEOF
$(tail -n "$n" "$LOGFILE" 2>/dev/null)
LGEOF
  printf '{"ok":true,"lines":[%s]}\n' "$out"
  return 0
}

# ------------------------------------------------------------------ version

verb_version() {
  v=$(get_version); [ -n "$v" ] || v="0.0.0"
  printf '{"ok":true,"version":"%s"}\n' "$v"
  return 0
}

# ------------------------------------------------------------------- dispatch

case "$VERB" in
  status|apply|boot-bind|boot-restart|boot-ok|revert|persist|fps|standby|ntfy|log|theme|systemui|webglass|inputcommon|keyboard|voice|homestub|homestub-boot|homestub-watch|helper|preload|logo|notifications|surfaces|compositor|compositor-boot)
    # Before ensure_config, which would create the new data dir and with it
    # hide the old one.
    if ! migrate_legacy; then
      emit_error "could not move the previous data dir to $STATE; see $LEGACY_STATE/log"
      exit 1
    fi
    ensure_config
    ;;
esac

install_frame_app() {
  # The frame app ships as an ipk inside the payload and is installed through the
  # developer install endpoint (the set is rooted, so it is reachable). Re-installed only
  # when the shipped version differs from the installed one; a failure is logged, never
  # fatal: Home works without it, the news mini app just cannot open.
  [ -f "$FRAME_IPK" ] || return 0
  shipped=$(ar p "$FRAME_IPK" control.tar.gz 2>/dev/null | tar -xzO control 2>/dev/null | sed -n 's/^Version: //p')
  installed=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAME_DIR/appinfo.json" 2>/dev/null)
  [ -n "$shipped" ] && [ "$shipped" = "$installed" ] && return 0
  cp -f "$FRAME_IPK" /tmp/$SHORT_ID-frame.ipk 2>/dev/null || return 0
  out=$(luna-send -n 3 -f luna://com.webos.appInstallService/dev/install "{\"id\":\"$FRAME_APP\",\"ipkUrl\":\"/tmp/$SHORT_ID-frame.ipk\",\"subscribe\":true}" 2>&1 | tr -d '\n')
  i=0; while [ "$i" -lt 20 ]; do
    [ "$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAME_DIR/appinfo.json" 2>/dev/null)" = "$shipped" ] && break
    sleep 1; i=$((i+1))
  done
  if [ "$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAME_DIR/appinfo.json" 2>/dev/null)" = "$shipped" ]; then
    log_line "frame app $shipped installed"
  else
    log_line "frame app install did not complete: $(printf '%s' "$out" | cut -c1-200)"
  fi
  rm -f /tmp/$SHORT_ID-frame.ipk
}

verb_theme() {
  # theme get | theme set '<json>': the companion app's and the Home popovers' way to edit
  # theme.json. The Home layer polls the file, so a set is live within 2 s and nothing
  # here restarts.
  [ -f "$THEME_DIR/theme.json" ] || stage_theme
  case "$1" in
    get) python3 "$THEME_TOOL" "$THEME_DIR/theme.json" get < /dev/null ;;
    set) [ -n "$2" ] || { emit_error "theme set needs a JSON object"; return 1; }
         python3 "$THEME_TOOL" "$THEME_DIR/theme.json" set "$2" < /dev/null || { emit_error "theme update failed"; return 1; }
         write_tokens_js || log_line "theme set: Tokens.js not rewritten" ;;
    *) emit_error "theme: get or set"; return 1 ;;
  esac
}

verb_layout() {
  # layout get | check '<json>' | put '<json>' | set '<json>' | reset: the owner's Home layout (layout.json), by the same rules as the
  # layout editor on Home (tools/layout.py). The Home layer polls the file, so a change is live within 2 s and nothing here restarts. No
  # copy of the file it replaces is kept: `layout reset` is the way back to the shipped layout, and `put` of the layout wanted any other.
  [ -f "$THEME_DIR/layout.json" ] || stage_theme
  case "$1" in
    get|reset) python3 "$LAYOUT_TOOL" "$THEME_DIR/layout.json" "$1" < /dev/null ;;
    check|put|set) [ -n "$2" ] || { emit_error "layout $1 needs a JSON object"; return 1; }
         python3 "$LAYOUT_TOOL" "$THEME_DIR/layout.json" "$1" "$2" --shipped "$THEME_SRC/layout.json" < /dev/null || return 1 ;;
    *) emit_error "layout: get, check, put, set or reset"; return 1 ;;
  esac
}

case "$VERB" in
  status) verb_status; exit $? ;;
  apply) verb_apply; exit $? ;;
  boot-bind) verb_boot_bind; exit $? ;;
  boot-restart) verb_boot_restart; exit $? ;;
  boot-ok) verb_boot_ok; exit $? ;;
  revert) verb_revert; exit $? ;;
  persist) verb_persist "${2:-}"; exit $? ;;
  fps) verb_fps "${2:-}"; exit $? ;;
  restart) verb_restart; exit $? ;;
  helper) verb_helper "${2:-status}"; exit $? ;;
  capture) verb_capture "${2:-status}"; exit $? ;;
  vplane) verb_vplane "${2:-status}"; exit $? ;;
  preload) verb_preload "${2:-status}"; exit $? ;;
  logo) verb_logo "${2:-status}"; exit $? ;;
  notifications) verb_notifications "${2:-status}"; exit $? ;;
  surfaces) verb_surfaces; exit $? ;;
  compositor) verb_compositor "${2:-status}"; exit $? ;;
  compositor-boot) verb_compositor_boot; exit $? ;;
  standby) verb_standby "${2:-}"; exit $? ;;
  ntfy) verb_ntfy "${2:-}" "${3:-}"; exit $? ;;
  log) verb_log "${2:-}"; exit $? ;;
  theme) verb_theme "${2:-get}" "${3:-}"; exit $? ;;
  layout) verb_layout "${2:-get}" "${3:-}"; exit $? ;;
  systemui) verb_systemui "${2:-status}"; exit $? ;;
  webglass) verb_webglass "${2:-status}"; exit $? ;;
  inputcommon) verb_inputcommon "${2:-status}"; exit $? ;;
  voice) verb_voice "${2:-status}"; exit $? ;;
  keyboard) verb_keyboard "${2:-status}"; exit $? ;;
  homestub) verb_homestub "${2:-status}"; exit $? ;;
  homestub-boot) verb_homestub_boot; exit $? ;;
  homestub-watch) verb_homestub_watch; exit $? ;;
  version) verb_version; exit $? ;;
  *) emit_error "unknown verb: $VERB"; exit 1 ;;
esac
