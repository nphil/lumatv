#!/bin/sh
# On-device engine (POSIX sh / busybox ash only). Names come from brand.json.
#
# Verb map (each verb prints exactly one JSON object on stdout, exit 0/nonzero):
#   status                 -> current measured state
#   apply                  -> stage the mod, point the compositor at it, relaunch Home
#   revert                 -> drop the env override, unbind, restore icons, back to stock
#   persist on|off         -> toggle the boot-hook symlink in webosbrew init.d
#   fps on|off             -> toggle the compositor FPS debug overlay
#   restart                -> restart the compositor and bring Home back (what apply does when it must)
#   boot-restart           -> the boot hook's early compositor restart, right after boot-bind; lands on Home, or on the input
#                            bootd opened when the TV is set to start on its last input (general.homeAutoLaunch off)
#   helper start|stop|status -> the native helper daemon (weather, news, receiver, settings API)
#   capture start|stop|remove|status -> the ambient light's colour reader and its bus role (payload/capture/capture.sh)
#   vplane install|start|stop|remove|status -> the art saver's video-plane player and its clips (payload/vplane/vplane.sh); `install`
#                            writes an LS2 role, so it is the owner's own command and apply never runs it; apply starts a player
#                            that is installed, revert removes it
#   surfaces               -> the registry: every switch, whether it is on, and what puts LG's back
#   compositor on|off|status|check -> LumaTV's own compositor in place of LG's (tools/compositor.sh); `on` is the
#                            persistent enable and needs a firmware build on verified.list; `check` is what the
#                            boot hook would decide (flag, firmware hashes, bundle, supervisor, Home held), changing nothing
#   notifications on|off|status -> LG's toast, alert and PIN views in the Luma look, without their shadow layers
#   logo on|off|status     -> LumaTV's power-on and power-off logos in place of LG's (theme.json logo.on / logo.off: 1-3)
#   preload on|off|status  -> keep only Netflix warm in the background (payload/preload.json)
#   standby warm|cold      -> Quick Start+ on with webos-sddp off, or fully off
#   ntfy set <url>|off|test -> configure/test ntfy.sh notifications
#   log [n]                -> last n log lines (default 20)
#   systemui on|off|status -> Quick Settings from our staged QML tree, or stock
#   webglass on|off|status -> glass stylesheet in the settings web apps
#   inputcommon on|off|status -> LG's input banners (com.webos.app.inputcommon) in the Lucent look: a patched copy of its QML
#                            mounted over LG's (tools/inputcommon.sh); off by default, re-mounted by apply at every boot while on
#   voice on|off|status    -> LG's Search app (com.webos.app.voice) in the Lucent look: a patched copy of its QML mounted over
#                            LG's (tools/voice.sh); off by default, re-mounted by apply at every boot while on
#   keyboard on|off|status -> the on-screen keyboard's window in the theme's layer motion (shadow module, tools/keyboard_patch.py);
#                            off by default; a change is one rebuild and, under LG's compositor, one restart
#   homestub on|off|confirm|status -> LumaHome as the only Home: a stub in LG's Home's place
#   version                -> version string from appinfo.json
#
# Nothing is ever written outside $APPDIR, $STATE (the brand's dataDir), the
# init.d boot-hook link, the env files under /var/systemd/system/env, configd,
# bind mounts, /tmp, and the compositor's QML cache, which is only ever
# deleted. The one-time move from the previous brand's layout (migrate_legacy)
# touches the same places plus the old data dir and, through appInstallService,
# the old apps.

set -u

APPDIR=$(cd "$(dirname "$0")/.." && pwd)
# A failed `.` aborts a non-interactive sh, so the file is checked first.
if [ ! -f "$APPDIR/tools/brand.sh" ]; then
  printf '{"ok":false,"error":"tools/brand.sh is missing"}\n'
  exit 1
fi
. "$APPDIR/tools/brand.sh"
brand_load "$APPDIR/brand.json" 2>/dev/null || {
  printf '{"ok":false,"error":"brand.json is missing or invalid"}\n'
  exit 1
}
DISPLAY_NAME="$BRAND_DISPLAY_NAME"
SHORT_ID="$BRAND_SHORT_ID"
APP_ID="$BRAND_APP_ID"
QML_MODULE="$BRAND_QML_MODULE"
STATE="$BRAND_DATA_DIR"
CONFIG="$STATE/config.json"
LOGFILE="$STATE/log"
ASSETS="$STATE/assets"
BACKUP="$STATE/backup"
STAMP="$STATE/.built-stamp"
COMPOSITOR_STAGE="$STATE/compositor.qml"
WALLPAPER_STAGE="$STATE/wall_1080.png"
# Written by the last full apply that passed verification: a hash of the staged
# set. boot-bind only fast-binds a set that carries this stamp.
VERIFIED="$STATE/.verified"
# Epoch at which the current staged content became live. Survives a re-apply
# that changes nothing, so the compositor can be judged against the real time
# the content it read was bound, not the time of the latest no-op apply.
BOUND_AT="$STATE/.bound-at"
# Present from boot-bind until the boot's apply reports ok. Found at the next
# boot, it means the previous one never completed, and the fast path is skipped
# once - the same shape as Homebrew Channel's own failsafe.
BOOT_PENDING="$STATE/.boot-pending"

APPINFO="$APPDIR/appinfo.json"
QML_SRC="$APPDIR/payload/compositor/StarfishFullscreenContainer.qml"
HOME_XML_SRC="$APPDIR/payload/home/home.xml"
EN_SED_SRC="$APPDIR/payload/home/en.json.sed"
WALL_SRC="$APPDIR/payload/wallpaper/wall_1080.png"
BG_HD_SRC="$APPDIR/payload/wallpaper/bg_hd.png"
BG_2K_SRC="$APPDIR/payload/wallpaper/bg_2k.png"
BG_4K_SRC="$APPDIR/payload/wallpaper/bg_4k.png"
# The compositor-drawn Home: a QML directory swapped into the shadow module
# beside the container, a key-filter script registered with configd that hands
# it the remote, and the theme it reads at runtime. Fonts and theme live
# outside the module so the companion app can change them without a module
# rebuild.
LUMA_SRC="$APPDIR/payload/compositor/$QML_MODULE"
FONTS_SRC="$APPDIR/payload/fonts"
THEME_SRC="$APPDIR/payload/theme"
KEYFILTER_SRC="$APPDIR/payload/keyfilter/$SHORT_ID.js"
KEYFILTER_TOOL="$APPDIR/tools/keyfilter.py"
THEME_TOOL="$APPDIR/tools/theme.py"
LAYOUT_TOOL="$APPDIR/tools/layout.py"
FRAME_APP="$APP_ID.frame"
FRAME_IPK="$APPDIR/payload/frame/$FRAME_APP.ipk"
FRAME_DIR="/media/developer/apps/usr/palm/applications/$FRAME_APP"
LUMA_STAGE="$STATE/luma"
FONTS_DIR="$STATE/fonts"
THEME_DIR="$STATE/theme"
KEYFILTER_DIR="$STATE/keyfilter"
KEYFILTER_HANDLER=handleLumaHome

# The native helper (helper/): a static aarch64 daemon on 127.0.0.1:18731 that holds weather and news,
# the receiver and the settings store for the compositor's QML. An ipk update cannot overwrite a
# running executable (text busy), so the shipped copy is staged under $STATE/bin and swapped when
# it differs; the daemon is stopped for the swap and started again.
# LG's background preloads. Only Netflix and the Home stub stay on the list: the tool switches every
# other app in payload/preload.json off in configd and in the live preload manager (YouTube, LG Channels,
# the browser and Prime Video are 170-230 MB together; LG's Live TV, voice and HDMI input apps 30-40 MB
# each, loaded at any switch-on with room to spare). $PRELOAD_STATE names them for the helper, which
# sends the live policy again at every screen-on (webOS 10 forgets it at each switch-on, and the
# preload manager only answers setPreloadPolicy while the screen is on: in Active Standby the call
# stays pending for 10 s per app, so `preload on` skips the live calls while the screen is off and the helper's
# next screen-on applies them: the 14 held calls were 140 s of a boot apply in standby).
# $PRELOAD_ORIG is LG's list as found, so `off` and `revert` put it back.
PRELOAD_TOOL="$APPDIR/tools/preload.py"
PRELOAD_SRC="$APPDIR/payload/preload.json"
PRELOAD_STATE="$STATE/preload.json"
PRELOAD_ORIG="$STATE/preload.orig"
HELPER_SRC="$APPDIR/payload/helper/lumatv-helper"
HELPER_BIN="$STATE/bin/lumatv-helper"
# The ambient light's colour reader (ambient/capture/service.c): a 32-bit service that reads LG's histogram and hands the
# areas' colours to the helper over $CAPTURE_SOCKET (which exists only while a picture is wanted). It needs an LS2 role for its
# executable, written with the package and removed with it (payload/capture/capture.sh).
CAPTURE_SH="$APPDIR/payload/capture/capture.sh"
CAPTURE_SRC="$APPDIR/payload/capture/lumatv-capture"
CAPTURE_ROLE="$APPDIR/payload/capture/role.json"
CAPTURE_SOCKET="$STATE/ambient.sock"
# The picture decoder (jpeg/service.c), started by the helper from $JPEG_BIN, where `jpeg_stage` puts it.
JPEG_SRC="$APPDIR/payload/jpeg/lumatv-jpeg"
JPEG_BIN="$STATE/bin/lumatv-jpeg"
# The art saver's video-plane player (vplane/, payload/vplane/vplane.sh): a 32-bit program that puts the saver's clips on the video
# plane; the saver asks it for a picture through $VPLANE_MAILBOX. Its LS2 role is a permission for a new program, so only the owner's
# `lumatv vplane install` writes it. Apply starts a player that is installed, and revert removes it with the role.
VPLANE_SH="$APPDIR/payload/vplane/vplane.sh"
VPLANE_SRC="$APPDIR/payload/vplane/lumatv-vplane"
VPLANE_ROLE="$APPDIR/payload/vplane/role.json"
VPLANE_CLIPS="$APPDIR/payload/vplane/clips"
VPLANE_MAILBOX="/tmp/$SHORT_ID-vplane"
VPLANE_APPID="$APP_ID.vplane"

# Quick Settings, drawn by the compositor from a QML tree in /usr that configd
# names per app id. The stock tree is copied to /var once, our replacement
# files are laid over the copy, and configd is pointed at it - so /usr keeps
# its lowerdir-only overlay untouched and `systemui off` is one configd write.
SYSTEMUI_SRC="$APPDIR/payload/systemui"
SYSTEMUI_TOOL="$APPDIR/tools/systemui.py"
SYSTEMUI_PATCH_TOOL="$APPDIR/tools/systemui_patch.py"
TOKENS_TOOL="$APPDIR/tools/tokens.py"
SYSTEMUI_STAGE="$STATE/systemui"
QS_APP=com.webos.app.quicksettings
QS_STOCK=/usr/lib/qt5/qml/QuickSettings
QS_STAGE="$SYSTEMUI_STAGE/QuickSettings"
QS_MAIN="$QS_STAGE/QuickSettings.qml"
# Fingerprint of the stock tree the staged copy was built from; a firmware
# update changes it and forces a rebuild rather than feeding old QML to new
# libraries.
QS_STOCK_FP="$SYSTEMUI_STAGE/.stock-fp"
# Set while the menus are ours, so apply can put them back after a reboot (the
# overlay mounts do not survive one) or after a firmware update (which replaces
# the tree the staged copy was built from).
SYSTEMUI_ON="$STATE/.systemui-on"

# The power-on and power-off logos: two small system-UI windows (payload/systemui/BootLogo and
# MasterBrand) that stand in for LG's, redirected through the same configd entry as Quick Settings.
# They need no copy of LG's tree, only the logo components that LumaHome's module already carries
# ($SHADOW_ROOT/WebOSCompositor/$QML_MODULE/logo), and answer tvpowerd by themselves if those
# are missing, so a redirect never holds a power-off.
LOGO_ON="$STATE/.logo-on"

# The notification view (toasts, alerts, input popups, the PIN prompt) is one item the compositor
# loads from the file named for the view `notificationView`. A copy of LG's tree is patched
# (tools/notification_patch.py: Manrope, the toast's colours, no DropShadow layers) and the view
# is pointed at it through `sysuicompmgr/changeSystemUIView`, which LG persists in
# /var/preferences and answers with an error code when the file is not there. The data layer and
# the item contract are LG's, so a notification of any kind arrives as LG's code expects. Revert
# and a failed stage point the view back at LG's file, since a persisted path to a file that is
# gone would leave the next boot with no notifications at all.
NOTI_STOCK=/usr/lib/qt5/qml/SystemUI/Notification
NOTI_STAGE="$SYSTEMUI_STAGE/SystemUI/Notification"
NOTI_ON="$STATE/.notifications-on"
NOTI_PATCH_TOOL="$APPDIR/tools/notification_patch.py"
NOTI_OVERLAY="$APPDIR/payload/notification"
NOTI_VIEW_URI="luna://com.webos.service.sysuicompmgr/changeSystemUIView"
NOTI_PERSIST=/var/preferences/starfish-luna-surface-manager/systemUiViews.json
LOGO_BOOT_APP=com.webos.app.bootlogo
LOGO_OFF_APP=com.webos.app.masterbrand

# The web-app settings surfaces. Their UI is Enact/Sandstone drawn as a
# transparent overlay, so a stylesheet is all it takes; the mount that delivers
# it is described in webglass_set.
WEBGLASS_SRC="$APPDIR/payload/webapps"
WEBGLASS_STAGE="$STATE/webapps"
WEBGLASS_ON="$STATE/.webglass-on"

# LG's input banners (com.webos.app.inputcommon) in the Luma look: tools/inputcommon.sh stages a patched copy of the app's QML and
# mounts it over LG's directory. A mount does not survive a reboot, so apply asserts it again while the switch is on, as it does
# for webglass.
INPUTCOMMON_TOOL="$APPDIR/tools/inputcommon.sh"
INPUTCOMMON_ON="$STATE/.inputcommon-on"
# LG's Search app (com.webos.app.voice): the same overlay mount, by tools/voice.sh (it runs tools/inputcommon.sh for the other tree).
VOICE_TOOL="$APPDIR/tools/voice.sh"
VOICE_ON="$STATE/.voice-on"
# The on-screen keyboard's window in the theme's layer motion instead of LG's 600 ms jelly: the shadow module's copy of
# views/StarfishKeyboardView.qml is patched when the module is built. It matters only while LG's compositor is the live one. Off by
# default like every other restyle of an LG process: `keyboard on` leaves the flag that build_shadow reads and the rebuild makes the patch.
KEYBOARD_TOOL="$APPDIR/tools/keyboard_patch.py"
KEYBOARD_ON="$STATE/.keyboard-on"
# What build_shadow's patches are made of: each patch script, the modules it imports and the files it reads. shadow_patch_fp
# fingerprints them, so that an update that changes only one of them (a patch, or the theme's motion) rebuilds the shadow and
# restarts the compositor once; without it a set that already has a shadow keeps the old one. A patch added to build_shadow
# appends its files to this list on the line after it is defined (tests/test_lumatv_inputcommon.py fails when one is missing).
SHADOW_PATCH_FILES="$KEYBOARD_TOOL $NOTI_PATCH_TOOL $TOKENS_TOOL $THEME_SRC/theme.json"
# LG's own volume and mute popup, the shadow module's copy of views/StarfishVolumeView.qml, is never available there (tools/volume_patch.py):
# LumaTV's display (panels/VolumeOsd.qml, in the overlay layer) is the only one, over Home, every app and every input. LG's popup is back whenever
# that module is not the one loaded (`revert`, a stock compositor); nothing persistent is written to configd.
VOLUME_TOOL="$APPDIR/tools/volume_patch.py"
SHADOW_PATCH_FILES="$SHADOW_PATCH_FILES $VOLUME_TOOL"

# The compositor resolves QML modules through QML2_IMPORT_PATH, and its unit
# reads an optional environment file from /var - which is writable and
# persistent. So instead of bind-mounting our QML over the read-only module in
# /usr, we keep a full shadow copy of the WebOSCompositor module with our file
# swapped in, and point the import path at it. Nothing of ours is mounted over
# /usr, which is an overlay with lowerdir only and can never be written.
#
# The compositor's first start can never load the modded QML, and the reason
# is not the import path but the filesystem: until
# mount-readwrite.service (12.96s measured) relocates it, /var does not show
# the writable ext4 subtree at all, so /var/systemd/system/env is simply not
# a path that exists yet. surface-manager-daemon starts at 2.63s, its
# EnvironmentFile is optional, and the read is therefore a silent no-op - the
# file's atime is untouched across a boot, and LG's own env files for
# ls-hubd, configd, memchute, tvpowerd, bootd and sam are equally inert that
# early. Every restart after ~13s picks the file up reliably.
#
# So one compositor restart per boot is structural, not a bug to be fixed:
# apply forces it whenever the running compositor lacks the shadow. What can
# be bought is when it happens - see the early boot hook below.
#
# A compositor restart is not just a visible flash. It makes LG's igallery
# preview segfault in QFontDatabase::removeAllApplicationFonts (reproducible
# on stock firmware with no mod present), faultmanager records the crash with
# recovery rebootToSuspend, and tvpowerd then answers the next power-off with
# a full reboot into standby instead of switching off. Since the restart has
# not been eliminated, what keeps power-off immediate is restart_surface
# removing the crash reports its own restart produced.
STOCK_QML_MODULE=/usr/lib/qt5/qml/WebOSCompositor
MODULE_RELPATH=views/fullscreen/StarfishFullscreenContainer.qml
SHADOW_ROOT="$STATE/qml"
SHADOW_MODULE="$SHADOW_ROOT/WebOSCompositor"
SHADOW_QML="$SHADOW_MODULE/$MODULE_RELPATH"
# Fingerprint of the stock module the shadow was built from. A firmware update
# replaces the stock module; a shadow built from the old one would then feed
# stale QML to new libraries, so the hook rebuilds whenever this stops
# matching, and falls back to stock if it cannot.
SHADOW_STOCK_FP="$STATE/.shadow-stock"
# Fingerprint of the shadow tree itself, recorded once it is fully built.
# /var is ext4 data=ordered: directory entries are journalled, file contents
# are not. A power cut between renaming the shadow into place and its data
# reaching disk leaves a module with every file present and most of them
# truncated - 318 files holding 212KB instead of 2030741 bytes, observed. The
# compositor then starts on it, resolves nothing and presents a black screen,
# so integrity has to be checked against this, not just the one file we inject.
SHADOW_SELF_FP="$STATE/.shadow-self"
# Fingerprint of SHADOW_PATCH_FILES as of the build: a shadow built from other patches, or before there was one, is not current.
SHADOW_PATCH_FP="$STATE/.shadow-patch"
ENV_DIR=/var/systemd/system/env
ENV_FILE="$ENV_DIR/surface-manager.env"
# Extra compositor variables for tuning and measurement, one KEY=VALUE per
# line (QT_QPA_UPDATE_IDLE_TIME=0, QSG_RENDER_LOOP=threaded, ...). env_line
# copies only lines whose key is allowlisted and whose value is plain, so a
# typo can reach neither systemd's parser nor the compositor. A change to it
# restarts the compositor at the next apply; revert deletes it, and so does
# the boot fail-safe, so an experiment cannot outlive a compositor that
# failed to start with it.
ENV_EXTRA="$STATE/env.extra"
ENV_EXTRA_KEYS='QT_QPA_UPDATE_IDLE_TIME|QML_FORCE_DISK_CACHE|QSG_[A-Z0-9_]+|QV4_[A-Z0-9_]+'
# LG starts the compositor with QML_DISABLE_DISK_CACHE=1; QML_FORCE_DISK_CACHE=1
# in our env file overrides it and cut restart-to-Home from 5.8 s to
# 4.6-5.2 s. Qt validates each cached unit against its source, but the cache
# is cleared whenever the staged compositor set changes, and at revert, so it
# never outlives the tree it was compiled from. 6.2 MB when full.
# Qt's platform plugin waits a fixed 5 ms (QT_QPA_UPDATE_IDLE_TIME) before
# every update request, which pushes animated frames past the vblank. 0 cut
# dropped frames on the set from 8-9 % to 3.4-4 % on a D-pad sweep and from
# 46-67 % to 2.5-4 % opening Quick Settings (2026-10-24).
QML_CACHE_DIR=/home/root/.cache/surface-manager/qmlcache
STOCK_ASSETS=/usr/palm/applications/com.webos.app.home/data/flutter_assets/assets

HOME_PKILL_PATTERN="flutter-client -i com.webos.app.home"
HOME_LAUNCH_URI="luna://com.webos.applicationManager/launch"
HOME_LAUNCH_PARAMS='{"id":"com.webos.app.home"}'

# LG's Home retired behind a stub (see "Home stub" below). The stub is a web app
# with LG's Home's id and category, bound over LG's app directory; the Home
# assets bind stays where it is, under it.
HOME_APP_ID=com.webos.app.home
HOME_APP_DIR=/usr/palm/applications/$HOME_APP_ID
STUB_SRC="$APPDIR/payload/homestub"
STUB_STAGE="$STATE/homestub"
# tmpfs, so a reboot clears every one of them. The first three are the contract
# with LumaHome (payload/compositor/lumatv): it rewrites the beat once a second,
# reads the mode, and the Home key's 650 ms hold writes the request.
HS_BEAT="/tmp/$SHORT_ID-beat"
HS_MODE="/tmp/$SHORT_ID-homemode"
HS_ESCAPE="/tmp/$SHORT_ID-escape"
HS_CONFIRM="/tmp/$SHORT_ID-confirm"
HS_TRIAL="/tmp/.$SHORT_ID-homestub-trial"
HS_SKIP="/tmp/.$SHORT_ID-homestub-skip"
HS_WD_PID="/tmp/.$SHORT_ID-homestub-guard"
HS_TICK="/tmp/.$SHORT_ID-homestub-tick"
# Persisted: faults in a row. Two and the switch turns itself off.
HS_STRIKES="$STATE/homestub.strikes"
HS_TRIAL_SECS=120
# A beat older than this is a fault, once the grace after a start or a
# compositor restart has passed (a restart needs ~12 s before LumaHome draws).
HS_STALE=5
HS_GRACE=30
HS_MAX_STRIKES=2
SURFACE_SVC=surface-manager-daemon.service
MSGLOG=/var/log/messages
# A compositor that reports active is not yet presenting. Every cheap signal -
# is-active, the Home process, getForegroundAppInfo, NL_HOME_SHOWN - goes true
# about 8s before anything reaches the panel, so readiness is taken from the
# panel itself: capture a small frame and look at how much PNG came back.
# Measured on webOS 10.2.1 at 320x180: 835 bytes while the panel is still
# blank, >79000 once Home is composited.
CAPTURE_URI="luna://com.webos.service.capture/executeOneShot"
CAP_TMP=/tmp/$SHORT_ID-ready.png
CAP_BLANK_BYTES=4096
READY_WAIT=30
# On the boot path, a set that still reports itself in standby after this many seconds without pixels
# is not going to present: the wait ends there instead of at READY_WAIT. Measured: the 16:34 restart
# from standby spent the whole 30 s here.
STANDBY_WAIT=5
WAM_SVC=webapp-mgr.service
WAM_WAIT=20
SCREEN_ON_URI="luna://com.webos.service.tvpower/power/turnOnScreen"
AUTOSTART_LINK="/var/lib/webosbrew/init.d/50-$SHORT_ID"
AUTOSTART_SRC="$APPDIR/tools/autostart.sh"

# Early boot hook.
#
# Homebrew Channel's init.d run-parts is the obvious place to apply from, but
# it fires at ~33s, long after the panel is live, which is what made a boot
# show stock Home, blink, and only then the mod. The earliest a root
# customization can do anything useful is just after mount-readwrite.service
# (12.96s measured), because until then /var shows the firmware's near-empty
# var, not the writable one: that is also why the compositor's own
# EnvironmentFile cannot work at its first start (2.6s) - the file is simply
# not visible on that path yet, so systemd's optional read is a no-op.
#
# kdump.service is the hook: it starts at 14.27s, right inside that window, it
# reads an EnvironmentFile under /var so PATH can be set for it, and its
# script's first act is a bare `grep`. On a set without `crashkernel` on the
# kernel command line - this one - the script is a no-op that exits 0, and the
# unit is Restart=no, so shadowing one command in it costs nothing. The shim
# always exec's the real grep, so a broken shim cannot stop the unit.
EARLY_ENV_FILE=/var/systemd/system/env/kdump.env
EARLY_BIN="$STATE/earlybin"
EARLY_SHIM="$EARLY_BIN/grep"
EARLY_ONCE="/tmp/.$SHORT_ID-early-done"
LOCKFILE="$STATE/mutate.lock"

# LumaTV's own compositor (tools/compositor.sh): the bundle and its state files are under
# $COMP, put there by compositor/tools/tv-cutover.sh install.
COMP="$STATE/compositor"
if [ -f "$APPDIR/tools/compositor.sh" ]; then . "$APPDIR/tools/compositor.sh"; fi
# Seconds a second mutation waits for the first to finish. An apply takes ~30s
# at worst, so this is generous without hanging a caller forever.
LOCK_WAIT=180

VERB="${1:-}"

# ---------------------------------------------------------------- utilities

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n\r\t' '   '
}

emit_error() {
  msg=$(json_escape "$1")
  printf '{"ok":false,"error":"%s"}\n' "$msg"
}

mtime_epoch() {
  date -r "$1" +%s 2>/dev/null || echo 0
}

log_line() {
  mkdir -p "$STATE" 2>/dev/null
  ts=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
  msg=$(printf '%s' "$1" | tr '\n' ' ')
  printf '%s %s\n' "$ts" "$msg" >> "$LOGFILE" 2>/dev/null
  if [ -f "$LOGFILE" ]; then
    lc=$(wc -l < "$LOGFILE" 2>/dev/null | tr -d ' ')
    [ -n "$lc" ] || lc=0
    if [ "$lc" -gt 200 ] 2>/dev/null; then
      tail -n 200 "$LOGFILE" > "$LOGFILE.trim.$$" 2>/dev/null && mv "$LOGFILE.trim.$$" "$LOGFILE"
    fi
  fi
}

# ------------------------------------------------------------- mount helpers

is_mounted() {
  # $1 = exact absolute target path. Matches only the literal bind target,
  # never the dozens of per-app jail mirrors webOS maintains at paths like
  # /mnt/lg/*/var/palm/jail/<app>/usr/lib/qml/... which also contain the
  # same suffix and would otherwise inflate the count.
  mount 2>/dev/null | grep -qF -- " on $1 type "
}

count_mounts() {
  # Only Home's assets are bound now; the compositor QML arrives through the
  # import path, which is not a mount.
  n=0
  is_mounted "$STOCK_ASSETS" && n=$((n+1))
  echo "$n"
}

drain_umount() {
  while umount "$1" >/dev/null 2>&1; do :; done
}

# ------------------------------------------------------------- luna helpers

kill_home_app() {
  # Safe by construction: this exact pattern is the Home flutter client's own
  # process command line, never a substring of this script's own invocation.
  pkill -f "$HOME_PKILL_PATTERN" >/dev/null 2>&1
  return 0
}

home_running() {
  # Whether Home is running, by SAM's own list: it holds for LG's Flutter app and
  # for the stub alike. Home runs in its own namespace, where busybox `ps`
  # reports zero flutter-client processes while the app is demonstrably on
  # screen, and the stub is a WebAppMgr renderer with no process to look for.
  luna-send -n 1 luna://com.webos.applicationManager/running '{}' 2>/dev/null \
    | grep -q "\"id\":\"$HOME_APP_ID\""
}

home_in_front() {
  luna-send -n 1 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null \
    | grep -q '"appId":"com.webos.app.home"'
}

panel_presenting() {
  # Whether anything is actually on the panel, asked of the panel itself.
  b=$(luna-send -n 1 "$CAPTURE_URI" \
        "{\"path\":\"$CAP_TMP\",\"method\":\"DISPLAY\",\"format\":\"PNG\",\"width\":320,\"height\":180}" \
        2>/dev/null | tr ',' '\n' | grep writtenBytes | tr -dc '0-9')
  [ -n "$b" ] || return 1
  [ "$b" -gt "$CAP_BLANK_BYTES" ]
}

wait_presenting() {
  # Bounded wait for real pixels. Returns 1 on timeout so the caller can say
  # so, but a timeout is not an error: a boot into standby never presents.
  # Deliberately not `i`: this runs inside relaunch_home's own loop, and sh
  # has no locals, so sharing the name ended that loop early and logged a
  # nonsense attempt count.
  waited=0
  while [ "$waited" -lt "$READY_WAIT" ]; do
    panel_presenting && return 0
    if [ "${LUMA_BOOT:-0}" = "1" ] && [ "$waited" -ge "$STANDBY_WAIT" ] && ! panel_is_active; then return 1; fi
    sleep 1
    waited=$((waited+1))
  done
  return 1
}

relaunch_home() {
  # One launch, then wait for pixels.
  #
  # Hammering launch requests every couple of seconds while the compositor is
  # still coming up leaves the panel black indefinitely, so there is still
  # exactly one launch per attempt. What changed is the gate: the Home
  # process, NL_HOME_SHOWN and getForegroundAppInfo all go true about 8s
  # before anything is composited, so none of them can end the wait, but a
  # captured frame can. Measured: content reaches the panel 12s after a
  # restart, and launching Home immediately does not delay it - the old
  # sequence slept 14s before even asking for Home, then slept 8s more.
  #
  # turnOnScreen exists for the interactive path: a compositor restart can
  # leave the panel blanked, and the user asked for the screen. On the boot
  # path it is wrong: after a crash-recovery "reboot to suspend" the set is
  # booting in order to go back to standby, and forcing the panel on here
  # turned a TV the user had switched off back on. The hook sets
  # LUMA_BOOT=1; the panel is then whatever the system decided.
  i=0
  while [ "$i" -lt 3 ]; do
    [ "${LUMA_BOOT:-0}" = "1" ] || luna-send -n 1 "$SCREEN_ON_URI" '{}' >/dev/null 2>&1
    # A web Home (the stub) launched into a WebAppMgr that is about to close goes
    # with it, so the launch waits for the new one.
    if hs_mounted_ours && wait_wam_restart; then sleep 1; fi
    luna-send -n 1 "$HOME_LAUNCH_URI" "$HOME_LAUNCH_PARAMS" >/dev/null 2>&1
    if wait_presenting; then
      log_line "home on panel after $i relaunch attempt(s)"
      return 0
    fi
    if home_running && { { [ "${LUMA_BOOT:-0}" = "1" ] && ! panel_is_active; } || home_in_front; }; then
      # Running but nothing on the panel: the set is booting into standby, or
      # the panel is off. Nothing more to wait for. A Home that is not in front
      # while the set is Active is a preload (seen on a restart straight after a
      # wake, and at boot when the launch went to a WebAppMgr that was closing):
      # the panel stays black until Home is launched again.
      log_line "home up after $i relaunch attempt(s), panel not presenting"
      return 0
    fi
    i=$((i+1))
  done
  log_line "home did not come back after 3 launch attempts"
  return 1
}

wait_surface_active() {
  # Bounded poll (~40s) for surface-manager-daemon.service to report active.
  i=0
  while [ "$i" -lt 40 ]; do
    st=$(systemctl is-active "$SURFACE_SVC" 2>/dev/null)
    if [ "$st" = "active" ]; then return 0; fi
    sleep 1
    i=$((i+1))
  done
  return 1
}

wam_stamp() {
  # WebAppMgr's start time; it moves when systemd starts it again.
  systemctl show "$WAM_SVC" -p ExecMainStartTimestampMonotonic 2>/dev/null | cut -d= -f2
}

wait_wam_restart() {
  # WebAppMgr exits with the compositor and systemd starts it again. Measured at
  # boot: compositor restart at 34.9 s, old WebAppMgr closed at 38.0 s, new one
  # started at 38.2 s and answering at 39.1 s. Bounded, so that a restart which
  # left WebAppMgr alone does not hold Home back; with no earlier stamp it is
  # satisfied by a WebAppMgr that answers.
  wm_i=0
  while [ "$wm_i" -lt "$WAM_WAIT" ]; do
    wm_s=$(wam_stamp)
    if [ -n "$wm_s" ] && [ "$wm_s" != "${WAM_STAMP0:-}" ] \
       && luna-send -n 1 luna://com.palm.webappmanager/listRunningApps '{}' 2>/dev/null \
            | grep -q '"returnValue"[[:space:]]*:[[:space:]]*true'; then
      return 0
    fi
    sleep 1; wm_i=$((wm_i+1))
  done
  return 1
}

restart_surface() {
  # A restart is how the modded QML reaches the screen: the compositor's first
  # start at 2.6s cannot see our EnvironmentFile, because /var does not yet
  # show the writable filesystem that early. It makes LG stock apps segfault
  # on teardown and arms tvpowerd's reboot-to-suspend, so snapshot the crash
  # reports first and remove the ones this restart adds.
  #
  # No settle here. is-active goes true almost immediately (Type=notify), long
  # before a frame can be presented, but the caller launches Home straight
  # away and then waits on the panel, which is the only honest gate. Measured:
  # asking for Home at +4s still put content up at +12s, so sleeping first
  # bought nothing and cost 14s.
  # Nothing restarts the unit while LG's Home is being recovered after LumaTV's compositor was
  # away: a second restart would take the compositor down under the recovery's Home launch.
  i=0; while comp_recovering && [ "$i" -lt 60 ]; do sleep 1; i=$((i+1)); done
  if comp_recovering; then log_line "restart: a recovery of LG's Home is still running, the compositor is not restarted"; return 1; fi
  WAM_STAMP0=$(wam_stamp)
  reports_before=$(snapshot_reports)
  systemctl restart "$SURFACE_SVC" >/dev/null 2>&1
  wait_surface_active || return 1
  disarm_restart_crashes "$reports_before"
  return 0
}

home_back_after_restart() {
  # Home after a compositor restart, then a second sweep of the crash reports.
  # The igallery teardown crash lands ~3s after the restart, which is inside
  # the window wait_surface_active can return in, so the sweep inside
  # restart_surface may run before there is anything to remove. By the time
  # Home is on the panel (~12s) it has landed.
  kill_home_app
  relaunch_home
  disarm_restart_crashes "$reports_before"
}

surface_start_uptime() {
  # Seconds after boot at which the running compositor started, from field 22
  # of /proc/<pid>/stat (clock ticks since boot, CLK_TCK=100 on this kernel).
  #
  # Not /proc/<pid>'s mtime. That is only the time the /proc entry was last
  # instantiated - on this kernel it read "176s ago" for a compositor that
  # had been running for 829s - and trusting it made apply skip a restart the
  # compositor needed, leaving stock QML under a modded layout.
  #
  # Monotonic on purpose: the wall clock is unsynchronised for the first
  # seconds of boot (systemd stamps early units in 2022), so any comparison in
  # epoch seconds across that window is meaningless.
  p=$(pgrep -x surface-manager 2>/dev/null | head -n1)
  [ -n "$p" ] || return 1
  t=$(awk '{print int($22 / 100)}' "/proc/$p/stat" 2>/dev/null)
  [ -n "$t" ] || return 1
  printf '%s\n' "$t"
}

boot_id() { cat /proc/sys/kernel/random/boot_id 2>/dev/null; }
uptime_s() { cut -d. -f1 /proc/uptime 2>/dev/null; }

record_bound_now() {
  # The content now live was bound at this instant of this boot. Scoped to the
  # boot id so a stale record from a previous boot can never be mistaken for
  # this one's.
  printf '%s %s\n' "$(boot_id)" "$(uptime_s)" > "$BOUND_AT"
}

bound_at_uptime() {
  # Seconds after boot the live content was bound, or nothing if the record is
  # missing or from another boot.
  read -r bid up < "$BOUND_AT" 2>/dev/null || return 1
  [ "$bid" = "$(boot_id)" ] || return 1
  printf '%s\n' "$up"
}

panel_is_active() {
  # Only "Active" means the panel is actually presenting. Restarting the
  # compositor while the set is in standby or suspending is pointless work on
  # the boot path, and it is how a half-finished apply used to be interrupted.
  luna-send -n 1 luna://com.webos.service.tvpower/power/getPowerState '{}' 2>/dev/null \
    | tr -d '\n' | grep -q '"state"[[:space:]]*:[[:space:]]*"Active"'
}

take_mutation_lock() {
  # Serialise anything that mounts, unmounts or restarts the compositor. Two
  # concurrent applies interleave their unmount/stage/bind steps and can leave
  # the wrong number of mounts live; the boot hook made this reachable, because
  # a user launching the app can now overlap the detached boot apply.
  mkdir -p "$(dirname "$LOCKFILE")" 2>/dev/null
  exec 9>"$LOCKFILE" 2>/dev/null || return 0
  if ! flock -x -w "$LOCK_WAIT" 9 2>/dev/null; then
    return 1
  fi
  return 0
}

# --------------------------------------------------------------- config i/o

write_config() {
  # $1=fps $2=persist $3=ntfy_enabled $4=ntfy_url $5=sddp_prev $6=homestub
  # (fps/persist/enabled/homestub: true|false; sddp_prev: on|off|empty)
  mkdir -p "$STATE" 2>/dev/null
  url_esc=$(json_escape "$4")
  sddp_esc=$(json_escape "${5:-}")
  tmp="$CONFIG.tmp.$$"
  printf '{"fps":%s,"ntfy":{"url":"%s","enabled":%s},"persist":%s,"sddp_prev":"%s","homestub":%s}\n' \
    "$1" "$url_esc" "$3" "$2" "$sddp_esc" "${6:-false}" > "$tmp" && mv "$tmp" "$CONFIG"
}

ensure_config() {
  [ -f "$CONFIG" ] || write_config false false false "" "" false
}

cfg_get_bool() {
  # $1 = key name (fps|persist|enabled|homestub)
  sed -n "s/.*\"$1\"[ ]*:[ ]*\\(true\\|false\\).*/\\1/p" "$CONFIG" 2>/dev/null | head -n1
}

cfg_get_str() {
  # $1 = key name (url)
  sed -n "s/.*\"$1\"[ ]*:[ ]*\"\\([^\"]*\\)\".*/\\1/p" "$CONFIG" 2>/dev/null | head -n1
}

cfg_read_all() {
  ensure_config
  CFG_FPS=$(cfg_get_bool fps); [ -n "$CFG_FPS" ] || CFG_FPS=false
  CFG_PERSIST=$(cfg_get_bool persist); [ -n "$CFG_PERSIST" ] || CFG_PERSIST=false
  CFG_NTFY_ENABLED=$(cfg_get_bool enabled); [ -n "$CFG_NTFY_ENABLED" ] || CFG_NTFY_ENABLED=false
  CFG_NTFY_URL=$(cfg_get_str url)
  # What enableSDDP was before `standby warm` turned it off, so `standby cold`
  # can put it back. Empty when this mod has not touched it.
  CFG_SDDP_PREV=$(cfg_get_str sddp_prev)
  # The confirmed Home stub switch. A trial that has not been confirmed lives in
  # tmpfs only (HS_TRIAL), so a reboot in the middle of one ends it.
  CFG_HOMESTUB=$(cfg_get_bool homestub); [ -n "$CFG_HOMESTUB" ] || CFG_HOMESTUB=false
}

set_cfg_bool() {
  # $1 = fps|persist|enabled|homestub  $2 = true|false
  cfg_read_all
  case "$1" in
    fps) CFG_FPS="$2" ;;
    persist) CFG_PERSIST="$2" ;;
    enabled) CFG_NTFY_ENABLED="$2" ;;
    homestub) CFG_HOMESTUB="$2" ;;
  esac
  write_config "$CFG_FPS" "$CFG_PERSIST" "$CFG_NTFY_ENABLED" "$CFG_NTFY_URL" "$CFG_SDDP_PREV" "$CFG_HOMESTUB"
}

set_cfg_ntfy_url() {
  cfg_read_all
  CFG_NTFY_URL="$1"
  write_config "$CFG_FPS" "$CFG_PERSIST" "$CFG_NTFY_ENABLED" "$CFG_NTFY_URL" "$CFG_SDDP_PREV" "$CFG_HOMESTUB"
}

set_cfg_sddp_prev() {
  cfg_read_all
  CFG_SDDP_PREV="$1"
  write_config "$CFG_FPS" "$CFG_PERSIST" "$CFG_NTFY_ENABLED" "$CFG_NTFY_URL" "$CFG_SDDP_PREV" "$CFG_HOMESTUB"
}

# ----------------------------------------------------------------- ntfy i/o

ntfy_notify() {
  # $1 = message. Always non-fatal: never propagates a failure to the caller.
  msg="$1"
  cfg_read_all
  [ "$CFG_NTFY_ENABLED" = "true" ] || return 0
  [ -n "$CFG_NTFY_URL" ] || return 0
  curl -fsS -m 10 -H "Title: $DISPLAY_NAME" -H 'Tags: tv' -d "$msg" "$CFG_NTFY_URL" >/dev/null 2>&1
  return 0
}

# ---------------------------------------------------------- system readouts

get_version() {
  sed -n 's/.*"version"[ ]*:[ ]*"\([^"]*\)".*/\1/p' "$APPINFO" 2>/dev/null | head -n1
}

get_firmware() {
  if [ -r /etc/os-release ]; then
    v=$(sed -n 's/^VERSION_ID=\(.*\)$/\1/p' /etc/os-release 2>/dev/null | head -n1 | tr -d '"')
    if [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
  fi
  if [ -r /etc/starfish-release ]; then
    v=$(sed -n 's/^[A-Za-z]* release \([0-9.]*\).*/\1/p' /etc/starfish-release 2>/dev/null | head -n1)
    if [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
  fi
  printf '%s' ""
}

get_model() {
  if [ -r /etc/prefs/properties/machineName ]; then
    tr -d '\n' < /etc/prefs/properties/machineName 2>/dev/null
    return 0
  fi
  printf '%s' ""
}

# ------------------------------------------------------------- QML staging

stage_compositor() {
  # $1 = fps (true|false), $2 = output path (default: the live stage). Always
  # rebuilt from the pristine payload, so the payload itself is never touched
  # and repeated calls are idempotent.
  fps="$1"; out="${2:-$COMPOSITOR_STAGE}"
  mkdir -p "$STATE" 2>/dev/null
  sed -e "s#file:///tmp/hx/wall_1080\\.png#file://$WALLPAPER_STAGE#" \
      -e "s/property bool debugFps: true/property bool debugFps: $fps/" \
      "$QML_SRC" > "$out.tmp.$$" && mv "$out.tmp.$$" "$out"
}

tree_fp() {
  # Content hash of a directory (or a file): every file's bytes in path order
  # relative to the argument, so a one-byte QML edit changes it and a rename
  # inside does too, while two copies under different names compare equal.
  [ -e "$1" ] || { printf 'missing'; return 0; }
  if [ -d "$1" ]; then
    ( cd "$1" && find . -type f | sort | while IFS= read -r f; do printf '%s\n' "$f"; cat "$f"; done ) 2>/dev/null | md5sum | cut -c1-32
  else
    md5sum < "$1" 2>/dev/null | cut -c1-32
  fi
}

stage_luma() {
  # $1 = fps (true|false), $2 = output dir (default: the live stage). The Home
  # QML directory copied verbatim plus a generated settings.json carrying the
  # fps flag: it lives inside the module so that flipping fps changes the
  # staged tree and earns the compositor restart that makes it visible. The
  # shipped theme.json and layout.json go in beside it as theme.default.json and
  # layout.default.json: LumaHome reads them at once and merges the user's copies
  # over them, so a changed default is a changed tree, and earns the restart too.
  # build_shadow copies the directory into the module. Nothing under
  # controllers/ is shadowed: types reached through the module's qmldir
  # (StarfishKeyController and friends) resolve to /usr/lib/qt5 regardless of
  # QML2_IMPORT_PATH on this firmware, so Home input goes through the
  # container's focus instead.
  fps="$1"; out="${2:-$LUMA_STAGE}"
  [ -d "$LUMA_SRC" ] || return 1
  rm -rf "$out.tmp.$$" 2>/dev/null
  mkdir -p "$out.tmp.$$" 2>/dev/null || return 1
  cp -R "$LUMA_SRC" "$out.tmp.$$/$QML_MODULE" 2>/dev/null || { rm -rf "$out.tmp.$$"; return 1; }
  printf '{"fps":%s}\n' "$fps" > "$out.tmp.$$/$QML_MODULE/settings.json"
  cp "$THEME_SRC/theme.json" "$out.tmp.$$/$QML_MODULE/theme.default.json" 2>/dev/null \
    && cp "$THEME_SRC/layout.json" "$out.tmp.$$/$QML_MODULE/layout.default.json" 2>/dev/null \
    || { rm -rf "$out.tmp.$$"; return 1; }
  rm -rf "$out" 2>/dev/null
  mv "$out.tmp.$$" "$out"
}

stage_theme() {
  # Fonts and the default wallpaper are payload-owned and always refreshed.
  # theme.json and layout.json in the data dir hold only what the user changed:
  # LumaHome merges them over the shipped files (the defaults staged by
  # stage_luma), and `theme.py minimize` rewrites each to just the keys that
  # differ from the shipped copy, so what was never changed follows an update.
  # cache/ holds the last weather and news the cards drew (their JSON is the
  # native helper's schema), written by LumaHome. Tokens.js is the resolved
  # token set for QML in other processes to import by file URL.
  mkdir -p "$FONTS_DIR" "$THEME_DIR" "$STATE/cache" 2>/dev/null || return 1
  rm -f "$FONTS_DIR"/Inter*.ttf 2>/dev/null
  cp -f "$FONTS_SRC"/*.ttf "$FONTS_DIR/" 2>/dev/null
  cp -f "$WALL_SRC" "$THEME_DIR/wall_1080.png" 2>/dev/null
  for f in theme.json layout.json; do
    [ -f "$THEME_DIR/$f" ] || printf '{}\n' > "$THEME_DIR/$f"
    python3 "$THEME_TOOL" "$THEME_DIR/$f" minimize "$THEME_SRC/$f" < /dev/null >/dev/null 2>>"$LOGFILE" \
      || log_line "stage_theme: $f could not be read, left as it is"
    rm -f "$THEME_DIR/.shipped-$f" 2>/dev/null
  done
  write_tokens_js
  return 0
}

write_tokens_js() {
  # Rewritten only when it changes, so its mtime says when the tokens last moved.
  python3 "$TOKENS_TOOL" "$THEME_SRC/theme.json" "$THEME_DIR/theme.json" js < /dev/null > "$THEME_DIR/Tokens.js.new" 2>>"$LOGFILE" || { rm -f "$THEME_DIR/Tokens.js.new"; return 1; }
  if cmp -s "$THEME_DIR/Tokens.js.new" "$THEME_DIR/Tokens.js" 2>/dev/null; then rm -f "$THEME_DIR/Tokens.js.new"; else mv -f "$THEME_DIR/Tokens.js.new" "$THEME_DIR/Tokens.js"; fi
}

keyfilter_set() {
  # $1 = add|remove. The stock StarfishKeyFilter builds its handler chain from
  # the configd list com.webos.surfacemanager.keyFilters, and picks up changes
  # live (Settings.subscribe). That list is the only way a script of ours sees
  # remote keys inside the compositor: a shadowed controllers/StarfishKeyFilter
  # .qml is never loaded on this firmware (module types resolve to /usr/lib
  # regardless of QML2_IMPORT_PATH; only relative-file references from an
  # already-shadowed view pick up the override). Our entry goes first: the
  # stock handleSystemKeys answers Back with NotAccepted (deliver to the app
  # and stop) while Home is up, so a later entry never sees Back at all.
  # Ours returns NextPolicy for everything it does not consume, so the stock
  # chain runs unchanged behind it.
  #
  # luna-send prints nothing when its stdin is a pipe, so the helper is a
  # file and runs with stdin from /dev/null, never a heredoc.
  mode="$1"
  if [ "$mode" = add ]; then
    mkdir -p "$KEYFILTER_DIR" 2>/dev/null || return 1
    cp -f "$KEYFILTER_SRC" "$KEYFILTER_DIR/$SHORT_ID.js" 2>/dev/null || return 1
  fi
  python3 "$KEYFILTER_TOOL" "$mode" "$KEYFILTER_HANDLER" "$KEYFILTER_DIR/$SHORT_ID.js" < /dev/null 2>>"$LOGFILE"
}

systemui_stage() {
  # Copy the stock Quick Settings tree once, then lay our files over it. The
  # copy is 27MB; it is rebuilt only when the stock tree's fingerprint moves,
  # which is to say after a firmware update.
  fp=$(tree_fp "$QS_STOCK")
  if [ ! -f "$QS_MAIN" ] || [ "$fp" != "$(cat "$QS_STOCK_FP" 2>/dev/null)" ]; then
    rm -rf "$QS_STAGE.new" 2>/dev/null
    mkdir -p "$SYSTEMUI_STAGE" 2>/dev/null || return 1
    cp -a "$QS_STOCK" "$QS_STAGE.new" 2>/dev/null || return 1
    rm -rf "$QS_STAGE.old" 2>/dev/null
    [ -d "$QS_STAGE" ] && mv "$QS_STAGE" "$QS_STAGE.old" 2>/dev/null
    mv "$QS_STAGE.new" "$QS_STAGE" 2>/dev/null || return 1
    rm -rf "$QS_STAGE.old" 2>/dev/null
    printf '%s\n' "$fp" > "$QS_STOCK_FP"
  fi
  # Our overlay, re-applied every time so an app update lands without a
  # 27MB recopy. Mirrors the payload's directory layout onto the stage.
  # No pipeline: a `while read` on the far side of one runs in a subshell,
  # where a failed copy cannot fail the function.
  ok=1
  for rel in $(cd "$SYSTEMUI_SRC" && find . -type f -name '*.qml'); do
    mkdir -p "$SYSTEMUI_STAGE/$(dirname "$rel")" 2>/dev/null
    cp -f "$SYSTEMUI_SRC/$rel" "$SYSTEMUI_STAGE/$rel" 2>/dev/null || ok=0
  done
  [ "$ok" = 1 ] || return 1
  [ -f "$QS_MAIN" ] || return 1
  # Targeted edits to LG's own files: the glass palette, and the retention that
  # stops the panel being rebuilt on every open. Fatal on a missing anchor, so
  # a firmware update that rewrites them is caught here rather than shipping a
  # half-patched menu.
  # The palette comes from the live theme, so the menus are tinted by the
  # wallpaper in use rather than by constants in the patch.
  pal=$(python3 "$TOKENS_TOOL" "$THEME_SRC/theme.json" "$THEME_DIR/theme.json" qml < /dev/null 2>>"$LOGFILE")
  python3 "$SYSTEMUI_PATCH_TOOL" "$QS_STAGE" "$pal" < /dev/null >>"$LOGFILE" 2>&1
}

webglass_apps() {
  # The web apps the shared web theme is laid over: the Settings app, its sub-apps and the other Enact/Sandstone apps that
  # draw as transparent windows, one id a line in payload/webapps/apps.txt (comments and blank lines skipped).
  grep -v '^[[:space:]]*\(#\|$\)' "$WEBGLASS_SRC/apps.txt" 2>/dev/null
}

webglass_set() {
  # $1 = on|off.
  #
  # WebAppMgr loads webOSUserScripts/userScript.js from an app's own directory
  # into that app's page. /usr is a lowerdir-only overlay and cannot gain a new
  # file, so each app directory gets its own overlay mount: LG's directory as
  # the lower layer, ours as the upper. That adds the script and the stylesheet
  # and nothing else - no copy of a 23MB bundle, and unmounting restores the
  # stock app exactly.
  mode="$1"
  rc=0
  for app in $(webglass_apps); do
    target="/usr/palm/applications/$app"
    [ -d "$target" ] || continue
    up="$WEBGLASS_STAGE/$app/upper/webOSUserScripts"
    work="$WEBGLASS_STAGE/$app/work"
    drain_umount "$target"
    if [ "$mode" = on ]; then
      mkdir -p "$up" "$work" 2>/dev/null || { rc=1; continue; }
      cp -f "$WEBGLASS_SRC/userScript.js" "$up/userScript.js" 2>/dev/null || rc=1
      cp -f "$WEBGLASS_SRC/$SHORT_ID.css" "$up/$SHORT_ID.css" 2>/dev/null || rc=1
      python3 "$TOKENS_TOOL" "$THEME_SRC/theme.json" "$THEME_DIR/theme.json" css < /dev/null > "$up/theme.css" 2>>"$LOGFILE" || rc=1
      # The same font the Home screen uses, beside the stylesheet that asks for
      # it: a web app can only load a face from its own directory.
      for f in Manrope-Regular.ttf Manrope-Medium.ttf Manrope-SemiBold.ttf Manrope-Bold.ttf; do
        cp -f "$FONTS_SRC/$f" "$up/$f" 2>/dev/null || rc=1
      done
      mount -t overlay "$SHORT_ID" -o \
        "lowerdir=$target,upperdir=$WEBGLASS_STAGE/$app/upper,workdir=$work" \
        "$target" 2>>"$LOGFILE" || rc=1
    fi
    # Either way the running instance holds the old page; closing it means the
    # next launch builds against what is mounted now.
    luna-send -n 1 luna://com.webos.applicationManager/closeByAppId \
      "{\"id\":\"$app\"}" >/dev/null 2>&1
  done
  return $rc
}

verb_webglass() {
