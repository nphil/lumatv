# --------------------------------------------------------- early boot hook

install_early_hook() {
  # PATH for kdump.service, plus the shim it will resolve `grep` to.
  mkdir -p "$EARLY_BIN" "$(dirname "$EARLY_ENV_FILE")" 2>/dev/null || return 1
  {
    printf '%s\n' '#!/bin/sh'
    printf '%s\n' '# Early boot trigger, installed as a PATH shim in front of grep'
    printf '%s\n' '# for kdump.service only. It starts the apply ~19s earlier than Homebrew'
    printf '%s\n' "# Channel's init.d run-parts can, then behaves exactly like grep."
    printf '%s\n' '#'
    printf '%s\n' '# Absolute paths throughout: this shim is first on PATH, so a bare grep'
    printf '%s\n' '# here would re-enter it. Every path still ends in exec, so nothing here'
    printf '%s\n' '# can stop the unit that called it.'
    printf 'APPDIR=%s\n' "$APPDIR"
    printf 'STATE=%s\n' "$STATE"
    printf 'ONCE=%s\n' "$EARLY_ONCE"
    cat <<'SHIM'
if [ ! -e "$ONCE" ]; then
  : > "$ONCE" 2>/dev/null
  if [ -x "$APPDIR/tools/autostart.sh" ]; then
    PATH=/usr/sbin:/usr/bin:/sbin:/bin \
      /usr/bin/setsid "$APPDIR/tools/autostart.sh" --worker </dev/null >/dev/null 2>&1 &
  fi
fi
exec /bin/grep "$@"
SHIM
  } > "$EARLY_SHIM.tmp.$$" || return 1
  chmod 0755 "$EARLY_SHIM.tmp.$$" 2>/dev/null
  mv -f "$EARLY_SHIM.tmp.$$" "$EARLY_SHIM" 2>/dev/null || return 1
  printf 'PATH=%s:/usr/sbin:/usr/bin:/sbin:/bin\n' "$EARLY_BIN" > "$EARLY_ENV_FILE.tmp.$$" || return 1
  mv -f "$EARLY_ENV_FILE.tmp.$$" "$EARLY_ENV_FILE" 2>/dev/null || return 1
  sync
  return 0
}

remove_early_hook() {
  rm -f "$EARLY_ENV_FILE" "$EARLY_ENV_FILE.tmp."* 2>/dev/null
  rm -rf "$EARLY_BIN" 2>/dev/null
  return 0
}

early_hook_live() {
  [ -f "$EARLY_ENV_FILE" ] && [ -x "$EARLY_SHIM" ] \
    && grep -qF "$EARLY_BIN" "$EARLY_ENV_FILE" 2>/dev/null
}

# ------------------------------------------------------------------ persist

persist_enable() {
  mkdir -p "$(dirname "$AUTOSTART_LINK")" 2>/dev/null
  rm -f "$AUTOSTART_LINK" 2>/dev/null
  ln -s "$AUTOSTART_SRC" "$AUTOSTART_LINK" 2>/dev/null || return 1
  set_cfg_bool persist true
  # The init.d symlink is the safety net; the early hook is what makes a
  # boot fast. Its absence is not fatal - the late hook still applies.
  if ! install_early_hook; then
    log_line "persist: early hook could not be installed, late hook only"
  fi
  return 0
}

verb_persist() {
  action="${1:-}"
  case "$action" in
    on)
      if ! persist_enable; then
        emit_error "failed to create persist symlink"
        return 1
      fi
      ;;
    off)
      rm -f "$AUTOSTART_LINK" 2>/dev/null
      remove_early_hook
      rm -f "$COMP/enabled" 2>/dev/null
      set_cfg_bool persist false
      ;;
    *)
      emit_error "persist requires on or off"
      return 1
      ;;
  esac
  if [ -L "$AUTOSTART_LINK" ]; then real=true; else real=false; fi
  log_line "persist: set to $action (symlink=$real)"
  printf '{"ok":true,"persist":%s}\n' "$real"
  return 0
}

# ------------------------------------------------------- previous-brand move
#
# The mod used to ship as LumaGlass: app org.nphil.lumaglass, data in
# /var/lib/lumaglass, boot hook 50-lumaglass. These are the only places that
# still name it. On the first verb of the new tool, migrate_legacy moves what
# the old one left on the set and takes the old apps off, so a set that only
# has the old layout can be applied, reverted or switched off by this tool.
LEGACY_STATE=/var/lib/lumaglass
LEGACY_APP=org.nphil.lumaglass
LEGACY_FRAME_APP=org.nphil.lumaglass.frame
LEGACY_AUTOSTART_LINK=/var/lib/webosbrew/init.d/50-lumaglass
LEGACY_KEYFILTER=lumaglass.js
LEGACY_CSS=lumaglass.css
# Present in the new data dir from the move until every step below has run, so
# a power cut or a failed step is picked up again by the next verb.
MIGRATING="$STATE/.migrating"

rewrite_legacy_paths() {
  # $1 = file. Points every mention of the old data dir at the new one; the
  # file is replaced in one rename so a reader never sees a half-written line.
  [ -f "$1" ] || return 0
  grep -qF "$LEGACY_STATE" "$1" 2>/dev/null || return 0
  sed "s#$LEGACY_STATE#$STATE#g" "$1" > "$1.tmp.$$" && mv -f "$1.tmp.$$" "$1"
}

remove_legacy_app() {
  # $1 = app id. Removed through appInstallService, the way it was installed,
  # never by deleting its directory; done means the directory is gone.
  dir="$(dirname "$APPDIR")/$1"
  [ "$dir" != "$APPDIR" ] && [ -d "$dir" ] || return 0
  luna-send -n 3 -f luna://com.webos.appInstallService/dev/remove "{\"id\":\"$1\",\"subscribe\":true}" >/dev/null 2>&1 &
  lpid=$!
  w=0
  while [ -d "$dir" ] && [ "$w" -lt 30 ]; do sleep 1; w=$((w+1)); done
  kill "$lpid" 2>/dev/null
  if [ -d "$dir" ]; then
    log_line "migrate: $1 is still installed after 30s"
  else
    log_line "migrate: removed app $1"
  fi
  return 0
}

migrate_legacy() {
  # Leave the migration marker in place when owned UI changes cannot be removed.
  if [ -f "$MIGRATING" ]; then
    from="$STATE"
  elif [ "$LEGACY_STATE" != "$STATE" ] && [ -d "$LEGACY_STATE" ] && [ ! -L "$LEGACY_STATE" ] && [ ! -e "$STATE" ]; then
    from="$LEGACY_STATE"
  else
    return 0
  fi

  if [ "$from" = "$LEGACY_STATE" ]; then
    # Wait out an apply or revert of the old tool, and keep new ones out, for
    # as long as the move takes. Nothing is logged yet: log_line would create
    # the new data dir and the move would then never happen.
    exec 8>"$LEGACY_STATE/mutate.lock" 2>/dev/null
    if ! flock -x -w "$LOCK_WAIT" 8 2>/dev/null; then
      exec 8>&-
      printf '%s migrate: old tool still running, not moved\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" >> "$LEGACY_STATE/log" 2>/dev/null
      return 1
    fi
    : > "$LEGACY_STATE/.migrating"
  fi

  # Unmount only our old web overlays before moving their upper directories.
  if [ -f "$from/.webglass-on" ]; then
    for migration_app in $(webglass_apps); do
      if ! stock_ui_unmount_overlay "/usr/palm/applications/$migration_app" "$from/webapps/$migration_app/upper"; then
        [ "$from" != "$LEGACY_STATE" ] || exec 8>&-
        return 1
      fi
    done
  fi
  if [ -f "$from/.systemui-on" ]; then
    migration_status=$(timeout 5 python3 "$SYSTEMUI_TOOL" status </dev/null 2>/dev/null) || { [ "$from" != "$LEGACY_STATE" ] || exec 8>&-; return 1; }
    migration_path=$(printf '%s' "$migration_status" | python3 -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1], ""))' "$QS_APP" 2>/dev/null) || { [ "$from" != "$LEGACY_STATE" ] || exec 8>&-; return 1; }
    case "$migration_path" in
      "file://$LEGACY_STATE/systemui/"*|"file://$STATE/systemui/"*)
        timeout 5 python3 "$SYSTEMUI_TOOL" off "$QS_APP" </dev/null >/dev/null 2>&1 || { [ "$from" != "$LEGACY_STATE" ] || exec 8>&-; return 1; } ;;
    esac
  fi

  if [ "$from" = "$LEGACY_STATE" ]; then
    if ! mv "$LEGACY_STATE" "$STATE" 2>/dev/null; then
      exec 8>&-
      printf '%s migrate: could not move to %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" "$STATE" >> "$LEGACY_STATE/log" 2>/dev/null
      return 1
    fi
    exec 8>&-
  fi
  log_line "migrate: data now in $STATE"

  # Keep staged system UI files until owned redirects have been restored.
  rm -rf "$LUMA_STAGE" "$LUMA_STAGE.next" 2>/dev/null
  rm -f "$KEYFILTER_DIR/$LEGACY_KEYFILTER" "$VERIFIED" 2>/dev/null
  for f in "$WEBGLASS_STAGE"/*/upper/webOSUserScripts/"$LEGACY_CSS"; do
    [ -e "$f" ] && rm -f "$f"
  done

  # The compositor's env file and the early-boot env file hold the old data
  # dir; the early-boot shim holds it and the old app dir in its body, so it
  # is written again rather than patched.
  rewrite_legacy_paths "$ENV_FILE"
  rewrite_legacy_paths "$EARLY_ENV_FILE"
  if [ -x "$EARLY_SHIM" ]; then
    install_early_hook || log_line "migrate: early boot hook could not be rewritten"
  fi

  # The init.d link points into the old app, which goes below.
  rm -f "$LEGACY_AUTOSTART_LINK" 2>/dev/null
  if [ "$(cfg_get_bool persist)" = true ]; then
    persist_enable || log_line "migrate: boot hook could not be re-created"
  fi

  # Remove the retired Home handlers, including entries pointing at the old data dir.
  log_stderr python3 "$KEYFILTER_TOOL" remove "$KEYFILTER_HANDLER" "$KEYFILTER_DIR/$SHORT_ID.js" < /dev/null \
    || log_line "migrate: could not remove the legacy key filter from configd"

  remove_legacy_app "$LEGACY_FRAME_APP"
  remove_legacy_app "$LEGACY_APP"
  rm -f "$MIGRATING"
  log_line "migrate: done"
  return 0
}

