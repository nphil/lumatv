recover_home() {
  # LG's Home after the compositor was away and came back: the bundle's own script when it is there
  # (it holds the recovery lock), else the tool's relaunch.
  if [ -f "$COMP/bin/recover-home.sh" ]; then sh "$COMP/bin/recover-home.sh" >/dev/null 2>&1
  else home_back_after_restart; fi
}

clear_stock_running() (
  [ -e "$COMP/running" ] || return 0
  exec 9>"$LOCKFILE" 2>/dev/null || return 1
  flock -x -w "$LOCK_WAIT" 9 2>/dev/null || return 1
  [ -e "$COMP/stock-ui-held" ] && [ ! -e "$COMP/enabled" ] && ! comp_mounted || return 1
  systemctl is-active --quiet "$SURFACE_SVC" || return 1
  stock_pid=$(systemctl show "$SURFACE_SVC" --property=MainPID --value 2>/dev/null)
  case "$stock_pid" in ""|*[!0-9]*|0) return 1 ;; esac
  stock_exe=$(stat -Lc "%d:%i" "/proc/$stock_pid/exe" 2>/dev/null) || return 1
  supervisor_exe=$(stat -Lc "%d:%i" "$COMP/bin/lumatv-sm" 2>/dev/null) || return 1
  [ -n "$stock_exe" ] && [ "$stock_exe" != "$supervisor_exe" ] || return 1
  rm -f "$COMP/running"
)

verb_compositor() {
  case "${1:-status}" in
    on|off)
      take_mutation_lock || { emit_error "another mutation is still running"; return 1; }
      rc=0; msg=""
      if [ "$1" = on ]; then
        old_hold_present=false; old_hold_generation=""
        if [ -e "$COMP/stock-ui-held" ]; then
          old_hold_present=true
          old_hold_generation=$(cat "$COMP/stock-ui-held") || { exec 9>&-; emit_error "could not read stock UI hold"; return 1; }
        fi
        msg=$(comp_preflight "${2:-}"); rc=$?
        if [ "$rc" -ne 0 ]; then exec 9>&-; emit_error "$msg"; return "$rc"; fi
        native_storage_guard || { exec 9>&-; emit_error "$STORAGE_WHY"; return 1; }
        mkdir -p "$COMP" || { emit_error "could not prepare compositor state"; return 1; }
        if [ "$old_hold_present" = true ]; then
          hold_tmp=$(mktemp "$COMP/.enable-hold.XXXXXX") || { exec 9>&-; emit_error "could not prepare stock UI hold"; return 1; }
          if ! mv -f "$COMP/stock-ui-held" "$hold_tmp"; then
            rm -f "$hold_tmp"; exec 9>&-; emit_error "stock UI hold changed during enable"; return 9
          fi
          moved_generation=$(cat "$hold_tmp") || { ln "$hold_tmp" "$COMP/stock-ui-held" 2>/dev/null || :; exec 9>&-; emit_error "could not read stock UI hold"; return 1; }
          if [ "$moved_generation" != "$old_hold_generation" ]; then
            if ! ln "$hold_tmp" "$COMP/stock-ui-held" 2>/dev/null && [ ! -e "$COMP/stock-ui-held" ]; then
              exec 9>&-; emit_error "could not preserve new stock UI hold"; return 1
            fi
            rm -f "$hold_tmp"; exec 9>&-; emit_error "stock UI recovery interrupted compositor startup"; return 9
          fi
          rm -f "$hold_tmp" || { ln "$hold_tmp" "$COMP/stock-ui-held" 2>/dev/null || :; exec 9>&-; emit_error "could not consume stock UI hold"; return 1; }
        elif [ -e "$COMP/stock-ui-held" ]; then
          exec 9>&-; emit_error "stock UI recovery interrupted compositor startup"; return 9
        fi
        mkdir -p "$(dirname "$AUTOSTART_LINK")" 2>/dev/null || { rc=1; msg="could not prepare boot hook"; }
        if [ "$rc" -eq 0 ]; then
          ln -sfn "$AUTOSTART_SRC" "$AUTOSTART_LINK" 2>/dev/null || { rc=1; msg="could not install boot hook"; }
        fi
        if [ "$rc" -eq 0 ]; then
          (install_early_hook) || log_line "compositor: early boot hook unavailable; using init.d"
          if [ -e "$COMP/stock-ui-held" ]; then
            rc=9; msg="stock UI recovery interrupted compositor startup"
          else
            (native_start >/dev/null) || { rc=1; msg="native startup failed"; }
          fi
        fi
      fi
      if [ "$rc" -eq 0 ]; then msg=$(comp_switch "$1" "${2:-}" preflighted); rc=$?; fi
      if [ "$1" = on ] && [ "$rc" -eq 1 ] && [ -e "$COMP/stock-ui-held" ]; then
        rc=9; msg="stock UI recovery interrupted compositor startup"
      fi
      if [ "$1" = on ] && [ "$rc" -ne 0 ]; then
        { (set -C; : > "$COMP/stock-ui-held") 2>/dev/null || [ -e "$COMP/stock-ui-held" ]; } || msg="$msg; could not restore stock UI hold"
        (comp_switch off >/dev/null) || msg="$msg; stock UI restoration incomplete"
      fi
      exec 9>&-
      if [ "$1" = off ] || [ "$rc" -ne 0 ]; then
        if (restart_surface stock); then
          (clear_stock_running) || { [ "$rc" -ne 0 ] || rc=1; msg="$msg; could not clear stock running marker"; }
        else
          [ "$rc" -ne 0 ] || rc=1; msg="$msg; stock compositor restart failed"
        fi
        (recover_home) || { [ "$rc" -ne 0 ] || rc=1; msg="$msg; Home recovery failed"; }
      else
        if [ -e "$COMP/stock-ui-held" ]; then
          rc=9; msg="stock UI recovery interrupted compositor startup"
        else
          # Boot direct (docs/research/boot-direct.md): the stub first, so that the Home SAM opens after the restart is not LG's.
          (bd_manual_stub)
          (restart_surface native) || { rc=1; msg="compositor restart failed"; }
        fi
        (recover_home) || { rc=1; msg="$msg; Home recovery failed"; }
        if [ "$rc" -eq 0 ]; then
          (comp_ready) || { rc=1; msg="native compositor did not become ready"; }
        fi
        if [ -e "$COMP/stock-ui-held" ] || [ -e "$COMP/last-fallback" ]; then
          rc=9; msg="supervisor returned to stock UI during startup"
        fi
        if [ "$rc" -ne 0 ]; then
          { (set -C; : > "$COMP/stock-ui-held") 2>/dev/null || [ -e "$COMP/stock-ui-held" ]; } || msg="$msg; could not restore stock UI hold"
          if take_mutation_lock; then
            (comp_switch off >/dev/null) || msg="$msg; stock UI restoration incomplete"
            exec 9>&-
          else
            exec 9>&-
            msg="$msg; could not acquire lock to restore stock UI"
          fi
          if (restart_surface stock); then
            (clear_stock_running) || msg="$msg; could not clear stock running marker"
          else
            msg="$msg; stock compositor restart failed"
          fi
          (recover_home) || msg="$msg; Home recovery failed"
        fi
      fi
      if [ "$rc" -ne 0 ]; then emit_error "$msg"; return "$rc"; fi
      log_line "compositor $1"
      printf '{"ok":true,"compositor":%s}\n' "$(comp_json)" ;;
    status) printf '{"ok":true,"compositor":%s}\n' "$(comp_json)" ;;
    check) printf '{"ok":true,"check":%s}\n' "$(comp_check_json)" ;;
    *) emit_error "compositor: on, off, status or check"; return 1 ;;
  esac
  return 0
}

verb_compositor_boot() {
  # Place the mount when everything allows it
  # (the flag, a firmware build the gate passed on, an intact bundle, a supervisor that answers, Home not held).
  # comp_boot_mount logs the reason of a refusal itself; the word is logged here.
  take_mutation_lock || { emit_error "stock UI held or another mutation is in progress"; return 1; }
  # Boot direct (opt-in, docs/research/boot-direct.md): the Home stub went in before anything else of this run (bd_early_boot, from the
  # dispatch, ahead of the storage guard and the migration), so that no launcher of Home can start LG's Flutter Home ahead of it.
  # Whatever ends this without LumaTV's compositor starting takes it back (bd_early_undo).
  bd_early=${BD_EARLY_ON:-0}
  if comp_enabled && ! native_storage_guard; then
    log_line "compositor-boot: $STORAGE_WHY"
    [ "$bd_early" = 1 ] && bd_early_undo
    emit_error "$STORAGE_WHY"
    return 1
  fi
  boot_comp_result=$(comp_boot_mount)
  case "$boot_comp_result" in
    mounted|already)
      native_start >/dev/null || { exec 9>&-; [ "$bd_early" = 1 ] && bd_early_undo; emit_error "native startup failed"; return 1; }
      install_frame_app
      if [ -f "${GFN_IPK:-}" ] && [ -d "${GFN_DIR:-}" ] && ! gfn_current && ! gfn_running; then
        if app_storage_guard "$GFN_IPK" "$GFN_DIR"; then
          gfn_update || log_line "boot: GeForce NOW update failed"
        else
          log_line "boot: GeForce NOW update deferred: $STORAGE_WHY"
        fi
      fi
      if feeder_installed; then
        if storage_guard "$STATE" "$FEEDER_SRC" "$(dirname "$FEEDER_SRC")/lib"; then
          feeder_update || true
        else
          log_line "boot: feeder update deferred: $STORAGE_WHY"
        fi
      fi
      ;;
    *) [ "$bd_early" = 1 ] && bd_early_undo ;;
  esac
  log_line "compositor-boot: $boot_comp_result"
  boot_standby=false
  if panel_is_active_standby; then boot_standby=true; fi
  printf '{"ok":true,"compositor":"%s","standby":%s}\n' "$boot_comp_result" "$boot_standby"
  return 0
}

verb_compositor_boot_activate() {
  take_mutation_lock || { emit_error "stock UI held or another mutation is in progress"; return 1; }
  if ! comp_enabled || ! comp_mounted || [ -e "$COMP/stock-ui-held" ] || comp_recovering; then
    exec 9>&-; emit_error "compositor activation refused"; return 1
  fi
  exec 9>&-
  if comp_live && comp_ready >/dev/null; then
    if [ "${1:-}" = standby ] && ! panel_is_active_standby; then
      emit_error "standby changed before activation"; return 1
    fi
    printf '{"ok":true,"compositor":"live"}\n'; return 0
  fi
  landing=
  if [ "${1:-}" = standby ]; then
    panel_is_active_standby || { emit_error "standby changed before activation"; return 1; }
  elif panel_is_active; then
    landing=$(boot_landing_app)
  fi
  # Boot direct (opt-in, docs/research/boot-direct.md): the stub that compositor-boot put in at the start of this boot stays through the
  # restart, and Home is launched as the stub after it. A boot that has none goes on without: LG's Home is what it gets.
  bd_up=0
  if bd_enabled; then
    if bd_early_in_place; then bd_up=1; else log_line "boot-direct: no stub in place for this activation"; fi
  fi
  restart_surface native "${1:-}"; restart_rc=$?
  if [ "$restart_rc" -eq 2 ] || [ -e "$COMP/stock-ui-held" ] || comp_recovering; then
    [ "$bd_up" = 1 ] && bd_abort
    emit_error "compositor activation interrupted by stock recovery"; return 1
  fi
  if [ "$restart_rc" -eq 0 ] && comp_ready >/dev/null && [ ! -e "$COMP/stock-ui-held" ]; then
    if [ "$bd_up" = 1 ]; then
      # A set that is in standby gets its Home from bootd at the wake.
      if [ "${1:-}" = standby ]; then bd_finish; elif bd_home_up; then bd_finish; else bd_fail "the stub did not start"; fi
    fi
    if [ -n "$landing" ] && [ "$landing" != __wake_skip__ ] && panel_is_active; then
      land_on_app "$landing" restart
    fi
    printf '{"ok":true,"compositor":"live"}\n'
    return 0
  fi
  [ "$bd_up" = 1 ] && bd_abort
  if take_mutation_lock; then
    (comp_switch off >/dev/null) || log_line "compositor-boot: stock UI restoration incomplete"
    exec 9>&-
    (restart_surface stock "${1:-}" && clear_stock_running) || log_line "compositor-boot: stock compositor restart failed"
  else
    exec 9>&-
    log_line "compositor-boot: could not acquire lock to restore stock UI"
  fi
  emit_error "native compositor activation failed"
  return 1
}





# Remove only a known upper directory, and never peel a foreign covering mount.
stock_ui_unmount_overlay() {
  su_target=$1; su_upper=$2; su_count=0
  [ -r /proc/mounts ] || return 1
  while :; do
    awk -v target="$su_target" -v upper="$su_upper" '
      $2 == target {
        owned = 0
        if ($3 == "overlay") {
          n = split($4, opts, ",")
          for (i = 1; i <= n; i++) if (opts[i] == "upperdir=" upper) owned = 1
        }
        if (owned) found = 1
        top = owned
      }
      END { if (!found) exit 1; if (!top) exit 2 }
    ' /proc/mounts
    su_layer=$?
    [ "$su_layer" -eq 1 ] && return 0
    [ "$su_layer" -eq 0 ] && [ "$su_count" -lt 8 ] || return 1
    timeout 3 umount "$su_target" >/dev/null 2>&1 || return 1
    su_count=$((su_count + 1))
  done
}

stock_ui_luna_ok() {
  su_reply=$(timeout 3 luna-send -n 1 "$1" "$2" </dev/null 2>/dev/null) || return 1
  printf '%s' "$su_reply" | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("returnValue") is True else 1)' 2>/dev/null
}

stock_ui_restore_env() {
  [ -f "$ENV_FILE" ] || return 0
  python3 - "$ENV_FILE" "$SHADOW_ROOT" <<'PY'
import os, shlex, stat, sys, tempfile
path, shadow = sys.argv[1:]
with open(path, encoding="utf-8") as f:
    lines = f.readlines()
out = []
for line in lines:
    key, sep, value = line.partition("=")
    if not sep or key.strip() != "QML2_IMPORT_PATH":
        out.append(line)
        continue
    values = shlex.split(value, comments=True)
    if len(values) != 1:
        raise ValueError("unsupported QML2_IMPORT_PATH")
    parts = values[0].split(":")
    if shadow not in parts:
        out.append(line)
        continue
    parts = [part for part in parts if part != shadow]
    if parts:
        out.append('QML2_IMPORT_PATH="' + ":".join(parts).replace("\\", "\\\\").replace('"', '\\"') + '"\n')
if out != lines:
    fd, tmp = tempfile.mkstemp(prefix=".lumatv-env-", dir=os.path.dirname(path))
    try:
        os.fchmod(fd, stat.S_IMODE(os.stat(path).st_mode))
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.writelines(out)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
PY
}

stock_ui_restore() {
  if [ ! -f "$COMP/stock-ui-held" ] || comp_mounted; then
    emit_error "stock UI restore requires the stock recovery hold and an unmounted supervisor"
    return 1
  fi
  su_failed=0
  hs_wd_stop
  if hs_mounted_ours; then
    hs_unmount || su_failed=1
    if ! hs_mounted_ours; then
      stock_ui_luna_ok luna://com.webos.applicationManager/blockSystemApp "{\"id\":\"$HOME_APP_ID\"}" || su_failed=1
      stock_ui_luna_ok luna://com.webos.applicationManager/releaseBlockSystemApp "{\"id\":\"$HOME_APP_ID\"}" || su_failed=1
      stock_ui_luna_ok luna://com.palm.webappmanager/killApp "{\"appId\":\"$HOME_APP_ID\"}" || su_failed=1
    fi
  fi
  hs_mode_set lg
  # The stub is gone and nothing of a boot's stub is in doubt any more: a mark left would be counted against the next boot (bd_early_stub)
  # and the watch's give-up would open LG's Home a second time. The strikes are not touched: an escape is neither a bad boot nor a good one.
  rm -f "$BD_PENDING"
  if [ -d "$ASSETS" ] && [ -d "$STOCK_ASSETS" ]; then
    su_i=0
    while [ "$su_i" -lt 8 ] && [ "$(stat -c %d:%i "$STOCK_ASSETS" 2>/dev/null)" = "$(stat -c %d:%i "$ASSETS" 2>/dev/null)" ]; do
      timeout 3 umount "$STOCK_ASSETS" >/dev/null 2>&1 || { su_failed=1; break; }
      su_i=$((su_i + 1))
    done
    if [ "$su_i" -eq 8 ] && [ "$(stat -c %d:%i "$STOCK_ASSETS" 2>/dev/null)" = "$(stat -c %d:%i "$ASSETS" 2>/dev/null)" ]; then su_failed=1; fi
  fi
  for su_target in /usr/palm/applications/com.webos.app.inputcommon/qml /usr/share/com.webos.app.inputcommon/qml; do
    stock_ui_unmount_overlay "$su_target" "$STATE/inputcommon/upper" || su_failed=1
  done
  for su_target in /usr/palm/applications/com.webos.app.voice/qml /usr/share/com.webos.app.voice/qml; do
    stock_ui_unmount_overlay "$su_target" "$STATE/voice/upper" || su_failed=1
  done
  stock_ui_unmount_overlay /usr/lib/maliit/plugins/qml "$STATE/maliit/upper" || su_failed=1
  for su_target in /mnt/otncabi/usr/palm/applications/com.webos.app.discovery /usr/palm/applications/com.webos.app.discovery; do
    stock_ui_unmount_overlay "$su_target" "$STATE/store/upper" || su_failed=1
  done
  for su_app in $(webglass_apps); do
    stock_ui_unmount_overlay "/usr/palm/applications/$su_app" "$WEBGLASS_STAGE/$su_app/upper" || su_failed=1
  done
  stock_ui_restore_env || su_failed=1
  timeout 5 python3 "$KEYFILTER_TOOL" remove "$KEYFILTER_HANDLER" "$KEYFILTER_DIR/$SHORT_ID.js" </dev/null >/dev/null 2>&1 || su_failed=1
  su_status=$(timeout 5 python3 "$SYSTEMUI_TOOL" status </dev/null 2>/dev/null) || su_failed=1
  for su_app in "$QS_APP" "$LOGO_BOOT_APP" "$LOGO_OFF_APP"; do
    su_path=$(printf '%s' "$su_status" | python3 -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1], ""))' "$su_app" 2>/dev/null) || { su_failed=1; continue; }
    case "$su_path" in
      "file://$SYSTEMUI_STAGE/"*) timeout 5 python3 "$SYSTEMUI_TOOL" off "$su_app" </dev/null >/dev/null 2>&1 || su_failed=1 ;;
    esac
  done
  if grep -qF "file://$NOTI_STAGE/" "$NOTI_PERSIST" 2>/dev/null; then
    stock_ui_luna_ok "$NOTI_VIEW_URI" "{\"viewName\":\"notificationView\",\"viewSource\":\"file://$NOTI_STOCK/NotificationView.qml\"}" || su_failed=1
    grep -qF "file://$NOTI_STOCK/NotificationView.qml" "$NOTI_PERSIST" 2>/dev/null || su_failed=1
  fi
  if [ "$su_failed" -ne 0 ]; then emit_error "stock UI restore incomplete"; return 1; fi
  printf '{"ok":true}\n'
}
verb_stock_ui_restore() {
  LOCK_WAIT=3
  take_mutation_lock || { emit_error "stock UI restore could not acquire mutation lock"; return 1; }
  stock_ui_restore
}



# ------------------------------------------------------------- storage guard

# /var is a ~966 MiB ext4 partition shared with LG (/mnt/lg/cmn_data), and LG's own startup cleanup empties what is not protected once
# it is 98 % full in blocks or inodes (measured 2026-10-30: 899 MB used, 98 %, a 180 MB runaway log among it). An apply stages whole
# copies beside the live ones before swapping, so its peak is the new copies on top of what is there. It refuses, before changing
# anything, unless that peak leaves a tenth of the partition (64 MiB at least; 2000 inodes at least) free in blocks and in inodes.

# "free_kb total_kb free_inodes total_inodes" for the filesystem holding $1 (or its nearest existing parent); inodes are 0 0 where
# the TV's busybox df cannot say.


# "kb inodes" an apply copies beside what is there. Each tree is counted once, which is the new copy; the old one is already in the
# partition's used figure. $1 = 1 when the stock assets are copied again; $2 = 1 for what this apply really writes: the Home tree and
# the shadow module only when they differ from what is staged, the binaries only when they differ from the staged ones, the fonts,
