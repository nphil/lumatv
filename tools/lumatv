}

verb_transitions() {
  case "${1:-status}" in
    on) transitions_set true || { emit_error "transitions: theme.json could not be updated"; return 1; } ;;
    off) transitions_set false || { emit_error "transitions: theme.json could not be updated"; return 1; } ;;
