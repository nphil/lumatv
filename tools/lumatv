SETTINGS_GET_URI="luna://com.webos.settingsservice/getSystemSettings"
SETTINGS_SET_URI="luna://com.webos.settingsservice/setSystemSettings"

get_option_setting() {
  # $1 = key in the "option" category. Prints the value, or nothing.
  luna-send -n 1 "$SETTINGS_GET_URI" "{\"category\":\"option\",\"keys\":[\"$1\"]}" 2>/dev/null \
    | tr -d '\n' | sed -n "s/.*\"$1\"[ ]*:[ ]*\"\\([^\"]*\\)\".*/\\1/p"
}

set_option_setting() {
  # $1 = key, $2 = value. The set's own settings service, so the change is
  # what the TV's menus would have done and it persists the same way.
  luna-send -n 1 "$SETTINGS_SET_URI" \
    "{\"category\":\"option\",\"settings\":{\"$1\":\"$2\"}}" 2>/dev/null \
    | tr -d '\n' | grep -q '"returnValue"[ ]*:[ ]*true'
}

set_general_setting() {
  # $1 = key, $2 = value, in the "general" category: the set's own settings service, as the TV's menus write it.
  luna-send -n 1 "$SETTINGS_SET_URI" \
    "{\"category\":\"general\",\"settings\":{\"$1\":\"$2\"}}" 2>/dev/null \
    | tr -d '\n' | grep -q '"returnValue"[ ]*:[ ]*true'
}

# What `general.lifeOnScreenMode` was before `standbyscreen off` turned it off, so `standbyscreen on` can put exactly that back.
STANDBYSCREEN_PREV="$STATE/standbyscreen.prev"

verb_standbyscreen() {
  # LG's Always Ready (art and clock on the panel while the set is "off") is `general.lifeOnScreenMode`: "off", "allEnabled" or "alwaysReady".
  # The plan is a panel that goes fully dark in standby, with the instant wake kept (PLAN, Surfaces; Nitin, 2026-10-23). The same switch is in
  # Settings > Home & look > Standby; this is the one a TV step can run and read back. Nothing else is touched.
  sb_mode=$(get_general_setting lifeOnScreenMode)
  case "${1:-status}" in
    off)
      take_mutation_lock || { emit_error "another mutation is in progress"; return 1; }
      if [ "$sb_mode" != off ]; then
        [ -n "$sb_mode" ] && { mkdir -p "$STATE" 2>/dev/null; printf '%s\n' "$sb_mode" > "$STANDBYSCREEN_PREV"; }
        set_general_setting lifeOnScreenMode off || { emit_error "the settings service did not take lifeOnScreenMode off"; return 1; }
      fi
      sb_now=$(get_general_setting lifeOnScreenMode)
      [ "$sb_now" = off ] || { emit_error "lifeOnScreenMode reads '$sb_now' after the change"; return 1; }
      log_line "standbyscreen off (was: ${sb_mode:-unknown})"
      printf '{"ok":true,"standbyscreen":"off","was":"%s"}\n' "$(json_escape "$sb_mode")" ;;
    on)
      take_mutation_lock || { emit_error "another mutation is in progress"; return 1; }
      sb_prev=$(cat "$STANDBYSCREEN_PREV" 2>/dev/null); [ -n "$sb_prev" ] || sb_prev=allEnabled
      set_general_setting lifeOnScreenMode "$sb_prev" || { emit_error "the settings service did not take lifeOnScreenMode $sb_prev"; return 1; }
      rm -f "$STANDBYSCREEN_PREV"
      log_line "standbyscreen on (back to $sb_prev)"
      printf '{"ok":true,"standbyscreen":"on","mode":"%s"}\n' "$(json_escape "$sb_prev")" ;;
    status)
      sb_dark=false; [ "$sb_mode" = off ] && sb_dark=true
      printf '{"ok":true,"on":%s,"mode":"%s","prev":"%s"}\n' "$sb_dark" "$(json_escape "$sb_mode")" "$(json_escape "$(cat "$STANDBYSCREEN_PREV" 2>/dev/null)")" ;;
    *) emit_error "usage: standbyscreen on|off|status"; return 1 ;;
  esac
  return 0
}

standby_mode() {
  # What the set will do at the next power-off, read from the live settings
  # rather than from anything stored here. "warm": stays in active standby
  # with RAM alive and powers on instantly with the mod still up. "cold":
  # powers fully down and every power-on is a boot. "system": Quick Start+
  # is on but SDDP is still enabled - the stock state, which on a set with a
  # VPN tun interface means webos-sddp crashes on the next network change and
  # the power-off after that reboots.
  qs=$(get_option_setting quickStartMode)
  sddp=$(get_option_setting enableSDDP)
  if [ "$qs" != "on" ]; then
    printf 'cold\n'
  elif [ "$sddp" = "off" ]; then
    printf 'warm\n'
  else
    printf 'system\n'
  fi
}

verb_standby() {
  # Two things decide whether a power-off leaves the set warm: Quick Start+
  # (LG's own "keep it in RAM" mode) and the absence of a crash report when
  # faultmanager looks. The report this mod's own restart produces is always
  # swept. The other one seen is webos-sddp (Control4 discovery), which
  # segfaults in SDDPSetDevice whenever it reads the interface list and finds
  # a point-to-point interface with the multicast flag - a Tailscale tun on
  # the reference set; proven by stopping tailscaled, after which it runs. A
  # stock set has no such interface. It is handled by not starting it, through
  # the set's own enableSDDP setting; the previous value is kept so "cold"
  # restores it.
  action="${1:-}"
  cfg_read_all
  case "$action" in
    warm)
      if [ -z "$CFG_SDDP_PREV" ]; then
        prev=$(get_option_setting enableSDDP); [ -n "$prev" ] || prev=on
        set_cfg_sddp_prev "$prev"
      fi
      set_option_setting enableSDDP off || { emit_error "could not turn off enableSDDP"; return 1; }
      set_option_setting quickStartMode on || { emit_error "could not turn on quickStartMode"; return 1; }
      ;;
    cold)
      set_option_setting quickStartMode off || { emit_error "could not turn off quickStartMode"; return 1; }
      if [ -n "$CFG_SDDP_PREV" ]; then
        set_option_setting enableSDDP "$CFG_SDDP_PREV" || { emit_error "could not restore enableSDDP"; return 1; }
        set_cfg_sddp_prev ""
      fi
      ;;
    *)
      emit_error "standby requires warm or cold"
      return 1
      ;;
  esac
  mode=$(standby_mode)
  log_line "standby: set to $action (now $mode)"
  printf '{"ok":true,"standby":"%s"}\n' "$mode"
  return 0
}

# --------------------------------------------------------------------- ntfy

verb_ntfy() {
  action="${1:-}"
  case "$action" in
    set)
      url="${2:-}"
      case "$url" in
        http://*/*|https://*/*) : ;;
        *) emit_error "ntfy url must be http(s) with a topic path"; return 1 ;;
      esac
      set_cfg_ntfy_url "$url"
      set_cfg_bool enabled true
      log_line "ntfy: configured"
      ;;
    off)
      set_cfg_bool enabled false
      log_line "ntfy: disabled"
      ;;
    test)
      cfg_read_all
      if [ "$CFG_NTFY_ENABLED" != "true" ] || [ -z "$CFG_NTFY_URL" ]; then
        emit_error "ntfy is not configured"
        return 1
      fi
      if ! curl -fsS -m 10 -H "Title: $DISPLAY_NAME" -H 'Tags: tv' -d "$DISPLAY_NAME test notification" "$CFG_NTFY_URL" >/dev/null 2>&1; then
        log_line "ntfy: test delivery failed"
        emit_error "ntfy test failed to deliver"
        return 1
      fi
      log_line "ntfy: test delivered"
      ;;
    *)
      emit_error "ntfy requires set <url>, off, or test"
      return 1
      ;;
  esac
  cfg_read_all
  url_esc=$(json_escape "$CFG_NTFY_URL")
  printf '{"ok":true,"ntfy":{"enabled":%s,"url":"%s"}}\n' "$CFG_NTFY_ENABLED" "$url_esc"
  return 0
}

# ---------------------------------------------------------------------- log

verb_log() {
  n="${1:-}"
  case "$n" in ''|*[!0-9]*) n=20 ;; esac
  out=""
  while IFS= read -r line || [ -n "$line" ]; do
    esc=$(json_escape "$line")
    if [ -z "$out" ]; then out="\"$esc\""; else out="$out,\"$esc\""; fi
  done <<LGEOF
$(python3 "$LOG_TOOL" read lumatv-tool "$n" 2>/dev/null)
LGEOF
  printf '{"ok":true,"lines":[%s]}\n' "$out"
  return 0
}

# ------------------------------------------------------------------ version

verb_version() {
  v=$(get_version); [ -n "$v" ] || v="0.0.0"
  printf '{"ok":true,"version":"%s"}\n' "$v"
  return 0
}

# ------------------------------------------------------------------- dispatch

maintenance_present() {
  [ -e "$STATE/maintenance" ] || [ -L "$STATE/maintenance" ]
}

maintenance_human_stop() {
  maintenance_present || return 0
  # A durable veto survives power loss. Failure must not swallow an emergency.
  python3 - "$STATE" <<'PY'
import os, sys
try:
    d = os.open(sys.argv[1], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    s = os.fstat(d)
    if s.st_uid != 0 or s.st_mode & 0o022:
        raise OSError("unsafe state directory")
    try:
        os.mkdir("maintenance-human-stop", 0o700, dir_fd=d)
    except FileExistsError:
        pass
    os.fsync(d)
    os.close(d)
except OSError:
    sys.exit(1)
PY
}

maintenance_guard() {
  maintenance_present || return 0
  case "$MAINTENANCE_ACCESS" in
    read) return 0 ;;
    emergency) maintenance_human_stop; return 0 ;;
  esac
  emit_error "maintenance is incomplete; activation is blocked"
  return 1
}

# Classify before migration: reads and emergencies must not create or migrate
# configuration while an interrupted installation is waiting for recovery.
MAINTENANCE_ACCESS=write
case "$VERB:${2:-}" in
  wake:status|wake:) MAINTENANCE_ACCESS=read ;;
  wake:off) MAINTENANCE_ACCESS=emergency ;;
  boot-direct:status|boot-direct:) MAINTENANCE_ACCESS=read ;;
  boot-direct:off|boot-direct:watch) MAINTENANCE_ACCESS=emergency ;;
  status:|surfaces:|version:|log:*|theme:get|theme:|layout:get|layout:|layout:check|compositor:check|stock-ui-restore:)
    MAINTENANCE_ACCESS=read ;;
  helper:status|helper:|capture:status|capture:|inputs:status|inputs:|vplane:status|vplane:|feeder:status|feeder:|gfn:status|gfn:|wallpaper:status|wallpaper:|transitions:status|transitions:|preload:status|preload:|logo:status|logo:|notifications:status|notifications:|compositor:status|compositor:|systemui:status|systemui:|webglass:status|webglass:|inputcommon:status|inputcommon:|updateblock:status|updateblock:|openapps:status|openapps:|voice:status|voice:|keys:status|keys:|store:status|store:|cover:status|cover:|splash:status|splash:|standbyscreen:status|standbyscreen:|homestub:status|homestub:)
    MAINTENANCE_ACCESS=read ;;
  revert:|persist:off|compositor:off|homestub:escape|homestub:off|helper:stop|capture:stop|vplane:stop)
    MAINTENANCE_ACCESS=emergency ;;
esac
maintenance_guard || exit 1

# The escape of an earlier boot lapses before anything else of this boot looks at the stock UI hold (the lock below refuses while it is
# held). Boot direct (opt-in, docs/research/boot-direct.md): the boot worker's `compositor-boot` puts the Home stub in before anything
# below. An exit between here and the verb takes it back (bd_early_gone), or LG's compositor would run on with a blank Home until the
# watch gives up.
case "$VERB:${2:-}" in
  compositor-boot:) escape_lapse; bd_early_boot ;;
esac

native_storage_guard() {
  storage_guard "$STATE" "$FONTS_SRC" "$AVATARS_SRC" "$THEME_SRC" "$WALL_SRC" \
    "$HELPER_SRC" "$JPEG_SRC" "$CAPTURE_SRC" "$CAPTURE_ROLE" "$STATE/helper.json"
}
case "$VERB:${2:-}" in
  compositor:on|compositor-boot:*)
    native_storage_guard || { bd_early_gone; emit_error "$STORAGE_WHY"; exit 1; } ;;
esac

if [ "$MAINTENANCE_ACCESS" = write ]; then
case "$VERB" in
  persist|standby|ntfy|theme|layout|helper|capture|inputs|vplane|feeder|gfn|wallpaper|transitions|preload|wake|compositor|compositor-boot|standbyscreen)
    # Before ensure_config, which would create the new data dir and with it
    # hide the old one.
    take_mutation_lock || { bd_early_gone; emit_error "another mutation is in progress"; exit 1; }
    if ! migrate_legacy; then
      bd_early_gone
      emit_error "could not safely migrate the previous data dir to $STATE"
      exit 1
    fi
    ensure_config
    exec 9>&-
    maintenance_guard || { bd_early_gone; exit 1; }
    ;;
esac
fi

app_storage_guard() {
  app_ipk=$1; app_dest=$2
  STORAGE_WHY="app package size unavailable"
  app_size=$(python3 - "$app_ipk" <<'PY'
import subprocess, sys, tarfile
try:
    proc = subprocess.Popen(["ar", "p", sys.argv[1], "data.tar.gz"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    total = count = 0
    with tarfile.open(fileobj=proc.stdout, mode="r|gz") as archive:
        for item in archive:
            total += (item.size + 1023) // 1024 + 4
            count += 1
    while proc.stdout.read(65536):
        pass
    if proc.wait() or not count:
        raise ValueError("invalid package")
    print(total, count)
except (OSError, ValueError, tarfile.TarError):
    sys.exit(1)
PY
  ) || return 1
  app_kib=${app_size% *}; app_entries=${app_size#* }
  STORAGE_EXTRA_KIB="$app_kib" STORAGE_EXTRA_INODES="$app_entries" storage_guard "$app_dest" "$app_ipk" || return 1
  STORAGE_EXTRA_KIB="$app_kib" STORAGE_EXTRA_INODES="$app_entries" storage_guard /tmp "$app_ipk"
}

install_frame_app() {
  # The frame app ships as an ipk inside the payload and is installed through the
  # developer install endpoint (the set is rooted, so it is reachable). Re-installed only
  # when the shipped version differs from the installed one; a failure is logged, never
  # fatal: Home works without it, the news mini app just cannot open.
  [ -f "$FRAME_IPK" ] || return 0
  shipped=$(ar p "$FRAME_IPK" control.tar.gz 2>/dev/null | tar -xzO control 2>/dev/null | sed -n 's/^Version: //p')
  installed=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAME_DIR/appinfo.json" 2>/dev/null)
  [ -n "$shipped" ] && [ "$shipped" = "$installed" ] && return 0
  app_storage_guard "$FRAME_IPK" "$FRAME_DIR" || { log_line "frame app update deferred: $STORAGE_WHY"; return 0; }
  cp -f "$FRAME_IPK" /tmp/$SHORT_ID-frame.ipk 2>/dev/null || return 0
  out=$(luna-send -n 3 -f luna://com.webos.appInstallService/dev/install "{\"id\":\"$FRAME_APP\",\"ipkUrl\":\"/tmp/$SHORT_ID-frame.ipk\",\"subscribe\":true}" 2>&1 | tr -d '\n')
  i=0; while [ "$i" -lt 20 ]; do
    [ "$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAME_DIR/appinfo.json" 2>/dev/null)" = "$shipped" ] && break
    sleep 1; i=$((i+1))
  done
  if [ "$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FRAME_DIR/appinfo.json" 2>/dev/null)" = "$shipped" ]; then
    log_line "frame app $shipped installed"
  else
    log_line "frame app install did not complete: $(printf '%s' "$out" | cut -c1-200)"
  fi
  rm -f /tmp/$SHORT_ID-frame.ipk
}


native_start() {
  stage_theme || log_line "native startup: theme staging failed"
  helper_start || true
  capture_start || true
  if vplane_installed; then vplane_start || true; fi
  [ ! -f "$PRELOAD_STATE" ] || log_stderr python3 "$PRELOAD_TOOL" on "$PRELOAD_SRC" "$PRELOAD_ORIG" "$PRELOAD_STATE" < /dev/null >/dev/null
  return 0
}

verb_theme() {
  # theme get | theme set '<json>': the companion app's and the Home popovers' way to edit
  # theme.json. The Home layer polls the file, so a set is live within 2 s and nothing
  # here restarts.
  if [ ! -f "$THEME_DIR/theme.json" ]; then
    [ "$MAINTENANCE_ACCESS" != read ] || { emit_error "theme has not been staged"; return 1; }
    stage_theme
  fi
  case "$1" in
    get) python3 "$THEME_TOOL" "$THEME_DIR/theme.json" get < /dev/null ;;
    set) [ -n "$2" ] || { emit_error "theme set needs a JSON object"; return 1; }
         python3 "$THEME_TOOL" "$THEME_DIR/theme.json" set "$2" < /dev/null || { emit_error "theme update failed"; return 1; }
         write_tokens_js || log_line "theme set: Tokens.js not rewritten" ;;
    *) emit_error "theme: get or set"; return 1 ;;
  esac
}

verb_layout() {
  # layout get | check '<json>' | put '<json>' | set '<json>' | reset: the owner's Home layout (layout.json), by the same rules as the
  # layout editor on Home (tools/layout.py). The Home layer polls the file, so a change is live within 2 s and nothing here restarts. No
  # copy of the file it replaces is kept: `layout reset` is the way back to the shipped layout, and `put` of the layout wanted any other.
  if [ ! -f "$THEME_DIR/layout.json" ]; then
    [ "$MAINTENANCE_ACCESS" != read ] || { emit_error "layout has not been staged"; return 1; }
    stage_theme
  fi
  case "$1" in
    get|reset) python3 "$LAYOUT_TOOL" "$THEME_DIR/layout.json" "$1" < /dev/null ;;
    check|put|set) [ -n "$2" ] || { emit_error "layout $1 needs a JSON object"; return 1; }
         python3 "$LAYOUT_TOOL" "$THEME_DIR/layout.json" "$1" "$2" --shipped "$THEME_SRC/layout.json" < /dev/null || return 1 ;;
    *) emit_error "layout: get, check, put, set or reset"; return 1 ;;
  esac
}

case "$VERB" in
  status) verb_status; exit $? ;;
  stock-ui-restore) verb_stock_ui_restore; exit $? ;;
  persist) verb_persist "${2:-}"; exit $? ;;
  restart) verb_restart; exit $? ;;
  helper) verb_helper "${2:-status}"; exit $? ;;
  capture) verb_capture "${2:-status}"; exit $? ;;
  inputs) verb_inputs "${2:-status}"; exit $? ;;
  vplane) verb_vplane "${2:-status}"; exit $? ;;
  feeder) verb_feeder "${2:-status}"; exit $? ;;
  gfn) verb_gfn "${2:-status}"; exit $? ;;
  wallpaper) verb_wallpaper "${2:-status}"; exit $? ;;
  transitions) verb_transitions "${2:-status}"; exit $? ;;
  preload) verb_preload "${2:-status}"; exit $? ;;
  wake) shift; [ "$#" -gt 0 ] || set -- status; verb_wake "$@"; exit $? ;;
  surfaces) verb_surfaces; exit $? ;;
  compositor) verb_compositor "${2:-status}" "${3:-}"; exit $? ;;
  compositor-boot) if [ "${2:-}" = activate ]; then verb_compositor_boot_activate "${3:-}"; else verb_compositor_boot; fi; exit $? ;;
  boot-direct) verb_boot_direct "${2:-status}"; exit $? ;;
  standby) verb_standby "${2:-}"; exit $? ;;
  ntfy) verb_ntfy "${2:-}" "${3:-}"; exit $? ;;
  log) verb_log "${2:-}"; exit $? ;;
  theme) verb_theme "${2:-get}" "${3:-}"; exit $? ;;
  layout) verb_layout "${2:-get}" "${3:-}"; exit $? ;;
  updateblock) verb_updateblock "${2:-status}"; exit $? ;;
  openapps) verb_openapps "${2:-status}"; exit $? ;;
  standbyscreen) verb_standbyscreen "${2:-status}"; exit $? ;;
  version) verb_version; exit $? ;;
  *) emit_error "unknown verb: $VERB"; exit 1 ;;
esac
