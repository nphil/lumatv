# Smooth transitions (theme.motion.transitions, off by default): a switch and nothing more. The compositor reads the theme file itself (once a
# second), the Home layer every 2 s, so nothing restarts; under LG's compositor the key changes nothing.
transitions_state() {
  tr_v=$(python3 "$THEME_TOOL" "$THEME_DIR/theme.json" read motion.transitions false < /dev/null 2>/dev/null)
  case "$tr_v" in True|true) printf true ;; *) printf false ;; esac
}

transitions_set() {
  [ -f "$THEME_DIR/theme.json" ] || stage_theme
  python3 "$THEME_TOOL" "$THEME_DIR/theme.json" set "{\"motion\":{\"transitions\":$1}}" < /dev/null > /dev/null || return 1
  return 0
}

transitions_json() {
  tr_comp=lg
