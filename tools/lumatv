keyboard_patched() {
  # Whether the shadow module's copy of LG's keyboard view carries the patch (true or false).
  if grep -q 'Luma: patched' "$SHADOW_ROOT/WebOSCompositor/views/StarfishKeyboardView.qml" 2>/dev/null; then printf true; else printf false; fi
}

verb_keyboard() {
  # The on-screen keyboard's window in the theme's layer motion (tools/keyboard_patch.py). The patch is made when the shadow module is
  # built, so a change of the switch is a rebuild: apply does it, once, and restarts LG's compositor if that is the live one. A set that
  # was never applied has no module yet: the flag is all there is to change and the first apply reads it. The keys themselves
  # (maliit's) are not restyled yet (docs/research/lg-restyles-result.md).
  case "${1:-status}" in
    on|off)
      kb_was=off; [ -f "$KEYBOARD_ON" ] && kb_was=on
      mkdir -p "$STATE" 2>/dev/null
      if [ "$1" = on ]; then : > "$KEYBOARD_ON" || { emit_error "could not write $KEYBOARD_ON"; return 1; }; else rm -f "$KEYBOARD_ON"; fi
      kb_applied=false
      if [ -d "$SHADOW_ROOT" ]; then
        kb_out=$(sh "$APPDIR/tools/lumatv" apply < /dev/null 2>>"$LOGFILE")
        case "$kb_out" in
          '{"ok":true'*) kb_applied=true ;;
          *)
            # the set is as it was: the flag goes back with it
            if [ "$kb_was" = on ]; then : > "$KEYBOARD_ON"; else rm -f "$KEYBOARD_ON"; fi
            case "$kb_out" in '{'*'"ok":false'*) printf '%s\n' "$kb_out" ;; *) emit_error "apply did not answer" ;; esac
            return 1 ;;
        esac
      fi
      log_line "keyboard $1 (applied: $kb_applied)"
      printf '{"ok":true,"keyboard":"%s","applied":%s,"patched":%s}\n' "$1" "$kb_applied" "$(keyboard_patched)" ;;
    status)
      kb_now=false; [ -f "$KEYBOARD_ON" ] && kb_now=true
      printf '{"ok":true,"on":%s,"patched":%s}\n' "$kb_now" "$(keyboard_patched)" ;;
    *) emit_error "usage: keyboard on|off|status"; return 1 ;;
  esac
  return 0
}

logo_set() {
