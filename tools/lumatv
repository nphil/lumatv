# The Home wallpaper's source (theme.wallpaperMotion.source): "gpu", drawn by the GPU as it always was (the default), or "video", a looping clip on
# the TV's video decoder through the video-plane player (vplane/, docs/research/videoplane-saver-result.md, "The moving wallpaper"). `video` is only
# the switch: the Home layer draws the GPU wallpaper until everything the clip needs is there, and the status says what is not (LumaTV's own
# compositor, the player installed and running, a clip in the package). The Home layer reads theme.json every 2 s, so nothing restarts.
wallpaper_source() {
  [ -f "$THEME_DIR/theme.json" ] || stage_theme
  src=$(python3 "$THEME_TOOL" "$THEME_DIR/theme.json" read wallpaperMotion.source gpu < /dev/null 2>/dev/null)
  case "$src" in video) printf video ;; *) printf gpu ;; esac
}

wallpaper_set() {
  [ -f "$THEME_DIR/theme.json" ] || stage_theme
  python3 "$THEME_TOOL" "$THEME_DIR/theme.json" set "{\"wallpaperMotion\":{\"source\":\"$1\"}}" < /dev/null > /dev/null || return 1
  write_tokens_js || log_line "wallpaper: Tokens.js not rewritten"
  return 0
}

wallpaper_json() {
  wp_src=$(wallpaper_source)
  wp_vp=$(vplane_json)
  wp_comp=lg
  if command -v comp_live > /dev/null 2>&1 && comp_live; then wp_comp=own; fi
  wp_missing=
  [ "$wp_comp" = own ] || wp_missing="$wp_missing${wp_missing:+,}\"LumaTV's compositor is not the live one\""
  case "$wp_vp" in *'"installed":true'*'"role":true'*) ;; *) wp_missing="$wp_missing${wp_missing:+,}\"the video-plane player is not installed (lumatv vplane install)\"" ;; esac
  case "$wp_vp" in *'"running":true'*) ;; *) wp_missing="$wp_missing${wp_missing:+,}\"the video-plane player is not running (lumatv vplane start)\"" ;; esac
  case "$wp_vp" in *'"walls":0'*) wp_missing="$wp_missing${wp_missing:+,}\"the package has no wallpaper clip\"" ;; esac
  wp_status="$VPLANE_MAILBOX/status.json"
  wp_state=$(sed -n 's/.*"state":"\([a-z]*\)".*/\1/p' "$wp_status" 2>/dev/null | head -n 1)
  wp_role=$(sed -n 's/.*"role":"\([a-z]*\)".*/\1/p' "$wp_status" 2>/dev/null | head -n 1)
  printf '{"source":"%s","ready":%s,"missing":[%s],"compositor":"%s","vplane":%s,"player":{"state":"%s","role":"%s"}}' \
    "$wp_src" "$(if [ -z "$wp_missing" ]; then printf true; else printf false; fi)" "$wp_missing" "$wp_comp" "$wp_vp" "$wp_state" "$wp_role"
}

# The GeForce NOW app (docs/research/gfn-app-result.md): `install` puts the shipped package on the set (first install, or an update that closes
# the app), so it is the owner's own command and apply never runs it for an app that is not there; apply only updates an installed one.
verb_gfn() {
  case "${1:-status}" in
    install)
      take_mutation_lock || { emit_error "another apply or revert is still running"; return 1; }
      if gfn_install; then printf '{"ok":true,"gfn":%s}\n' "$(gfn_status)"; else emit_error "the GeForce NOW app did not install"; return 1; fi ;;
    remove)
      take_mutation_lock || { emit_error "another apply or revert is still running"; return 1; }
      if gfn_remove; then printf '{"ok":true,"gfn":%s}\n' "$(gfn_status)"; else emit_error "the GeForce NOW app was not removed"; return 1; fi ;;
    status) printf '{"ok":true,"gfn":%s}\n' "$(gfn_status)" ;;
    *) emit_error "gfn: install, remove or status"; return 1 ;;
  esac
  return 0
}

verb_wallpaper() {
