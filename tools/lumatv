noti_view() {
  # $1 = the view's QML file. 0 when the compositor accepted it: no error code in the answer and,
  # since a success may print nothing, the path in the file LG writes when it takes a change.
  out=$(timeout 15 luna-send -n 1 "$NOTI_VIEW_URI" "{\"viewName\":\"notificationView\",\"viewSource\":\"file://$1\"}" 2>&1 < /dev/null)
  case "$out" in
    *'"errorCode"'*) log_line "notifications: the compositor refused $1: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-160)"; return 1 ;;
  esac
  if ! grep -qF "file://$1" "$NOTI_PERSIST" 2>/dev/null; then
    log_line "notifications: $1 was not taken ($(printf '%s' "$out" | tr '\n' ' ' | cut -c1-120))"
    return 1
  fi
  return 0
}

noti_stage() {
  # A fresh copy of LG's tree every time, patched; the old stage stays until the new one is whole.
  pal=$(python3 "$TOKENS_TOOL" "$THEME_SRC/theme.json" "$THEME_DIR/theme.json" qml < /dev/null 2>>"$LOGFILE") || return 1
  [ -d "$NOTI_STOCK" ] || return 1
  rm -rf "$NOTI_STAGE.new" 2>/dev/null
  mkdir -p "$SYSTEMUI_STAGE/SystemUI" 2>/dev/null || return 1
  cp -a "$NOTI_STOCK" "$NOTI_STAGE.new" 2>/dev/null || { rm -rf "$NOTI_STAGE.new"; return 1; }
  python3 "$NOTI_PATCH_TOOL" "$NOTI_STAGE.new" "$pal" "$NOTI_OVERLAY" < /dev/null 2>>"$LOGFILE" || { rm -rf "$NOTI_STAGE.new"; return 1; }
  rm -rf "$NOTI_STAGE.old" 2>/dev/null
  [ -d "$NOTI_STAGE" ] && mv "$NOTI_STAGE" "$NOTI_STAGE.old" 2>/dev/null
  mv "$NOTI_STAGE.new" "$NOTI_STAGE" 2>/dev/null || return 1
  rm -rf "$NOTI_STAGE.old" 2>/dev/null
  return 0
}

noti_set() {
  # $1 = on|off. `on` falls back to LG's view when the stage or the compositor says no.
  if [ "$1" = on ]; then
    if noti_stage && noti_view "$NOTI_STAGE/NotificationView.qml"; then return 0; fi
    noti_view "$NOTI_STOCK/NotificationView.qml"
    return 1
  fi
  noti_view "$NOTI_STOCK/NotificationView.qml"
}

