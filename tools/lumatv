inputs_json() {
  # The kernel's audio decoder ports and the input apps running: what `inputs release` acts on.
  ij_ports=""
  for ij_f in "$ADEC_PROC"/adec.p*; do
    [ -f "$ij_f" ] || continue
    ij_n=${ij_f##*.p}
    ij_o=$(sed -n 's/^Open=\([01]\).*/\1/p' "$ij_f" | head -n1)
    ij_c=$(sed -n 's/^Connect=\([A-Za-z0-9_]*\).*/\1/p' "$ij_f" | head -n1)
    ij_ports="$ij_ports${ij_ports:+,}{\"port\":$ij_n,\"open\":$([ "$ij_o" = 1 ] && printf true || printf false),\"connect\":\"$ij_c\"}"
  done
  ij_apps=""
  for ij_a in $(input_apps_running); do ij_apps="$ij_apps${ij_apps:+,}\"$ij_a\""; done
  ij_held=$(input_decoder_held) || ij_held=""
  printf '{"ports":[%s],"running":[%s],"held":"%s"}' "$ij_ports" "$ij_apps" "$ij_held"
}

verb_inputs() {
  # status: the ports and the input apps running. release: an input's decoder port left open with no input app
  # to release it (the state close_input_apps prevents) is released the way the owner would by hand: the port's
  # input app launched through SAM and closed again. Launching the input the receiver is on switches the receiver
  # through CEC (seen 2026-10-26: HDMI 2, the eARC port, cleared the receiver's mute), so this is the owner's
  # command, never apply's.
  case "${1:-status}" in
    status) printf '{"ok":true,"inputs":%s}\n' "$(inputs_json)" ;;
    release)
      ir_c=$(input_decoder_held) || { printf '{"ok":true,"released":false,"reason":"no port held","inputs":%s}\n' "$(inputs_json)"; return 0; }
      if [ -n "$(input_apps_running)" ]; then
        printf '{"ok":true,"released":false,"reason":"an input app is running and owns it","inputs":%s}\n' "$(inputs_json)"
        return 0
      fi
      case "$ir_c" in
        HDMI_PORT*) ir_app="com.webos.app.hdmi${ir_c#HDMI_PORT}" ;;
        *) ir_app="com.webos.app.livetv" ;;
      esac
      ir_front=$(foreground_app_id)
      luna-send -n 1 "$HOME_LAUNCH_URI" "{\"id\":\"$ir_app\"}" >/dev/null 2>&1
      ir_i=0
      while [ "$ir_i" -lt 10 ] && [ "$(foreground_app_id)" != "$ir_app" ]; do sleep 1; ir_i=$((ir_i+1)); done
      sleep 2
      close_input_apps "inputs release"
      case "$ir_front" in ''|"$ir_app") ir_front=$HOME_APP_ID ;; esac
      luna-send -n 1 "$HOME_LAUNCH_URI" "{\"id\":\"$ir_front\"}" >/dev/null 2>&1
      if input_decoder_held >/dev/null; then
        log_line "inputs release: $ir_app launched and closed, the port is still open"
        printf '{"ok":false,"released":false,"reason":"the port is still open after %s was launched and closed","inputs":%s}\n' "$ir_app" "$(inputs_json)"
        return 1
      fi
      log_line "inputs release: $ir_app launched and closed, the port is free"
      printf '{"ok":true,"released":true,"app":"%s","inputs":%s}\n' "$ir_app" "$(inputs_json)"
      ;;
    *) emit_error "inputs: status or release"; return 1 ;;
  esac
  return 0
}

