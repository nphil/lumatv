inputcommon_mounted() {
  # Whether the overlay is in place, by the tool's own report. apply leaves one alone: `on` drops inputcommon's process snapshot,
  # and doing that at every launch of the app would cost the next input switch a cold start. A reboot clears the mount and the
  # next apply makes it; after an update of the app, `inputcommon on` stages the new patch.
  sh "$INPUTCOMMON_TOOL" status < /dev/null 2>/dev/null | grep -q '"mounted":true'
}

inputcommon_set() {
  # $1 = on|off. tools/inputcommon.sh stages the patched copy, mounts it and drops inputcommon's process snapshot (or the reverse)
  # and prints one JSON object, kept in $ic_out. It leaves what is in force alone when it cannot stage or mount.
  ic_out=$(sh "$INPUTCOMMON_TOOL" "$1" < /dev/null 2>>"$LOGFILE"); ic_rc=$?
  log_line "inputcommon $1: $(printf '%s' "$ic_out" | cut -c1-200)"
  [ "$ic_rc" -eq 0 ] && printf '%s' "$ic_out" | grep -q '"ok":true'
}

verb_inputcommon() {
  case "${1:-status}" in
    on|off)
      take_mutation_lock || { emit_error "another apply or revert is still running"; return 1; }
      if inputcommon_set "$1"; then
        if [ "$1" = on ]; then : > "$INPUTCOMMON_ON"; else rm -f "$INPUTCOMMON_ON"; fi
        printf '%s\n' "$ic_out"
      else
        case "$ic_out" in '{'*'"ok":false'*) printf '%s\n' "$ic_out" ;; *) emit_error "tools/inputcommon.sh did not answer" ;; esac
        return 1
      fi ;;
    status)
      ic_out=$(sh "$INPUTCOMMON_TOOL" status < /dev/null 2>>"$LOGFILE")
      ic_now=false; [ -f "$INPUTCOMMON_ON" ] && ic_now=true
      case "$ic_out" in
        '{"ok":true,'*) ic_rest=${ic_out#'{"ok":true,'}; printf '{"ok":true,"on":%s,%s\n' "$ic_now" "$ic_rest" ;;
        *) emit_error "tools/inputcommon.sh did not answer"; return 1 ;;
      esac ;;
    *) emit_error "usage: inputcommon on|off|status"; return 1 ;;
  esac
  return 0
}

