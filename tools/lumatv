get_general_setting() {
  # $1 = key in the "general" category. Prints the value, or nothing.
  luna-send -n 1 "$SETTINGS_GET_URI" "{\"category\":\"general\",\"keys\":[\"$1\"]}" 2>/dev/null \
    | tr -d '\n' | sed -n "s/.*\"$1\"[ ]*:[ ]*\"\\([^\"]*\\)\".*/\\1/p"
}

foreground_app_id() {
  luna-send -n 1 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null \
    | tr -d '\n' | sed -n 's/.*"appId"[ ]*:[ ]*"\([^"]*\)".*/\1/p'
}

boot_landing_app() {
  # The wake policy owns the boot target when its detached worker has a token.
  # A failed revalidation must not turn an uncertain foreground into Home.
  if [ "${LUMA_BOOT:-0}" = 1 ] && [ -z "${LUMATV_WAKE_TOKEN:-}" ]; then
    printf '%s\n' __wake_skip__
    return 0
  fi
  if [ -n "${LUMATV_WAKE_TOKEN:-}" ]; then
    if [ "${2:-}" = restart ]; then
      la_result=$(python3 "$WAKE_TOOL" boot-check landing "$LUMATV_WAKE_TOKEN" restart "$3" < /dev/null 2>/dev/null)
    else
      la_result=$(python3 "$WAKE_TOOL" boot-check landing "$LUMATV_WAKE_TOKEN" < /dev/null 2>/dev/null)
    fi
    la_target=$(printf '%s' "$la_result" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    if data.get("phase") == "no-active-policy":
        print("__inactive__")
    elif data.get("ok") is not False and isinstance(data.get("appId"), str) and data["appId"] and "params" in data and (data["params"] is None or isinstance(data["params"], dict)):
        print(json.dumps({"appId": data["appId"], "params": data["params"], "source": data.get("source")}))
    else:
        print("__wake_skip__")
except (ValueError, TypeError, AttributeError):
    print("__wake_skip__")
')
    if [ "$la_target" != __inactive__ ]; then
      printf '%s\n' "${la_target:-__wake_skip__}"
      return 0
    fi
  fi
  [ "${1:-}" = apply ] && return 0
  [ "$(get_general_setting homeAutoLaunch)" = off ] || return 0
  la_app=$(foreground_app_id)
  case "$la_app" in ''|"$HOME_APP_ID") return 0 ;; esac
  python3 -c 'import json, sys; print(json.dumps({"appId": sys.argv[1], "params": {}, "legacy": True}))' "$la_app"
}

land_on_app() {
  # $1 is the captured app and launch parameters; $2 marks a compositor restart.
  la_legacy=$(printf '%s' "$1" | python3 -c 'import json, sys; print("yes" if json.load(sys.stdin).get("legacy") else "no")')
  if [ "$la_legacy" = no ]; then
    if [ "${2:-}" = restart ]; then
      la_original_app=$(printf '%s' "$1" | python3 -c 'import json, sys; print(json.load(sys.stdin)["appId"])')
      la_fresh=$(boot_landing_app apply restart "$la_original_app")
    else
      la_fresh=$(boot_landing_app apply)
    fi
    if [ -z "$la_fresh" ] || [ "$la_fresh" = __wake_skip__ ]; then
      if [ "${2:-}" = restart ]; then sleep 3; disarm_restart_crashes "$reports_before"; fi
      return 0
    fi
    set -- "$la_fresh" "${2:-}"
  fi
  la_app=$(printf '%s' "$1" | python3 -c 'import json, sys; print(json.load(sys.stdin)["appId"])')
  la_preserve=$(printf '%s' "$1" | python3 -c 'import json, sys; print("yes" if json.load(sys.stdin)["params"] is None else "no")')
  if [ "$la_preserve" = yes ]; then
    if [ "$(foreground_app_id)" = "$la_app" ]; then
      if [ "${2:-}" = restart ]; then sleep 3; disarm_restart_crashes "$reports_before"; fi
      return 0
    fi
    la_source=$(printf '%s' "$1" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("source", ""))')
    if [ "$la_source" != native-input-id-only ]; then
      LANDING_UNACCEPTED=1
      log_line "boot landing: $la_app not accepted; input parameters unavailable"
      if [ "${2:-}" = restart ]; then sleep 3; disarm_restart_crashes "$reports_before"; fi
      return 0
    fi
    la_payload=$(printf '%s' "$1" | python3 -c 'import json, sys; print(json.dumps({"id": json.load(sys.stdin)["appId"]}))')
  else
    la_payload=$(printf '%s' "$1" | python3 -c 'import json, sys; d = json.load(sys.stdin); print(json.dumps({"id": d["appId"], "params": d["params"]}))')
  fi
  if [ "${2:-}" != restart ] && [ "$(foreground_app_id)" = "$la_app" ]; then return 0; fi
  luna-send -n 1 "$HOME_LAUNCH_URI" "$la_payload" >/dev/null 2>&1
  la_i=0
  while [ "$la_i" -lt 10 ] && [ "$(foreground_app_id)" != "$la_app" ]; do sleep 1; la_i=$((la_i+1)); done
  if [ "$(foreground_app_id)" = "$la_app" ]; then
    log_line "boot landing: $la_app back in front after $la_i s"
    if [ "${2:-}" = restart ]; then sleep 3; disarm_restart_crashes "$reports_before"; fi
    return 0
  fi
  log_line "boot landing: $la_app did not come back"
  [ "$la_legacy" = yes ] || LANDING_UNACCEPTED=1
  if [ "$la_legacy" = yes ]; then
    if [ "${2:-}" = restart ]; then home_back_after_restart; else kill_home_app; relaunch_home; fi
  elif [ "${2:-}" = restart ]; then
    sleep 3
    disarm_restart_crashes "$reports_before"
  fi
}



