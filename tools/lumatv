# ------------------------------------------------------------- QML staging



tree_fp() {
  # Content hash of a directory (or a file): every file's bytes in path order
  # relative to the argument, so a one-byte QML edit changes it and a rename
  # inside does too, while two copies under different names compare equal.
  [ -e "$1" ] || { printf 'missing'; return 0; }
  if [ -d "$1" ]; then
    ( cd "$1" && find . -type f | sort | while IFS= read -r f; do printf '%s\n' "$f"; cat "$f"; done ) 2>/dev/null | md5sum | cut -c1-32
  else
    md5sum < "$1" 2>/dev/null | cut -c1-32
  fi
}



stage_theme() {
  # Fonts and the default wallpaper are payload-owned and always refreshed.
  # theme.json and layout.json in the data dir hold only what the user changed:
  # LumaHome merges them over the shipped files (the defaults staged by
  # stage_luma), and `theme.py minimize` rewrites each to just the keys that
  # differ from the shipped copy, so what was never changed follows an update.
  # cache/ holds the last weather and news the cards drew (their JSON is the
  # native helper's schema), written by LumaHome. Tokens.js is the resolved
  # token set for QML in other processes to import by file URL.
  mkdir -p "$FONTS_DIR" "$THEME_DIR" "$STATE/cache" 2>/dev/null || return 1
  rm -f "$FONTS_DIR"/Inter*.ttf 2>/dev/null
  cp -f "$FONTS_SRC"/*.ttf "$FONTS_DIR/" 2>/dev/null
  cp -f "$WALL_SRC" "$THEME_DIR/wall_1080.png" 2>/dev/null
  # The bundled avatars of the profiles (gallery.json and the PNGs it lists), where the helper and every screen read them from: nothing is
  # fetched to show or pick one. profiles/ itself is the helper's and is made at its first start from theme/ (helper/app/src/profiles.rs).
  if [ -d "$AVATARS_SRC" ]; then
    mkdir -p "$AVATARS_DIR" 2>/dev/null && cp -f "$AVATARS_SRC"/* "$AVATARS_DIR/" 2>/dev/null
  fi
  for f in theme.json layout.json; do
    [ -f "$THEME_DIR/$f" ] || printf '{}\n' > "$THEME_DIR/$f"
    log_stderr python3 "$THEME_TOOL" "$THEME_DIR/$f" minimize "$THEME_SRC/$f" < /dev/null >/dev/null \
      || log_line "stage_theme: $f could not be read, left as it is"
    rm -f "$THEME_DIR/.shipped-$f" 2>/dev/null
  done
  write_tokens_js
  return 0
}

write_tokens_js() {
  # Rewritten only when it changes, so its mtime says when the tokens last moved.
  log_stderr python3 "$TOKENS_TOOL" "$THEME_SRC/theme.json" "$THEME_DIR/theme.json" js < /dev/null > "$THEME_DIR/Tokens.js.new" || { rm -f "$THEME_DIR/Tokens.js.new"; return 1; }
  if cmp -s "$THEME_DIR/Tokens.js.new" "$THEME_DIR/Tokens.js" 2>/dev/null; then rm -f "$THEME_DIR/Tokens.js.new"; else mv -f "$THEME_DIR/Tokens.js.new" "$THEME_DIR/Tokens.js"; fi
}




webglass_apps() {
  # The web apps the shared web theme is laid over: the Settings app, its sub-apps and the other Enact/Sandstone apps that
  # draw as transparent windows, one id a line in payload/webapps/apps.txt (comments and blank lines skipped).
  grep -v '^[[:space:]]*\(#\|$\)' "$WEBGLASS_SRC/apps.txt" 2>/dev/null
}
























































































REPORTS_DIR=/tmp/var/log/reports/librdx

snapshot_reports() {
  # Paths of crash reports present now, one per line, so the ones a compositor
  # restart of ours creates can be told apart from anything already there.
  # Pathname expansion, never `ls`: see disarm_restart_crashes.
  for f in "$REPORTS_DIR"/*; do
    [ -e "$f" ] && printf '%s\n' "$f"
  done
}

disarm_restart_crashes() {
  # $1 = snapshot_reports output taken before the restart.
  #
  # A compositor restart makes LG's inputcommon segfault on teardown
  # (QFontDatabase::removeAllApplicationFonts; reproducible on stock firmware,
  # see the constants block). faultmanager scans this directory at power-off,
  # and any report there makes it answer the suspend request with
  # rebootToSuspend: the set then reboots instead of settling into active
  # standby, and the next power-on is a full boot rather than an instant one.
  # The reports are tmpfs and gone at the next boot anyway; removing only the
  # ones this restart produced gives the power path back without hiding
  # anything that was already there.
  #
  # The names cannot go through `ls`, and not only because they contain
  # spaces: rdxd writes the crashing binary's path into the name with 0x02 in
  # place of each '/', and busybox ls prints those bytes as '?'. A name read
  # back from ls therefore never matches the file, -e is false, rm is a no-op,
  # and the report stays. Pathname expansion hands back the raw bytes.
  before="$1"
  n=0
  for f in "$REPORTS_DIR"/*; do
    [ -e "$f" ] || continue
    printf '%s\n' "$before" | grep -qxF -- "$f" && continue
    rm -f "$f" 2>/dev/null && n=$((n+1))
  done
  [ "$n" -gt 0 ] && log_line "disarmed $n crash report(s) produced by our compositor restart"
  return 0
}

# ----------------------------------------------------------------- Home stub
#
# LG's Home is a Flutter app that stays resident under LumaHome (36-72 MB) and is
# what memchute closes when a big app launches, so each return to Home pays for
# LG's Home starting again and the compositor paging itself back in. The stub is
# a web app with the same id and category that draws nothing, bound over LG's
# app directory, so LumaHome is the only Home.
#
# SAM reads an appinfo.json only when it scans. blockSystemApp then
# releaseBlockSystemApp makes it drop and read that one app again within 0.5 s,
# with no SAM restart (which on webOS 10 has cost the picture, ARC sound and CEC
# until a power cut); the release must follow, since an app left blocked cannot
# launch. The block list file ends byte-identical. SAM keeps the old instance
# when the type changes under it and can then neither close nor replace it, so
# the directory and SAM change first and the old instance is stopped after: the
# Flutter process killed, or the stub's page killed through WebAppMgr
# (closeByAppId only sends it to the background).
#
# The Home assets bind stays where it is, under the stub, so LG's Home finds its
# decluttered assets when the stub goes.
#
# Every way out ends on LG's Home, never a black screen. revert and off remove
# the stub. The guard (homestub-watch) gives LG's Home back when LumaHome's
# heartbeat stops or an unconfirmed trial runs out, and when Home is held for
# 650 ms anywhere; LumaHome and the Home key write a request file for it, since
# the compositor is not allowed to run commands.

sam_home_type() {
  luna-send -n 1 luna://com.webos.applicationManager/getAppInfo "{\"id\":\"$HOME_APP_ID\"}" 2>/dev/null \
    | tr -d '\n' | sed -n 's/.*"type"[ ]*:[ ]*"\([^"]*\)".*/\1/p'
}

hs_mounted_any() {
  # Something is mounted on the app directory itself, not on the assets below it.
  grep -qF " $HOME_APP_DIR " /proc/self/mountinfo 2>/dev/null
}

hs_mounted_ours() {
  # Same device and inode as the staged copy.
  [ -d "$STUB_STAGE" ] || return 1
  hs_id=$(stat -c %d:%i "$HOME_APP_DIR" 2>/dev/null)
  [ -n "$hs_id" ] && [ "$hs_id" = "$(stat -c %d:%i "$STUB_STAGE" 2>/dev/null)" ]
}

hs_stub_in_front() { hs_mounted_ours && home_in_front; }

hs_open_home() { luna-send -n 1 "$HOME_LAUNCH_URI" "$HOME_LAUNCH_PARAMS" >/dev/null 2>&1; }

hs_stage() {
  # Copied in place, so a mounted stub follows an update. HS_STAGED says the
  # manifest changed, which SAM only learns of by reading the app again.
  HS_STAGED=0
  for hs_f in appinfo.json index.html icon.png; do
    [ -f "$STUB_SRC/$hs_f" ] || return 1
  done
  mkdir -p "$STUB_STAGE" 2>/dev/null || return 1
  for hs_f in appinfo.json index.html icon.png; do
    if ! cmp -s "$STUB_SRC/$hs_f" "$STUB_STAGE/$hs_f" 2>/dev/null; then
      cp -f "$STUB_SRC/$hs_f" "$STUB_STAGE/$hs_f" 2>/dev/null || return 1
      [ "$hs_f" = appinfo.json ] && HS_STAGED=1
    fi
  done
  return 0
}

hs_mode_set() {
  # $1 = stub | lg | legacy; $2 = optional trial=<seconds>. LumaHome reads it: lg
  # steps the layer aside so LG's Home shows, legacy is the layer over LG's Home as
  # before the stub. The second field is different on every write, so a new
  # decision is never taken for an old one.
  HS_MODE_N=$(( ${HS_MODE_N:-0} + 1 ))
  printf '%s %s.%s.%s%s\n' "$1" "$(uptime_s)" "$$" "$HS_MODE_N" "${2:+ $2}" > "$HS_MODE.tmp.$$" 2>/dev/null \
    && mv -f "$HS_MODE.tmp.$$" "$HS_MODE" 2>/dev/null
  return 0
}

hs_sam_reread() {
  luna-send -n 1 luna://com.webos.applicationManager/blockSystemApp "{\"id\":\"$HOME_APP_ID\"}" >/dev/null 2>&1
  hs_ri=0
  while [ "$hs_ri" -lt 5 ]; do
    hs_rr=$(luna-send -n 1 luna://com.webos.applicationManager/releaseBlockSystemApp "{\"id\":\"$HOME_APP_ID\"}" 2>/dev/null | tr -d '\n ')
    case "$hs_rr" in *'"returnValue":true'*) return 0 ;; esac
    hs_ri=$((hs_ri+1)); sleep 1
  done
  log_line "homestub: SAM would not release $HOME_APP_ID"
  return 1
}

hs_wait_type() {
  # $1 = the type SAM should report for Home (web | flutter); up to 5 s.
  hs_wi=0
  while [ "$hs_wi" -lt 10 ]; do
    [ "$(sam_home_type)" = "$1" ] && return 0
    sleep 0.5; hs_wi=$((hs_wi+1))
  done
  return 1
}

hs_unmount() {
  hs_ui=0
  while hs_mounted_ours && [ "$hs_ui" -lt 3 ]; do
    umount "$HOME_APP_DIR" >/dev/null 2>&1
    hs_ui=$((hs_ui+1))
    hs_mounted_ours && sleep 1
  done
  hs_mounted_ours && umount -l "$HOME_APP_DIR" >/dev/null 2>&1
  hs_mounted_ours && return 1
  return 0
}

hs_beat_seen() {
  # $1 = seconds to wait for LumaHome's beat to change.
  hs_b0=""; { read -r hs_b0 < "$HS_BEAT"; } 2>/dev/null
  hs_bi=0
  while [ "$hs_bi" -lt "$1" ]; do
    sleep 1
    hs_b1=""; { read -r hs_b1 < "$HS_BEAT"; } 2>/dev/null
    [ -n "$hs_b1" ] && [ "$hs_b1" != "$hs_b0" ] && return 0
    hs_bi=$((hs_bi+1))
  done
  return 1
}

hs_strikes() {
  hs_sn=$(cat "$HS_STRIKES" 2>/dev/null)
  case "$hs_sn" in ''|*[!0-9]*) hs_sn=0 ;; esac
  printf '%s' "$hs_sn"
}

hs_strike() {
  # One more fault in a row; at the limit the switch turns itself off.
  hs_sk=$(( $(hs_strikes) + 1 ))
  printf '%s\n' "$hs_sk" > "$HS_STRIKES" 2>/dev/null
  log_line "homestub: fault $hs_sk of $HS_MAX_STRIKES ($1)"
  if [ "$hs_sk" -ge "$HS_MAX_STRIKES" ]; then
    set_cfg_bool homestub false
    log_line "homestub: switched off after $hs_sk faults in a row"
  fi
}

hs_wanted() {
  # An unconfirmed trial counts: it brings the stub up for its 120 s.
  [ -f "$HS_SKIP" ] && return 1
  [ "$(hs_strikes)" -lt "$HS_MAX_STRIKES" ] || return 1
  [ -f "$HS_TRIAL" ] && return 0
  [ "$(cfg_get_bool homestub)" = true ]
}

hs_wd_alive() {
  [ -f "$HS_WD_PID" ] || return 1
  hs_wp=$(cat "$HS_WD_PID" 2>/dev/null)
  case "$hs_wp" in ''|*[!0-9]*) return 1 ;; esac
  [ -d "/proc/$hs_wp" ] && tr '\0' ' ' < "/proc/$hs_wp/cmdline" 2>/dev/null | grep -q 'homestub-watch'
}

hs_wd_stop() {
  if hs_wd_alive; then kill "$(cat "$HS_WD_PID")" 2>/dev/null; fi
  rm -f "$HS_WD_PID"
}

hs_wd_start() {
  hs_wd_alive && return 0
  # Closes the lock descriptors: a child holding them would keep every later
  # mutation waiting for as long as it lives.
  setsid "$APPDIR/tools/$SHORT_ID" homestub-watch 8>&- 9>&- </dev/null >/dev/null 2>&1 &
  return 0
}

hs_wd_restart() { hs_wd_stop; hs_wd_start; }

hs_guard_exit() {
  # A guard that was stopped for a restart must not take its successor's pidfile
  # with it.
  [ "$(cat "$HS_WD_PID" 2>/dev/null)" = "$$" ] && rm -f "$HS_WD_PID"
  exit 0
}

homestub_up() {
  # LG's Home directory shows the stub, SAM knows it, and LG's own instance, if
  # one started first, is stopped. 0 = in place; anything else left LG's Home.
  if hs_mounted_any && ! hs_mounted_ours; then
    log_line "homestub: something else is mounted on $HOME_APP_DIR, not stacking on it"
    return 2
  fi
  hs_was=0; hs_mounted_ours && hs_was=1
  hs_stage || { log_line "homestub: the stub's files are missing"; return 1; }
  if ! hs_mounted_ours; then
    # The assets bind goes first so that it sits under the stub, where LG's Home
    # looks once the stub is gone.
    if ! is_mounted "$STOCK_ASSETS" && [ -d "$ASSETS/i18n" ]; then
      mount --bind "$ASSETS" "$STOCK_ASSETS" >/dev/null 2>&1
    fi
    if ! mount --bind "$STUB_STAGE" "$HOME_APP_DIR" >/dev/null 2>&1 || ! hs_mounted_ours; then
      log_line "homestub: the bind on $HOME_APP_DIR failed"
      return 1
    fi
  fi
  hs_sam=$(sam_home_type)
  # Early in a boot SAM may not answer yet (HS_SAM_WAIT, in seconds, is set by the boot's own caller only): the bind is already in place,
  # and SAM reads it either when it starts or when it is asked to read it again.
  hs_wi=0
  while [ -z "$hs_sam" ] && [ "$hs_wi" -lt "${HS_SAM_WAIT:-0}" ]; do
    sleep 1; hs_wi=$((hs_wi+1)); hs_sam=$(sam_home_type)
  done
  if [ "$hs_sam" != web ] || { [ "$hs_was" = 1 ] && [ "$HS_STAGED" = 1 ]; }; then
    if ! hs_sam_reread || ! hs_wait_type web; then
      log_line "homestub: SAM did not take the stub as Home"
      homestub_drop legacy
      return 1
    fi
    # The page that was already running has the old manifest; the next launch
    # reads the new one.
    if [ "$hs_sam" = web ]; then
      luna-send -n 1 luna://com.palm.webappmanager/killApp "{\"appId\":\"$HOME_APP_ID\"}" >/dev/null 2>&1
    fi
  fi
  kill_home_app
  hs_mode_set stub
  log_line "homestub: stub in place at uptime $(uptime_s) s"
  return 0
}

homestub_drop() {
  # LG's Home owns its directory again and SAM knows it. $1 = what LumaHome does
  # next: legacy (covers LG's Home, as before the stub) or lg (steps aside).
  # HS_DROPPED says whether a stub was mounted.
  hs_next="${1:-legacy}"
  [ "${HS_IN_GUARD:-0}" = 1 ] || hs_wd_stop
  rm -f "$HS_TRIAL" "$HS_ESCAPE" "$HS_CONFIRM"
  HS_DROPPED=0
  if hs_mounted_ours; then
    HS_DROPPED=1
    hs_unmount || log_line "homestub: the stub is only lazily unmounted"
  fi
  if [ "$(sam_home_type)" = web ]; then
    hs_sam_reread
    hs_wait_type flutter || log_line "homestub: SAM still reports a web Home"
  fi
  if ! is_mounted "$STOCK_ASSETS" && [ -d "$ASSETS/i18n" ]; then
    mount --bind "$ASSETS" "$STOCK_ASSETS" >/dev/null 2>&1
  fi
  # The stub's page goes last. Where it was in front, SAM opens Home again about
  # a second later, and now the app it opens is LG's.
  if [ "$HS_DROPPED" = 1 ]; then
    luna-send -n 1 luna://com.palm.webappmanager/killApp "{\"appId\":\"$HOME_APP_ID\"}" >/dev/null 2>&1
    log_line "homestub: LG's Home is back in its directory"
  fi
  hs_mode_set "$hs_next"
  return 0
}

homestub_escape() {
  MAINTENANCE_ACCESS=emergency
  maintenance_human_stop
  # Home held: LG's own Home on screen, LumaHome out of its way, until the next
  # apply or reboot.
  take_mutation_lock || { log_line "homestub: escape could not take the lock"; return 1; }
  log_line "homestub: Home held, giving LG's Home back"
  : > "$HS_SKIP"
  homestub_drop lg
  hs_open_home
  return 0
}

homestub_fault() {
  # $1 = what went wrong. Home is opened again only where the stub was in front;
  # an app in front is left alone.
  take_mutation_lock || return 1
  log_line "homestub: $1, giving LG's Home back"
  hs_front=0; hs_stub_in_front && hs_front=1
  : > "$HS_SKIP"
  homestub_drop lg
  [ "$hs_front" = 1 ] && hs_open_home
  hs_strike "$1"
  ntfy_notify "$DISPLAY_NAME gave LG's Home back: $1"
  return 0
}

homestub_expire() {
  take_mutation_lock || return 1
  log_line "homestub: trial not confirmed, giving LG's Home back"
  hs_front=0; hs_stub_in_front && hs_front=1
  homestub_drop legacy
  [ "$hs_front" = 1 ] && hs_open_home
  ntfy_notify "$DISPLAY_NAME Home stub trial ended unconfirmed"
  return 0
}

homestub_confirm() {
  # Needs the stub in place and LumaHome beating: a stub nobody can see must not
  # become the setting.
  [ -f "$HS_TRIAL" ] || return 1
  hs_mounted_ours && [ "$(sam_home_type)" = web ] || return 2
  hs_beat_seen 3 || return 3
  set_cfg_bool homestub true
  rm -f "$HS_TRIAL" "$HS_STRIKES" "$HS_CONFIRM"
  hs_mode_set stub
  log_line "homestub: confirmed"
  return 0
}

homestub_sync() {
  # apply's step: the stub is brought in line with what is wanted, before the
  # compositor restarts so that the Home it relaunches is the stub. A hand-run
  # apply is the "next apply" of an escape; the boot worker's own is not.
  [ "${LUMA_BOOT:-0}" = 1 ] || rm -f "$HS_SKIP"
  if hs_wanted; then
    if homestub_up; then
      hs_wd_restart
    else
      log_line "homestub: not in place, LG's Home stays"
    fi
  else
    if hs_mounted_ours || [ "$(sam_home_type)" = web ]; then homestub_drop legacy; else hs_mode_set legacy; fi
  fi
  return 0
}

homestub_json() {
  hs_cfg=$(cfg_get_bool homestub); [ "$hs_cfg" = true ] || hs_cfg=false
  hs_mo=false; hs_mounted_ours && hs_mo=true
  hs_st=$(sam_home_type)
  hs_fl=false; pgrep -f "$HOME_PKILL_PATTERN" >/dev/null 2>&1 && hs_fl=true
  hs_left=0
  if [ -f "$HS_TRIAL" ]; then
    hs_dl=""; { read -r hs_tb hs_dl < "$HS_TRIAL"; } 2>/dev/null
    case "$hs_dl" in ''|*[!0-9]*) hs_left=$HS_TRIAL_SECS ;; *) hs_left=$((hs_dl - $(uptime_s))); [ "$hs_left" -gt 0 ] || hs_left=0 ;; esac
  fi
  if [ "$hs_mo" = true ] && [ "$hs_st" = web ]; then
    if [ -f "$HS_TRIAL" ]; then hs_state=trial; else hs_state=stub; fi
  elif [ "$hs_cfg" = true ] || [ -f "$HS_TRIAL" ]; then
    hs_state=lg
  else
    hs_state=off
  fi
  hs_gd=false; hs_wd_alive && hs_gd=true
  hs_bt=false
  if [ -f "$HS_BEAT" ]; then
    hs_age=$(( $(date +%s) - $(mtime_epoch "$HS_BEAT") ))
    [ "$hs_age" -le 3 ] && hs_bt=true
  fi
  printf '{"config":%s,"state":"%s","mounted":%s,"sam":"%s","flutter":%s,"trialLeft":%s,"guard":%s,"beat":%s,"faults":%s}' \
    "$hs_cfg" "$hs_state" "$hs_mo" "$hs_st" "$hs_fl" "$hs_left" "$hs_gd" "$hs_bt" "$(hs_strikes)"
}

# ------------------------------------------------------------------- The escape
#
# Home held 10 s is the one way from LumaTV to LG's Home, and it is the supervisor's own (compositor/sm/lumatv-sm.c): it reads the remotes by
# itself, ends the compositor, the UI and every other process LumaTV started, writes `escaped` beside the stock UI hold and execs LG's
# compositor, whose recovery (compositor/tools/tv-recover-home.sh --stock) runs stock_ui_restore and launches LG's Home. The owner did it, so
# it is no fault: no failure is counted and boot direct's flag stays on.
#
# The hold and `escaped` last for the rest of that boot (nothing starts LumaTV again by itself, the boot worker included) and no longer. The
# supervisor also makes ESCAPE_BOOT in tmpfs, which a reboot clears, so an `escaped` found without it was made in an earlier boot and the boot
# worker's first act drops it with the hold. A hold with no `escaped` is a fault's and stays until `compositor on`.
ESCAPE_BOOT="/tmp/.$SHORT_ID-escaped"

escape_lapse() {
  [ -f "$COMP/escaped" ] && [ ! -e "$ESCAPE_BOOT" ] || return 0
  rm -f "$COMP/stock-ui-held" "$COMP/escaped"
  log_line "compositor-boot: the escape of an earlier boot has lapsed, LumaTV starts"
}

# ----------------------------------------------------------------- Boot direct
#
# Opt-in, off unless $BD_FLAG exists (docs/research/boot-direct.md). With it SAM's Home is the web stub for as long as LumaTV's compositor
# is live, and LG's Flutter Home never starts: the stub goes in at the very start of the boot worker's compositor-boot, before bootd's
# first app, SAM's last_input_handler or the preload manager can open Home, and stays under LG's compositor until the activation
# restarts it. The compositor reads the same flag only to start its UI without waiting for SAM's Home to map. There is no way to LG's Home
# from inside LumaTV but the escape above, which ends in stock_ui_restore and so drops the stub (hs_mounted_ours), as does every other way
# out of LumaTV's compositor: the supervisor's fallback through recover-home.sh --stock, and `compositor off`; a boot that never reaches
# the activation ends in bd_early_undo or the dead man's switch (`boot-direct watch`). The stub is a bind mount and SAM's reading of it:
# nothing of it survives a reboot. `compositor on` (the launcher app's way back) puts it in again before its restart.
BD_FLAG="$STATE/boot-direct"
# Written when the stub goes up at a boot and removed when that boot's activation is complete: one found at the next boot means the last
# one stopped in between (a power cut on a black screen), and that boot goes without the stub. Two in a row switch the flag off.
BD_PENDING="$STATE/boot-direct.pending"
BD_STRIKES="$STATE/boot-direct.strikes"
BD_MAX_STRIKES=2
# Launches of the stub after a compositor restart before LG's Home is given back.
BD_HOME_TRIES=3
# This boot's own record, in tmpfs (one `key=value` a line): when the early step began, which Flutter Home processes it found, when the
# stub was in. The check of a boot (check-boot-direct.py) reads it: LG's Home must never have been running before the stub.
BD_EARLY="/tmp/.$SHORT_ID-boot-direct-early"
# How long the stub may stand in for Home on LG's compositor before the boot counts as failed and LG's Home is given back: a boot reaches
# the activation at ~35 s, and the watch waits on while the boot worker is alive (a wake preparation that times out takes minutes) up to
# BD_WATCH_MAX. The worker's own mark names its pid while it runs (tools/autostart.sh).
BD_WATCH_SECS=180
BD_WATCH_MAX=900
BD_WORKER_MARK="/tmp/.$SHORT_ID-worker"

bd_worker_alive() {
  bd_wp=$(cat "$BD_WORKER_MARK" 2>/dev/null)
  case "$bd_wp" in ''|*[!0-9]*) return 1 ;; esac
  [ -d "/proc/$bd_wp" ]
}

# On when the file's first line says so: the compositor reads the same line, so the two never disagree about what a hand-edited file means.
bd_enabled() {
  [ -f "$BD_FLAG" ] || return 1
  bd_l1=
  read -r bd_l1 < "$BD_FLAG" 2>/dev/null
  [ "$bd_l1" = on ]
}

# The installed bundle's compositor is the one that knows only the flag (compositor/tools/tv-cutover.sh install writes this): marker 2. A
# bundle of marker 1 still opens LG's Home on a Home hold of 5 s, through a verb this tool no longer has.
bd_api() { [ "$(cat "$COMP/boot-direct-api" 2>/dev/null)" = 2 ]; }

bd_strikes() {
  bd_sn=$(cat "$BD_STRIKES" 2>/dev/null)
  case "$bd_sn" in ''|*[!0-9]*) bd_sn=0 ;; esac
  printf '%s' "$bd_sn"
}

bd_strike() {
  # One more boot that ended with the stub in doubt. At the limit the flag turns itself off. Not while the stock UI is held: the escape or a
  # fallback has taken the stub away already, and a boot cut short that way is not one that went wrong.
  if [ -e "$COMP/stock-ui-held" ]; then
    log_line "boot-direct: no fault counted ($1): the stock UI is held"
    return 0
  fi
  bd_sk=$(( $(bd_strikes) + 1 ))
  printf '%s\n' "$bd_sk" > "$BD_STRIKES" 2>/dev/null
  log_line "boot-direct: fault $bd_sk of $BD_MAX_STRIKES ($1)"
  if [ "$bd_sk" -ge "$BD_MAX_STRIKES" ]; then
    rm -f "$BD_FLAG"
    log_line "boot-direct: switched off after $bd_sk faults in a row"
  fi
}

bd_finish() { rm -f "$BD_PENDING" "$BD_STRIKES"; }

bd_fail() {
  # The boot's stub did not work out and the outcome is known: counted once, not again as an unfinished boot at the next one.
  rm -f "$BD_PENDING"
  bd_strike "$1"
}

bd_abort() {
  # The activation went the other way: LG's Home owns its directory again and nothing is left in doubt.
  homestub_drop legacy
  rm -f "$BD_PENDING"
}

bd_rec() { printf '%s=%s\n' "$1" "$2" >> "$BD_EARLY" 2>/dev/null; }

# The uptime in seconds with the fraction, as LG's own log stamps its lines.
bd_now() { cut -d' ' -f1 /proc/uptime 2>/dev/null; }

bd_manual_stub() {
  # `compositor on` by hand (after a fallback, say), flag on: the stub goes in before the restart, so that the Home SAM opens after it is
  # not LG's. Nothing else of the boot machinery: no mark, no watch; a failed `on` ends in comp_switch off, which drops the stub.
  bd_enabled || return 0
  bd_api || { log_line "boot-direct: the installed compositor bundle predates it, no stub"; return 0; }
  homestub_up || log_line "boot-direct: the stub did not come up, LG's Home stays"
  return 0
}

bd_early_in_place() {
  # This boot's early step put the stub in, and it is still there and unfinished.
  [ -f "$BD_PENDING" ] && grep -q '^stub=' "$BD_EARLY" 2>/dev/null && hs_mounted_ours
}

bd_watch_start() {
  # Closes the lock descriptors: a child holding them would keep every later mutation waiting for as long as it lives.
  setsid "$APPDIR/tools/$SHORT_ID" boot-direct watch 8>&- 9>&- </dev/null >/dev/null 2>&1 &
}

bd_early_stub() {
  # The Home stub in before anything else of the boot runs, under the mutation lock and before the checks that take seconds. 0: in
  # place. 1: this boot goes without it (the reason logged) and LG's Home may start. Only the boot worker's own run, and not on a
  # compositor that is live already.
  [ "${LUMA_BOOT:-0}" = 1 ] || return 1
  comp_live && return 1
  bd_early_in_place && return 0
  rm -f "$BD_EARLY"
  bd_rec start "$(bd_now)"
  if ! bd_api; then
    log_line "boot-direct: the installed compositor bundle predates it, no stub"
    return 1
  fi
  if [ -f "$BD_PENDING" ]; then
    rm -f "$BD_PENDING"
    bd_strike "the previous boot did not finish with the stub"
    bd_rec skipped strike
    return 1
  fi
  : > "$BD_PENDING" 2>/dev/null
  # What is there before the stub is evidence: Flutter Home must never have been running (an image the set resumed from could carry one).
  bd_rec flutter_before "$(pgrep -f "$HOME_PKILL_PATTERN" 2>/dev/null | tr '\n' ' ')"
  # SAM may still be coming up at the hook's time: the stub is bound at once and SAM is waited for, bounded, before it reads it.
  HS_SAM_WAIT=20
  if ! homestub_up; then
    HS_SAM_WAIT=0
    rm -f "$BD_PENDING"
    bd_rec failed homestub
    log_line "boot-direct: the stub did not come up, LG's Home stays for this boot"
    return 1
  fi
  HS_SAM_WAIT=0
  bd_rec stub "$(bd_now)"
  log_line "boot-direct: stub up at uptime $(bd_now) s (early)"
  bd_watch_start
  return 0
}

bd_early_undo() {
  # compositor-boot ends with LumaTV not starting this boot: LG's Home is what the set has, so it is given back.
  log_line "boot-direct: LumaTV is not starting this boot, giving LG's Home back"
  bd_abort
  hs_open_home
}

bd_early_gone() {
  # An exit of `compositor-boot` before it has decided: if the early step put the stub in, LumaTV is not starting and LG's Home is given back.
  [ "${BD_EARLY_ON:-0}" = 1 ] || return 0
  BD_EARLY_ON=0
  bd_early_undo
}

bd_early_boot() {
  # The first act of the boot worker's `compositor-boot` (called from the dispatch): the stub goes in before the storage guard and the
  # migration, which take seconds on the set, so that the window in which Flutter Home could be launched is the hook's own start and
  # nothing more. BD_EARLY_ON says whether it is in, for compositor-boot to take it back when LumaTV does not start.
  BD_EARLY_ON=0
  bd_enabled && comp_enabled || return 0
  # Waits for nothing: a lock that is not free in 10 s is somebody's mutation, and this boot goes without the stub. The same call refuses
  # while the stock UI is held (a fallback is in force: LG's Home is wanted).
  bd_lw=$LOCK_WAIT; LOCK_WAIT=10
  if ! take_mutation_lock; then
    LOCK_WAIT=$bd_lw
    log_line "boot-direct: no lock or the stock UI is held, no stub for this boot"
    return 0
  fi
  LOCK_WAIT=$bd_lw
  bd_early_stub && BD_EARLY_ON=1
  exec 9>&-
  return 0
}

bd_home_up() {
  # After a compositor restart (or on a live one) with the stub in place. WebAppMgr restarts with the compositor and the stub is a web
  # app, so SAM's own launch of Home (last_input_handler, about 1.5 s after the compositor is ready) can go into the old one: it is
  # launched here once WebAppMgr answers, and looked for in SAM's list. A stub that never starts leaves the Home key with nothing to
  # open, so LG's Home is given back (the caller says whether that is a fault).
  bd_i=0
  while [ "$bd_i" -lt "$BD_HOME_TRIES" ]; do
    if wait_wam_restart; then sleep 1; fi
    luna-send -n 1 "$HOME_LAUNCH_URI" "$HOME_LAUNCH_PARAMS" >/dev/null 2>&1
    bd_j=0
    while [ "$bd_j" -lt 8 ] && ! home_running; do sleep 1; bd_j=$((bd_j+1)); done
    if home_running && [ "$(sam_home_type)" = web ]; then
      log_line "boot-direct: Home (the stub) running at uptime $(uptime_s) s"
      return 0
    fi
    bd_i=$((bd_i+1))
  done
  log_line "boot-direct: the stub did not start in $BD_HOME_TRIES tries, giving LG's Home back"
  homestub_drop legacy
  hs_open_home
  return 1
}

bd_json() {
  bd_f=false; bd_enabled && bd_f=true
  bd_a=false; bd_api && bd_a=true
  bd_m=false; hs_mounted_ours && bd_m=true
  bd_fl=false; pgrep -f "$HOME_PKILL_PATTERN" >/dev/null 2>&1 && bd_fl=true
  bd_p=false; [ -f "$BD_PENDING" ] && bd_p=true
  printf '{"flag":%s,"api":%s,"stub":%s,"sam":"%s","flutter":%s,"pending":%s,"strikes":%s}' \
    "$bd_f" "$bd_a" "$bd_m" "$(sam_home_type)" "$bd_fl" "$bd_p" "$(bd_strikes)"
}

verb_boot_direct() {
  case "${1:-status}" in
    on)
      bd_api || { emit_error "the installed compositor bundle predates boot-direct; install the current bundle first"; return 1; }
      [ -f "$STUB_SRC/appinfo.json" ] || { emit_error "the stub's files are missing from this install"; return 1; }
      take_mutation_lock || { emit_error "another mutation is in progress"; return 1; }
      rm -f "$BD_PENDING" "$BD_STRIKES"
      if ! printf 'on\n' > "$BD_FLAG.tmp" 2>/dev/null || ! mv -f "$BD_FLAG.tmp" "$BD_FLAG" 2>/dev/null; then
        rm -f "$BD_FLAG.tmp"; emit_error "could not write the flag"; return 1
      fi
      log_line "boot-direct: on"
      # A live compositor gets the stub now. Under LG's the stub would show nothing: that waits for the next boot's activation.
      if comp_live && panel_is_active; then
        if ! { homestub_up && bd_home_up; }; then
          rm -f "$BD_FLAG"
          emit_error "the stub did not start; the flag is off and LG's Home is back"; return 1
        fi
      fi
      printf '{"ok":true,"bootDirect":%s}\n' "$(bd_json)" ;;
    off)
      take_mutation_lock || { emit_error "another mutation is in progress"; return 1; }
      rm -f "$BD_FLAG" "$BD_PENDING" "$BD_STRIKES"
      hs_front=0; hs_stub_in_front && hs_front=1
      homestub_drop legacy
      [ "$hs_front" = 1 ] && hs_open_home
      log_line "boot-direct: off"
      printf '{"ok":true,"bootDirect":%s}\n' "$(bd_json)" ;;
    status) printf '{"ok":true,"bootDirect":%s}\n' "$(bd_json)" ;;
    watch)
      # The dead man's switch of a boot's stub (bd_early_stub starts it, detached). The stub stands in for Home on LG's compositor until the
      # activation; a boot that never gets there gives the stub up rather than leave the set on a black Home: after BD_WATCH_SECS, or, while
      # the boot worker is still at work (its steps can take minutes), after BD_WATCH_MAX.
      bd_w=0
      while [ "$bd_w" -lt "$BD_WATCH_SECS" ] || { bd_worker_alive && [ "$bd_w" -lt "$BD_WATCH_MAX" ]; }; do
        [ -f "$BD_PENDING" ] || return 0
        sleep 2; bd_w=$((bd_w+2))
      done
      LOCK_WAIT=30
      take_mutation_lock || { log_line "boot-direct: the watch could not take the lock"; return 1; }
      [ -f "$BD_PENDING" ] || return 0
      if comp_live; then
        log_line "boot-direct: the boot has not finished in $BD_WATCH_SECS s but LumaTV's compositor is live, the stub stays"
        return 0
      fi
      log_line "boot-direct: the boot did not finish in $BD_WATCH_SECS s, giving LG's Home back"
      bd_abort
      hs_open_home
      bd_strike "the boot did not finish" ;;
    *) emit_error "boot-direct: on, off or status"; return 1 ;;
  esac
  return 0
}

# ------------------------------------------------------------------- revert

# ---------------------------------------------------------------- tile icons
# An earlier version edited each app's icon and iconColor so that Home's dock tiles filled edge to
# edge (tools/tileicons.js). The compositor paints the dock itself now, so `revert` and every
# apply only put the original files back. sam and homelaunchpoints read those files when they
# start, so the restored ones show from the next boot. Neither is restarted here: SAM is never
# restarted, a set rule (eARC, CEC and the picture mode are at risk when it is), and a stale
# icon colour costs nothing.
TILEICONS="$APPDIR/tools/tileicons.js"
NODE=/usr/bin/node

# ------------------------------------------------------------------- helper

# The picture decoder (jpeg/service.c): a 32-bit program over LG's hardware JPEG block that the helper starts when a picture is
# wanted and that ends by itself when it is not. Staged beside the helper, which looks for it there. Not fatal: without it the
# helper serves pictures as the files they are and the shell decodes them.
jpeg_stage() {
  [ -x "$JPEG_SRC" ] || return 0   # a package built before it existed
  cmp -s "$JPEG_SRC" "$JPEG_BIN" 2>/dev/null && return 0
  mkdir -p "$STATE/bin" 2>/dev/null \
    && cp -f "$JPEG_SRC" "$JPEG_BIN.new" 2>/dev/null && chmod 755 "$JPEG_BIN.new" \
    && mv -f "$JPEG_BIN.new" "$JPEG_BIN" 2>/dev/null \
    || { rm -f "$JPEG_BIN.new"; log_line "jpeg: could not stage the decoder"; return 1; }
}

helper_config_migrate() {
  python3 - "$STATE/helper.json" <<'PY'
import fcntl
import json
import os
import stat
import sys
import secrets


def invalid_constant(_):
    raise ValueError("non-finite JSON number")


def verify_directory(path, parent):
    named = os.stat(os.path.dirname(path) or ".", follow_symlinks=False)
    held = os.fstat(parent)
    if not stat.S_ISDIR(named.st_mode) or (named.st_dev, named.st_ino) != (held.st_dev, held.st_ino):
        raise ValueError("data directory changed during migration; no changes made")

def migrate(path, parent):
    try:
        fd = os.open(os.path.basename(path), os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=parent)
    except FileNotFoundError:
        return
    with os.fdopen(fd, "rb") as source:
        before = os.fstat(source.fileno())
        if not stat.S_ISREG(before.st_mode):
            raise ValueError("configuration is not a regular file")
        raw = source.read()
        text = raw.decode("utf-8")
        document = json.loads(text, parse_constant=invalid_constant)
        if not isinstance(document, dict):
            raise ValueError("configuration must be a JSON object")
        log = document.get("log")
        if not isinstance(log, dict) or "maxBytes" not in log:
            return
        decoder = json.JSONDecoder()

        def fields(start):
            pos = start + 1
            while True:
                while text[pos].isspace():
                    pos += 1
                if text[pos] == "}":
                    return
                key_start = pos
                key, pos = decoder.raw_decode(text, pos)
                while text[pos].isspace():
                    pos += 1
                pos += 1  # The complete document was validated above: this is the colon.
                while text[pos].isspace():
                    pos += 1
                value_start = pos
                _, pos = decoder.raw_decode(text, pos)
                yield key, key_start, value_start, pos
                while text[pos].isspace():
                    pos += 1
                if text[pos] == "}":
                    return
                pos += 1

        root = list(fields(len(text) - len(text.lstrip())))
        logs = [item for item in root if item[0] == "log"]
        if len(logs) != 1:
            raise ValueError("duplicate log keys prevent a safe migration")
        members = list(fields(logs[0][2]))
        obsolete = [i for i, item in enumerate(members) if item[0] == "maxBytes"]
        if len(obsolete) != 1:
            raise ValueError("duplicate maxBytes keys prevent a safe migration")
        index = obsolete[0]
        start, end = members[index][1], members[index][3]
        if index + 1 < len(members):
            end = members[index + 1][1]
        elif index:
            start = members[index - 1][3]
        # Removing a member's byte span preserves every other value, escape, and numeric precision exactly.
        updated = (text[:start] + text[end:]).encode("utf-8")
        candidate = ".helper.json." + secrets.token_hex(8)
        temporary = None
        try:
            target_fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600, dir_fd=parent)
            temporary = candidate
            with os.fdopen(target_fd, "wb") as target:
                os.fchown(target.fileno(), before.st_uid, before.st_gid)
                os.fchmod(target.fileno(), stat.S_IMODE(before.st_mode))
                target.write(updated)
                target.flush()
                os.fsync(target.fileno())
            source.seek(0)
            current_bytes = source.read()
            current = os.stat(os.path.basename(path), dir_fd=parent, follow_symlinks=False)
            signature = lambda value: (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns,
                                       value.st_ctime_ns, value.st_mode, value.st_uid, value.st_gid)
            if signature(current) != signature(before) or current_bytes != raw:
                raise ValueError("configuration changed during migration; no changes made")
            verify_directory(path, parent)
            os.replace(temporary, os.path.basename(path), src_dir_fd=parent, dst_dir_fd=parent)
            temporary = None
            os.fsync(parent)
        finally:
            if temporary is not None:
                os.unlink(temporary, dir_fd=parent)


directory_fd = None
try:
    try:
        directory_fd = os.open(os.path.dirname(sys.argv[1]) or ".", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except FileNotFoundError:
        sys.exit(0)
    # Every product helper.json writer locks this stable parent inode before opening/replacing the file.
    # External editors do not participate; the checks above detect earlier edits, not a full pathname CAS.
    fcntl.flock(directory_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    verify_directory(sys.argv[1], directory_fd)
    migrate(sys.argv[1], directory_fd)
except (OSError, ValueError) as error:
    print("helper: helper.json migration failed: %s" % error, file=sys.stderr)
    sys.exit(1)
finally:
    if directory_fd is not None:
        os.close(directory_fd)
PY
}


helper_start() {
  maintenance_guard || return 1
  # Idempotent. The helper runs under its own supervisor (`lumatv-helper start`), which starts it again after a crash, a signal or the
  # out-of-memory killer; this is what starts the supervisor, on every apply and boot. Needs $STATE writable (the boot worker and apply run after /var is). A failure is
  # logged and never fatal: Home draws the last saved weather and news without it.
  [ -x "$HELPER_SRC" ] || { log_line "helper: no helper in the package"; return 1; }
  if ! migration_error=$(helper_config_migrate 2>&1); then
    printf '%s\n' "$migration_error" >&2
    log_line "$migration_error"
    return 1
  fi
  if ! cmp -s "$HELPER_SRC" "$HELPER_BIN" 2>/dev/null; then
    [ -x "$HELPER_BIN" ] && "$HELPER_BIN" stop --brand "$APPDIR/brand.json" >/dev/null 2>&1
    mkdir -p "$STATE/bin" 2>/dev/null \
      && cp -f "$HELPER_SRC" "$HELPER_BIN.new" 2>/dev/null && chmod 755 "$HELPER_BIN.new" \
      && mv -f "$HELPER_BIN.new" "$HELPER_BIN" 2>/dev/null \
      || { rm -f "$HELPER_BIN.new"; log_line "helper: could not stage the binary"; return 1; }
  fi
  jpeg_stage || true
  out=$("$HELPER_BIN" start --brand "$APPDIR/brand.json" 2>&1)
  case "$out" in
    *'"ok":true'*) return 0 ;;
  esac
  log_line "helper: start failed: $(printf '%s' "$out" | tr -d '\n' | cut -c1-200)"
  return 1
}

helper_stop() {
  [ -x "$HELPER_BIN" ] || return 0
  "$HELPER_BIN" stop --brand "$APPDIR/brand.json" >/dev/null 2>&1
  return 0
}

helper_json() {
  out=""
  [ -x "$HELPER_BIN" ] && out=$("$HELPER_BIN" status --brand "$APPDIR/brand.json" 2>/dev/null | tr -d '\n')
  case "$out" in
    '{'*'}') printf '%s' "$out" ;;
    *) printf '{"running":false}' ;;
  esac
}

verb_helper() {
  case "$1" in
    start) if helper_start; then printf '{"ok":true,"helper":%s}\n' "$(helper_json)"; else emit_error "helper did not start; see lumatv log"; return 1; fi ;;
    stop) helper_stop; printf '{"ok":true,"helper":%s}\n' "$(helper_json)" ;;
    status) printf '{"ok":true,"helper":%s}\n' "$(helper_json)" ;;
    *) emit_error "helper: start, stop or status"; return 1 ;;
  esac
  return 0
}

# LG's system updates, blocked by the Homebrew Channel: its flag file (`blockUpdates`, read at boot) and, while the flag exists, a
# bind-mounted /etc/hosts that maps LG's update servers to loopback (its startup.sh). The two can differ until a restart, and another
# mod's hosts file once hid the block, so both are read. The same fields and rules as the helper's `updateblock` topic
# (helper/app/src/updateblock.rs). Read only.
UB_FLAG=${UB_FLAG:-/var/luna/preferences/webosbrew_block_updates}
UB_HOSTS=${UB_HOSTS:-/etc/hosts}
UB_NAMES="snu.lge.com su.lge.com su-ssl.lge.com su-dev.lge.com"

updateblock_json() {
  ub_flag=false; [ -e "$UB_FLAG" ] && ub_flag=true
  ub_map=""; ub_n=0
  for ub_h in $UB_NAMES; do
    ub_m=false
    if [ -r "$UB_HOSTS" ] && awk -v h="$ub_h" '{ sub(/#.*/, "") } ($1 == "127.0.0.1" || $1 == "::1") { for (i = 2; i <= NF; i++) if (tolower($i) == h) f = 1 } END { exit f ? 0 : 1 }' "$UB_HOSTS" 2>/dev/null; then
      ub_m=true; ub_n=$((ub_n+1))
    fi
    ub_map="$ub_map${ub_map:+,}\"$ub_h\":$ub_m"
  done
  ub_live=false; [ "$ub_n" -eq 4 ] && ub_live=true
  ub_block=false; { [ "$ub_flag" = true ] || [ "$ub_n" -gt 0 ]; } && ub_block=true
  if [ "$ub_flag" = true ] && [ "$ub_live" = true ]; then ub_state=blocked
  elif [ "$ub_flag" = true ]; then ub_state=armed
  elif [ "$ub_n" -gt 0 ]; then ub_state=hosts-only
  else ub_state=open; fi
  printf '{"flag":%s,"hosts":{%s},"live":%s,"blocking":%s,"state":"%s"}' "$ub_flag" "$ub_map" "$ub_live" "$ub_block" "$ub_state"
}

verb_updateblock() {
  case "$1" in
    status) printf '{"ok":true,"updateBlock":%s}\n' "$(updateblock_json)" ;;
    *) emit_error "usage: updateblock status"; return 1 ;;
  esac
}

# Open apps without updating (helper/app/src/openapps.rs): LG's list of apps that must be updated before they open, kept empty by the
# helper while its flag exists. The same fields and rules as the helper's `openapps` topic, read only; the setting is changed in
# Settings > System > Support > Update (the helper's POST /v1/openapps). `revert` puts LG's list back (openapps_restore).
OA_INFO=${OA_INFO:-/mnt/lg/cmn_data/var/palm/data/com.webos.appInstallService/updateInfo}
OA_FLAG=${OA_FLAG:-$STATE/openapps/on}
OA_SAVED=${OA_SAVED:-$STATE/openapps/updateInfo.saved}
OA_PROC=${OA_PROC:-/proc}

# LG's updater process (appinstalld) is alive.
openapps_running() {
  for oa_c in "$OA_PROC"/[0-9]*/comm; do
    [ -r "$oa_c" ] || continue
    [ "$(cat "$oa_c" 2>/dev/null)" = appinstalld ] && return 0
  done
  return 1
}

openapps_json() {
  oa_on=false; [ -e "$OA_FLAG" ] && oa_on=true
  oa_saved=false; [ -e "$OA_SAVED" ] && oa_saved=true
  oa_txt=""; oa_bad=0
  if [ -e "$OA_INFO" ]; then
    oa_txt=$(head -c 262144 "$OA_INFO" 2>/dev/null | tr -d ' \n\r\t')
    case "$oa_txt" in
      ''|'['*']') ;;
      *) oa_bad=1 ;;
    esac
  fi
  oa_ids=$(printf '%s' "$oa_txt" | grep -o '"id":"[A-Za-z0-9._-]*"' | sed 's/^"id"://')
  oa_n=0; [ -n "$oa_ids" ] && oa_n=$(printf '%s\n' "$oa_ids" | grep -c .)
  oa_list=$(printf '%s\n' "$oa_ids" | head -n 8 | grep . | tr '\n' ',' | sed 's/,$//')
  if [ "$oa_bad" = 1 ]; then oa_state=unreadable; oa_n=0; oa_list=""
  elif [ "$oa_on" = false ]; then oa_state=off
  elif [ "$oa_n" -eq 0 ]; then oa_state=holding
  elif openapps_running; then oa_state=waiting
  else oa_state=clearing; fi
  printf '{"enabled":%s,"entries":%s,"ids":[%s],"state":"%s","saved":%s}' "$oa_on" "$oa_n" "$oa_list" "$oa_state" "$oa_saved"
}

# Revert: the setting goes off and the list LG had goes back when the file is empty and the updater is not running; a newer list
# written by LG since stays, and the saved one is dropped.
openapps_restore() {
  rm -f "$OA_FLAG"
  [ -e "$OA_SAVED" ] || return 0
  oa_cur=$(head -c 262144 "$OA_INFO" 2>/dev/null | tr -d ' \n\r\t')
  if { [ -z "$oa_cur" ] || [ "$oa_cur" = "[]" ]; } && ! openapps_running; then
    cp -f "$OA_SAVED" "$OA_INFO.lumatv" 2>/dev/null && mv -f "$OA_INFO.lumatv" "$OA_INFO" 2>/dev/null \
      && { rm -f "$OA_SAVED"; log_line "openapps: LG's list put back"; return 0; }
    rm -f "$OA_INFO.lumatv"
    return 0
  fi
  [ -z "$oa_cur" ] || [ "$oa_cur" = "[]" ] || rm -f "$OA_SAVED"
}

verb_openapps() {
  case "$1" in
    status) printf '{"ok":true,"openApps":%s}\n' "$(openapps_json)" ;;
    *) emit_error "usage: openapps status"; return 1 ;;
  esac
}

