# developer flag goes too: it was created for LumaTV's light sync (PLAN.md, Decided) and relaxes LG's capture checks for
# every caller while it exists.
VT_DEVMODE="${LUMATV_VT_DEVMODE:-/var/luna/preferences/vt_devmode}"
