+    /// Waits until every urgent request made so far (settles, cancels, bindings of a track a commit created) has been recorded. The
+    /// writer sends them after the commit that created what they are about, so `commit` returning does not mean they are in the
+    /// recording yet; a `Stats` request sent behind them, in order, says they are.
+    pub fn flush_urgent(&mut self) {
+        let stats = |recorded: &Shared<Vec<Request>>| recorded.lock().expect("the recording").iter().filter(|r| matches!(r, Request::Stats)).count();
+        let before = stats(&self.recorded);
+        let start = Instant::now();
+        while self.ui.scene.wants_writable() {
+            self.ui.scene.writer_ready().expect("the compositor reads");
+            assert!(start.elapsed() < Duration::from_secs(5), "the urgent requests never went out");
+            thread::sleep(Duration::from_millis(1));
+        }
+        self.ui.scene.request_stats().expect("the stats request goes out");
+        while stats(&self.recorded) == before {
+            assert!(start.elapsed() < Duration::from_secs(5), "the compositor never saw the stats request");
+            thread::sleep(Duration::from_millis(1));
+        }
+    }
+
