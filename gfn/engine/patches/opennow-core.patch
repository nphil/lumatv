+                    client_type == "NATIVE",
+                    "{line}"
+                );
+            }
+            let body: Value = serde_json::from_slice(&received[0].body).unwrap();
+            assert_eq!(body["sessionRequestData"]["enhancedStreamMode"], enhanced);
+        }
     }
 
