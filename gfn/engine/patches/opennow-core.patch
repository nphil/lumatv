+    fn wire(headers: &HeaderMap) -> BTreeMap<String, String> {
+        headers
+            .iter()
+            .map(|(name, value)| (name.to_string(), value.to_str().unwrap().to_owned()))
+            .collect()
+    }
+
+    /// Each header that differs: its name and its value in `from` and in `to` (`None`: absent).
+    fn header_changes(
+        from: &BTreeMap<String, String>,
+        to: &BTreeMap<String, String>,
+    ) -> Vec<(String, Option<String>, Option<String>)> {
+        from.keys()
+            .chain(to.keys())
+            .collect::<BTreeSet<_>>()
+            .into_iter()
+            .filter(|name| from.get(*name) != to.get(*name))
+            .map(|name| (name.clone(), from.get(name).cloned(), to.get(name).cloned()))
+            .collect()
+    }
+
+    /// Each leaf of a request body that differs: its path and its value in `from` and in `to`.
+    fn body_changes(
+        path: &str,
+        from: &Value,
+        to: &Value,
+        changes: &mut Vec<(String, Value, Value)>,
+    ) {
+        match (from, to) {
+            (Value::Object(left), Value::Object(right)) => {
+                for key in left.keys().chain(right.keys()).collect::<BTreeSet<_>>() {
+                    let missing = Value::Null;
+                    let (left, right) = (left.get(key), right.get(key));
+                    body_changes(
+                        &format!("{path}/{key}"),
+                        left.unwrap_or(&missing),
+                        right.unwrap_or(&missing),
+                        changes,
+                    );
+                }
+            }
+            (Value::Array(left), Value::Array(right)) if left.len() == right.len() => {
+                for (index, (left, right)) in left.iter().zip(right).enumerate() {
+                    body_changes(&format!("{path}/{index}"), left, right, changes);
+                }
+            }
+            _ if from != to => changes.push((path.to_owned(), from.clone(), to.clone())),
+            _ => {}
+        }
+    }
