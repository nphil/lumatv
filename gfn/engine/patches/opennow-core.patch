+/// The TV's web view as it reports itself (LG OLED65C4PUA, webOS 10.2.1); the LG app's requests carry it as their user agent.
+const LG_WEBOS_USER_AGENT: &str = "Mozilla/5.0 (Web0S; Linux/SmartTV) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.6099.270 Safari/537.36 WebAppManager";
+
+/// The OS token of the Windows client's Bifrost user agent. `GFN-PC/30.0` and `BifrostClientSDK/4.9 (38495286)`
+/// come from an official Mac request; the Windows token is upstream's own composition, not a capture.
+const BIFROST_WINDOWS_PLATFORM: &str = "Windows NT 10.0";
+
+/// What the user-agent, client-type and device headers of every CloudMatch request, and the body's
+/// platform name, DPI and `enhancedStreamMode`, say the client is. The service builds its answer (HDR,
+/// resolution, transport) from the client it believes it talks to, so these change together, never one
+/// alone. The fields that choose the streamer keep their desktop NVST/RTSP values under every identity
+/// (`nv-client-streamer`, `sdkVersion`, `streamerVersion`, `secureRTSPSupported`, and for the LG app
+/// `clientPlatformName`): the LG app's own select WebRTC, whose request carries no HDR, and the identity
+/// is meant to change the answer to the same 4K 120 HDR request.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+enum ClientIdentity {
+    /// The desktop GeForce NOW client of the OS this build runs on.
+    #[default]
+    Desktop,
+    /// The web client inside NVIDIA's LG webOS app. No client sends its fields with the NVST transport,
+    /// so the service may answer differently than to any identity it knows.
+    LgWebos,
+    /// The native Windows client, from any host OS: the desktop identity with the Windows values of the
+    /// OS-derived fields (user agent, device OS and make, platform name, DPI).
+    Windows,
+}
+
+impl ClientIdentity {
+    fn from_name(name: Option<&str>) -> Option<Self> {
+        match name? {
+            "desktop" => Some(Self::Desktop),
+            "lgWebos" => Some(Self::LgWebos),
+            "windows" => Some(Self::Windows),
+            _ => None,
+        }
+    }
+
+    fn from_settings(settings: &Value) -> Self {
+        Self::from_name(settings["clientIdentity"].as_str()).unwrap_or_default()
+    }
+
+    fn name(self) -> &'static str {
+        match self {
+            Self::Desktop => "desktop",
+            Self::LgWebos => "lgWebos",
+            Self::Windows => "windows",
