+#[test]
+fn account_linked_means_a_connected_sign_on_link_not_ownership() {
+    let game = app_to_game(&app("MANUAL", true, false)).unwrap();
+    let (steam, epic) = (
+        selected_variant(&game, "123").unwrap(),
+        selected_variant(&game, "456").unwrap(),
+    );
+    let linked = |variant: &Value, id: &str, account: Value| {
+        super::store_account_linked(variant, id, &json!({"accounts":[account]}))
+    };
+    assert!(!linked(
+        steam,
+        "123",
+        json!({"provider":"STEAM","supportsLinking":false,"isConnected":true,"status":"connected"})
+    ));
+    let sign_on =
+        json!({"provider":"EPIC","supportsLinking":true,"isConnected":true,"status":"connected"});
+    assert!(linked(epic, "456", sign_on.clone()));
+    for (key, value) in [
+        ("isConnected", json!(false)),
+        ("status", json!("expired")),
+        (
+            "accountLinkingMetadata",
+            json!({"supportedVariantIds":["999"]}),
+        ),
+    ] {
+        let mut account = sign_on.clone();
+        account[key] = value;
+        assert!(!linked(epic, "456", account), "{key}");
+    }
+    assert!(!super::store_account_linked(epic, "456", &Value::Null));
+}
