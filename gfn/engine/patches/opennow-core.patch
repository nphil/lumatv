+/// Whether the stream setup asks the service for HDR. It asks on the session request alone (`requestedHdr`, the value the core
+/// sent), not on `negotiatedStreamProfile.enableHdr`, the service's answer. Whether the stream is HDR is read from its own colour
+/// tags, from which the streamer sets the TV's picture mode. HDR still needs
+/// 10-bit HEVC or 10-bit 4:2:0 AV1, the pairs `prepare_embedded` accepts for an accepted HDR session.
+fn announces_hdr(session: &Value, settings: &Value) -> bool {
+    session["requestedHdr"] == true
+        && settings["transportMode"] == "nvst"
+        && matches!(
+            (settings["codec"].as_str(), settings["colorQuality"].as_str()),
+            (Some("H265" | "HEVC"), Some("10bit_420" | "10bit_444")) | (Some("AV1"), Some("10bit_420"))
+        )
+}
