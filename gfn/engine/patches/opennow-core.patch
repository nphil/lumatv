+/// The session request's `accountLinked`, as the official client sets it: the variant's store signs
+/// in through GeForce NOW (single sign-on), the link covers this variant, and the account is
+/// connected and unexpired. Owning the game is not a link; Steam offers no sign-on, so a Steam
+/// variant is never linked.
+pub(super) fn store_account_linked(variant: &Value, variant_id: &str, access: &Value) -> bool {
+    let store =
+        crate::catalog_types::normalize_store(variant["store"].as_str().unwrap_or_default());
+    access["accounts"]
+        .as_array()
+        .and_then(|accounts| accounts.iter().find(|account| account["provider"] == store))
+        .is_some_and(|account| {
+            account["supportsLinking"] == true
+                && account["isConnected"] == true
+                && account["status"] != "expired"
+                && account["accountLinkingMetadata"]["supportedVariantIds"]
+                    .as_array()
+                    .is_none_or(|ids| ids.is_empty() || ids.iter().any(|id| id == variant_id))
+        })
+}
