+        // The identity, then the user agent, client type and device OS it sends and the body's `enhancedStreamMode`.
+        for (identity, agent, client_type, os, enhanced) in [
+            ("lgWebos", LG_WEBOS_USER_AGENT, "BROWSER", "WEBOS", 1),
+            ("windows", WINDOWS_AGENT, "NATIVE", "WINDOWS", 0),
+        ] {
+            let seat = |status| {
+                json!({"requestStatus":{"statusCode":1},"session":{
+                    "sessionId":"A","status":status,
+                    "sessionControlInfo":{"ip":"seat.nvidiagrid.net","port":443}
+                }})
+            };
+            let (base, server) = recording_server(vec![
+                (200, seat(1)),
+                (200, seat(1)),
+                (200, json!({"requestStatus":{"statusCode":1}})),
+            ]);
+            let client = Client::builder()
+                .no_proxy()
+                .timeout(Duration::from_secs(5))
+                .build()
+                .unwrap();
+            let mut service = CloudMatchService::new(client.clone());
+            service.set_test_control_base(base.clone());
+            let auth = conflict_auth();
+            let created = service
+                .create_at(
+                    &json!({"appId":"123"}),
+                    &json!({"clientIdentity":identity}),
+                    &auth,
+                    "device",
+                    || Ok((client, base)),
+                )
+                .unwrap();
+            assert_eq!(created["session"]["clientIdentity"], identity);
+            service.finish_create("A", true).unwrap();
+            // The setting is back on the desktop client by now; the seat keeps the identity it was created under.
+            let polled = service
+                .poll(&json!({"sessionId":"A"}), &auth, "device")
+                .unwrap();
+            assert_eq!(polled["session"]["clientIdentity"], identity);
+            service
+                .stop(
+                    &json!({"sessionId":"A"}),
+                    &json!({"clientIdentity":"desktop"}),
+                    &auth,
+                    "device",
+                )
+                .unwrap();
+            let received = server.join().unwrap();
+            let methods: Vec<_> = received
+                .iter()
+                .map(|request| request.line.split(' ').next().unwrap())
+                .collect();
+            assert_eq!(methods, ["POST", "GET", "DELETE"]);
+            for request in &received {
+                let line = &request.line;
+                assert_eq!(request.headers["user-agent"], agent, "{line}");
+                assert_eq!(request.headers["nv-client-type"], client_type, "{line}");
+                assert_eq!(request.headers["nv-device-os"], os, "{line}");
+                // The browser client never sends it.
+                assert_eq!(
